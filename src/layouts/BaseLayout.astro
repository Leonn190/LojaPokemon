---
import { siteConfig } from '../config';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  active?: 'home' | 'explore' | 'cards' | 'boosters' | 'kits' | 'products' | 'albums' | 'collections' | 'signup' | 'central';
  bodyClass?: string;
  preloadImages?: string[];
}

const {
  title = siteConfig.siteName,
  description = siteConfig.description,
  active = 'home',
  bodyClass = '',
  preloadImages = [],
} = Astro.props;

const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const pageTitle = title === siteConfig.siteName ? title : `${title} | ${siteConfig.siteName}`;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07111f" />
    <meta name="color-scheme" content="dark" />
    <title>{pageTitle}</title>
    {preloadImages.slice(0, 6).map((href) => <link rel="preload" as="image" href={href} fetchpriority="high" />)}
  </head>
  <body class={bodyClass} data-site-base={base}>
    <div class="page-noise" aria-hidden="true"></div>
    <header class="site-header">
      <nav class="shell nav-shell" aria-label="Navegação principal">
        <a class="brand" href={base} aria-label={`Ir para a página inicial da ${siteConfig.siteName}`}>
          <span class="brand-emblem" aria-hidden="true"><i></i></span>
          <span class="brand-copy">
            <strong>{siteConfig.siteName}</strong>
            <small>Comunidade de colecionadores</small>
          </span>
        </a>

        <div class="nav-actions">
          <div class="nav-links" id="primary-navigation">
            <a class:list={[{ active: active === 'home' }]} href={base}>Início</a>
            <a
              class:list={[{ active: ['explore', 'collections', 'cards', 'boosters', 'kits', 'products', 'albums'].includes(active) }]}
              href={`${base}explorar/`}
            >Explorar</a>
          </div>

          <a class:list={['collector-nav-cta', { active: active === 'signup' || active === 'central' }]} href={`${base}cadastro/`} data-auth-nav>Conta</a>

          <button class="proposal-trigger" type="button" data-proposal-open aria-label="Abrir propostas">
            <span class="proposal-trigger-icon" aria-hidden="true">◇</span>
            <span class="proposal-trigger-label">Propostas</span>
            <strong data-proposal-count>0</strong>
          </button>

          <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation">
            <span></span><span></span><span></span>
            <span class="sr-only">Abrir menu</span>
          </button>
        </div>
      </nav>
    </header>

    <script is:inline>
      (() => {
        try {
          if (window.localStorage.getItem('vault:auth-hint') !== '1') return;
          const base = document.body.dataset.siteBase || '/';
          document.querySelectorAll('[data-auth-nav]').forEach((link) => {
            link.textContent = 'Minha coleção';
            link.setAttribute('href', `${base}central/`);
            link.setAttribute('aria-label', 'Abrir minha coleção');
          });
        } catch (_) {}
      })();
    </script>

    <main><slot /></main>

    <footer class="site-footer">
      <div class="shell footer-grid">
        <div>
          <a class="brand footer-brand" href={base}>
            <span class="brand-emblem" aria-hidden="true"><i></i></span>
            <span class="brand-copy"><strong>{siteConfig.siteName}</strong><small>Comunidade de colecionadores</small></span>
          </a>
          <p>{siteConfig.inventoryNote}</p>
        </div>
        <div class="footer-nav" aria-label="Links do rodapé">
          <a href={`${base}colecoes/`}>Coleções</a>
          <a href={`${base}cartas/`}>Cartas</a>
          <a href={`${base}boosters/`}>Boosters</a>
          <a href={`${base}kits/`}>Kits</a>
          <a href={`${base}produtos/`}>Produtos</a>
          <a href={`${base}albuns/`}>Álbuns</a>
          <a href={`${base}cadastro/`} data-auth-footer>Conta</a>
        </div>
      </div>
      <div class="shell footer-bottom">
        <span>© {new Date().getFullYear()} {siteConfig.siteName}</span>
        <span>Um espaço para organizar, mostrar e negociar coleções.</span>
      </div>
    </footer>

    <div class="product-modal" data-product-modal hidden>
      <button class="product-modal-backdrop" type="button" data-modal-close aria-label="Fechar detalhes"></button>
      <section class="product-modal-panel" role="dialog" aria-modal="true" aria-labelledby="product-modal-title" tabindex="-1">
        <button class="modal-close-button" type="button" data-modal-close aria-label="Fechar detalhes">×</button>
        <div class="modal-card-condition" data-modal-card-condition hidden aria-label="Estado de conservação da carta">
          <small>Estado</small>
          <strong data-modal-card-condition-value></strong>
        </div>
        <div class="product-modal-grid">
          <div class="product-modal-media-column">
            <div class="product-modal-media" data-modal-media></div>
            <div class="modal-kit-gallery" data-modal-kit-gallery hidden></div>
          </div>
          <article class="product-modal-content">
            <div class="detail-tags" data-modal-tags>
              <span data-modal-type></span>
              <span class="condition-badge" data-modal-condition></span>
              <span data-modal-stock></span>
            </div>
            <span class="detail-number" data-modal-number></span>
            <h2 id="product-modal-title" data-modal-name></h2>
            <p class="detail-lead" data-modal-description></p>

            <a class="modal-owner-card" data-modal-owner-link href="#">
              <span class="origin-avatar" data-modal-owner-avatar></span>
              <span><small>Publicado na coleção</small><strong data-modal-owner-collection></strong><em data-modal-owner></em></span>
              <b aria-hidden="true">↗</b>
            </a>

            <div class="detail-price-panel" data-modal-price-panel>
              <div><small>Preço publicado</small><strong data-modal-price></strong></div>
              <span>Definido pelo colecionador</span>
            </div>

            <dl class="detail-specs" data-modal-specs>
              <div data-spec-pokemon-collection><dt>Coleção Pokémon</dt><dd></dd></div>
              <div data-spec-number><dt>Número</dt><dd></dd></div>
              <div data-spec-language><dt>Idioma</dt><dd></dd></div>
              <div data-spec-condition><dt>Estado</dt><dd></dd></div>
              <div data-spec-year><dt>Ano</dt><dd></dd></div>
              <div data-spec-type><dt>Tipo</dt><dd></dd></div>
              <div data-spec-contents><dt>Conteúdo do kit</dt><dd></dd></div>
            </dl>
            <section class="modal-kit-details" data-modal-kit-details hidden>
              <header><div><small>Composição do conjunto</small><strong>Itens deste kit</strong></div><span data-modal-kit-discount></span></header>
              <ul class="modal-kit-list" data-modal-kit-list></ul>
            </section>

            <div class="modal-purchase-actions" data-modal-purchase-actions>
              <button class="modal-add-proposal-button" type="button" data-modal-add-proposal>
                <span aria-hidden="true">◇</span> Adicionar à proposta
              </button>
            </div>
          </article>
        </div>
      </section>
    </div>

    <button class="proposal-backdrop" type="button" data-proposal-backdrop hidden aria-label="Fechar propostas"></button>
    <aside class="proposal-drawer" data-proposal-drawer aria-hidden="true" aria-label="Propostas por colecionador">
      <header class="proposal-drawer-header">
        <div><span class="section-eyebrow">Negociação separada</span><h2>Suas propostas</h2><p>Cada colecionador recebe uma proposta própria.</p></div>
        <button class="modal-close-button" type="button" data-proposal-close aria-label="Fechar propostas">×</button>
      </header>

      <div class="proposal-drawer-content">
        <nav class="proposal-collection-list" data-proposal-collection-list aria-label="Colecionadores selecionados"></nav>

        <div class="proposal-empty proposal-auth-required" data-proposal-auth-required hidden>
          <span aria-hidden="true">◇</span>
          <h3>Entre para usar propostas</h3>
          <p>Você está desconectado. Entre na sua conta ou crie uma conta para montar, salvar e enviar propostas.</p>
          <a class="primary-cta proposal-auth-cta" href={`${base}cadastro/`} data-proposal-auth-link><span>Entrar ou criar conta</span><b>→</b></a>
        </div>

        <div class="proposal-empty" data-proposal-empty>
          <span aria-hidden="true">◇</span>
          <h3>Nenhum item selecionado</h3>
          <p>Adicione cartas, boosters, kits ou produtos. Itens de colecionadores diferentes serão separados automaticamente.</p>
        </div>

        <section class="proposal-editor" data-proposal-editor hidden>
          <header class="proposal-editor-header">
            <span class="origin-avatar" data-proposal-owner-avatar></span>
            <div><small>Proposta para</small><strong data-proposal-owner></strong><span data-proposal-collection></span></div>
          </header>

          <div class="proposal-terms-card">
            <div><span>Termos desta coleção</span><strong data-proposal-policy-label></strong></div>
            <p data-proposal-terms-summary></p>
          </div>

          <div class="proposal-items" data-proposal-items></div>

          <div class="proposal-values">
            <div><span>Valor publicado</span><strong data-proposal-published-total>R$ 0,00</strong></div>
            <div class="proposal-final-value"><span>Valor da proposta</span><strong data-proposal-final-total>R$ 0,00</strong></div>
          </div>

          <div class="proposal-form">
            <label class="proposal-discount-field">
              <span>Desconto geral solicitado</span>
              <div><input type="number" min="0" step="0.1" value="0" data-proposal-discount /><b>%</b></div>
              <small data-proposal-discount-limit>Confira os limites definidos pelo colecionador.</small>
            </label>
            <label>
              <span>Motivo da proposta</span>
              <textarea rows="3" maxlength="600" placeholder="Explique de forma breve por que está pedindo esse desconto." data-proposal-reason></textarea>
            </label>
            <label>
              <span>Seu nome completo</span>
              <input type="text" maxlength="120" placeholder="Nome de quem fará o pagamento" data-proposal-buyer-name />
            </label>
            <label>
              <span>Endereço completo para entrega</span>
              <textarea rows="4" maxlength="700" placeholder="Rua, número, complemento, bairro, cidade, estado e CEP" data-proposal-address></textarea>
            </label>
            <div class="proposal-pix-note"><span>PIX</span><p>O pagamento informado na proposta será feito por Pix após a aceitação e confirmação da disponibilidade.</p></div>
            <p class="proposal-validation-error" data-proposal-error hidden></p>
          </div>

          <footer class="proposal-editor-actions">
            <button class="clear-proposal-button" type="button" data-proposal-clear>Excluir esta proposta</button>
            <button class="review-proposal-button" type="button" data-proposal-review>Revisar proposta formal</button>
          </footer>
        </section>
      </div>
    </aside>

    <div class="checkout-modal" data-checkout-modal hidden>
      <button class="checkout-backdrop" type="button" data-checkout-close aria-label="Fechar proposta"></button>
      <section class="checkout-panel" role="dialog" aria-modal="true" aria-labelledby="checkout-title" tabindex="-1">
        <header class="checkout-header">
          <div><span class="section-eyebrow">Proposta formal</span><h2 id="checkout-title">Mensagem pronta para enviar</h2></div>
          <button class="modal-close-button" type="button" data-checkout-close aria-label="Fechar proposta">×</button>
        </header>
        <div class="checkout-content">
          <div class="checkout-instructions">
            <span aria-hidden="true">1</span>
            <p>Confira o texto, copie a mensagem e envie no WhatsApp de <strong data-checkout-owner></strong> pelo número <strong data-checkout-phone></strong>.</p>
          </div>
          <textarea readonly data-checkout-message aria-label="Mensagem da proposta pronta"></textarea>
          <div class="checkout-actions">
            <button class="copy-checkout-button" type="button" data-checkout-copy><span>▣</span> Copiar mensagem</button>
            <a class="whatsapp-checkout-button" href="#" target="_blank" rel="noopener noreferrer" data-checkout-whatsapp><span>↗</span> Abrir WhatsApp Web</a>
          </div>
          <p class="checkout-note">A proposta continua salva neste navegador até você removê-la.</p>
        </div>
      </section>
    </div>

    <script>
      import '../scripts/cloud-runtime';
    </script>

    <script>
      import '../scripts/site-ui.js';
    </script>
  </body>
</html>
