---
import type { AlbumItem } from '../lib/catalog';
interface Props { album: AlbumItem; compact?: boolean; }
const { album, compact = false } = Astro.props;
const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const encodePath = (path: string) => path.split('/').map(encodeURIComponent).join('/');
const imageUrl = (path: string) => /^(?:https?:|data:|blob:)/i.test(path) ? path : `${base}${encodePath(path.replace(/^\/+/, ''))}`;
const previewCards = album.pages.flatMap((page) => page.slots).filter(Boolean).slice(0, 6);
const progress = album.totalSlots ? Math.round(album.occupiedSlots / album.totalSlots * 100) : 0;
const albumHref = `${base}albuns/${encodeURIComponent(album.ownerCollectionSlug)}/${encodeURIComponent(album.slug)}/`;
---
<a class:list={['album-product-card', compact && 'compact']} href={albumHref} aria-label={`Abrir diretamente o álbum ${album.name}`}>
  <div class="album-product-visual" aria-hidden="true">
    <div class="album-product-spine"><span>NX</span></div>
    <div class="album-product-grid">
      {previewCards.map((card) => {
        if (!card) return null;
        const urls = card.imageCandidates.map(imageUrl);
        const [primary = '', ...fallbacks] = urls;
        return <span>{primary ? <img src={primary} alt="" loading="lazy" decoding="async" data-image-candidates={JSON.stringify(fallbacks)} /> : <b>{card.name.slice(0,2).toUpperCase()}</b>}</span>;
      })}
      {Array.from({ length: Math.max(0, 6 - previewCards.length) }).map(() => <span class="empty"></span>)}
    </div>
    <i class="album-product-glare"></i>
    <i class="album-product-shadow"></i>
  </div>
  <div class="album-product-copy">
    <small>{album.format.replace('x',' por ')} · {album.pages.length} {album.pages.length === 1 ? 'página' : 'páginas'}</small>
    <h3>{album.name}</h3>
    <p>{album.description || `Álbum virtual de ${album.ownerName}.`}</p>
    <div class="album-product-progress"><i style={`--album-progress:${progress}%`}></i><span>{album.occupiedSlots} / {album.totalSlots}</span></div>
    <div class="album-product-owner"><span>{album.ownerName.slice(0,2).toUpperCase()}</span><strong>{album.ownerName}</strong><b>↗</b></div>
  </div>
</a>
