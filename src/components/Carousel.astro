---
import ProductCard from './ProductCard.astro';
import type { CatalogItem } from '../lib/catalog';

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  items: CatalogItem[];
  viewAllHref: string;
  viewAllLabel: string;
  emptyTitle?: string;
  emptyDescription?: string;
}

const {
  eyebrow,
  title,
  description,
  items,
  viewAllHref,
  viewAllLabel,
  emptyTitle = 'Nada publicado por enquanto',
  emptyDescription = 'Os itens aparecerão aqui assim que um colecionador publicar este tipo de produto.',
} = Astro.props;
---

<section class="shell showcase-section" data-reveal>
  <div class="section-heading carousel-heading">
    <div>
      <span class="section-eyebrow">{eyebrow}</span>
      <h2>{title}</h2>
      <p>{description}</p>
    </div>
    <div class="carousel-tools">
      <a class="text-link" href={viewAllHref}>{viewAllLabel}<span aria-hidden="true">↗</span></a>
    </div>
  </div>

  {items.length > 0 ? (
    <div class="carousel-track" data-random-carousel aria-label={`${title}: itens passando automaticamente`}>
      <div class="carousel-belt">
        <div class="carousel-sequence">
          {items.map((item) => <ProductCard item={item} compact />)}
        </div>
        <div class="carousel-sequence" aria-hidden="true">
          {items.map((item) => <ProductCard item={item} compact />)}
        </div>
      </div>
    </div>
  ) : (
    <a class="carousel-empty-panel" href={viewAllHref}>
      <span class="empty-carousel-icon" aria-hidden="true">◇</span>
      <div><strong>{emptyTitle}</strong><p>{emptyDescription}</p></div>
      <b aria-hidden="true">Criar agora ↗</b>
    </a>
  )}
</section>
