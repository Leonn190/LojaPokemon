---
import ProductCard from './ProductCard.astro';
import type { CatalogItem } from '../lib/catalog';

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  items: CatalogItem[];
  viewAllHref: string;
  viewAllLabel: string;
}

const { eyebrow, title, description, items, viewAllHref, viewAllLabel } = Astro.props;
---

<section class="shell showcase-section" data-carousel data-reveal>
  <div class="section-heading carousel-heading">
    <div>
      <span class="section-eyebrow">{eyebrow}</span>
      <h2>{title}</h2>
      <p>{description}</p>
    </div>
    <div class="carousel-tools">
      <a class="text-link" href={viewAllHref}>{viewAllLabel}<span aria-hidden="true">↗</span></a>
    </div>
  </div>
  <div class="carousel-track" data-carousel-track aria-label={`${title}: itens passando automaticamente`}>
    <div class="carousel-sequence" data-carousel-sequence>
      {items.map((item) => <ProductCard item={item} compact />)}
    </div>
  </div>
</section>
