---
import ProductCard from './ProductCard.astro';
import type { CatalogItem } from '../lib/catalog';

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  items: CatalogItem[];
  viewAllHref: string;
  viewAllLabel: string;
}

const { eyebrow, title, description, items, viewAllHref, viewAllLabel } = Astro.props;
---

<section class="shell showcase-section" data-carousel data-reveal>
  <div class="section-heading carousel-heading">
    <div>
      <span class="section-eyebrow">{eyebrow}</span>
      <h2>{title}</h2>
      <p>{description}</p>
    </div>
    <div class="carousel-tools">
      <button class="icon-button" type="button" data-carousel-prev aria-label="Mostrar itens anteriores">←</button>
      <button class="icon-button" type="button" data-carousel-next aria-label="Mostrar próximos itens">→</button>
      <a class="text-link" href={viewAllHref}>{viewAllLabel}<span aria-hidden="true">↗</span></a>
    </div>
  </div>
  <div class="carousel-track" data-carousel-track>
    {items.map((item) => <ProductCard item={item} compact />)}
  </div>
</section>
