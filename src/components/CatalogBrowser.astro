---
import ProductCard from './ProductCard.astro';
import type { CatalogItem } from '../lib/catalog';
import { TCG_CONFIG } from '../lib/tcg-metadata';

interface Props {
  kind: 'card' | 'booster' | 'kit' | 'product';
  items: CatalogItem[];
  showOwnerFilter?: boolean;
  hideOwnerOnCards?: boolean;
}

const { kind, items, showOwnerFilter = true, hideOwnerOnCards = false } = Astro.props;
const owners = [...new Map(items.map((item) => [item.ownerCollectionSlug, item.ownerCollectionName])).entries()]
  .sort((a, b) => a[1].localeCompare(b[1], 'pt-BR'));
const noun = kind === 'card' ? 'cartas' : kind === 'booster' ? 'boosters' : kind === 'kit' ? 'kits' : 'produtos';
const nounSingular = kind === 'card' ? 'carta' : kind === 'booster' ? 'booster' : kind === 'kit' ? 'kit' : 'produto';
const placeholder = kind === 'card'
  ? 'Nome, número, coleção, classe, tipo...'
  : kind === 'booster'
    ? 'Nome da coleção ou do booster...'
    : kind === 'kit'
      ? 'Nome, descrição ou conteúdo do kit...'
      : 'Nome do produto lacrado...';
---

<section class="shell catalog-section" data-catalog-root data-tcg-config={JSON.stringify(TCG_CONFIG)}>
  <div class:list={['filter-panel', kind !== 'card' && 'compact-filter-panel']} data-reveal>
    <div class="search-control">
      <label for={`${kind}-search`}>Pesquisar {noun}</label>
      <div class="search-input-wrap">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m21 21-4.35-4.35m2.35-5.65a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z" /></svg>
        <input id={`${kind}-search`} type="search" placeholder={placeholder} autocomplete="off" data-filter-search />
        <kbd>/</kbd>
      </div>
    </div>

    {kind === 'card' && (
      <>
        <div class="select-control"><label for={`${kind}-era-filter`}>Era</label><div class="select-input-wrap"><span class="select-symbol">◈</span><select id={`${kind}-era-filter`} data-filter-era><option value="">Todas</option>{Object.values(TCG_CONFIG.eras).map((era) => <option value={era.id}>{era.label}</option>)}</select></div></div>
        <div class="select-control"><label for={`${kind}-collection-filter`}>Coleção</label><div class="select-input-wrap"><span class="select-symbol">▦</span><select id={`${kind}-collection-filter`} data-filter-collection disabled><option value="">Todas</option></select></div></div>
        <div class="select-control"><label for={`${kind}-group-filter`}>Grupo</label><div class="select-input-wrap"><span class="select-symbol">◎</span><select id={`${kind}-group-filter`} data-filter-group><option value="">Todos</option>{TCG_CONFIG.groups.map((group) => <option value={group.id}>{group.label}</option>)}</select></div></div>
        <div class="select-control"><label for={`${kind}-class-filter`}>Classe</label><div class="select-input-wrap"><span class="select-symbol">◇</span><select id={`${kind}-class-filter`} data-filter-class disabled><option value="">Todas</option></select></div></div>
        <div class="select-control"><label for={`${kind}-type-filter`}>Tipo</label><div class="select-input-wrap"><span class="select-symbol">◆</span><select id={`${kind}-type-filter`} data-filter-type disabled><option value="">Todos</option></select></div></div>
        <div class="select-control"><label for={`${kind}-language-filter`}>Idioma</label><div class="select-input-wrap"><span class="select-symbol">A</span><select id={`${kind}-language-filter`} data-filter-language><option value="">Todos</option>{TCG_CONFIG.languages.map((language) => <option value={language.id}>{language.label}</option>)}</select></div></div>
        <div class="select-control"><label for={`${kind}-condition-filter`}>Estado</label><div class="select-input-wrap"><span class="select-symbol">✓</span><select id={`${kind}-condition-filter`} data-filter-condition><option value="">Todos</option>{Object.keys(TCG_CONFIG.conditions).map((condition) => <option value={condition}>{condition}</option>)}</select></div></div>
        <div class="select-control"><label for={`${kind}-integrity-filter`}>Integridade</label><div class="search-input-wrap integrity-filter-wrap"><input id={`${kind}-integrity-filter`} type="number" min="1" max="100" step="1" placeholder="1–100" data-filter-integrity /><b>%</b></div></div>
      </>
    )}

    {kind !== 'card' && showOwnerFilter && owners.length > 1 && (
      <div class="select-control">
        <label for={`${kind}-owner-filter`}>Colecionador</label>
        <div class="select-input-wrap">
          <span class="select-symbol" aria-hidden="true">◎</span>
          <select id={`${kind}-owner-filter`} data-filter-owner>
            <option value="">Todos</option>
            {owners.map(([slug, title]) => <option value={slug}>{title}</option>)}
          </select>
          <svg class="select-chevron" viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 7.5 4.5 4.5 4.5-4.5" /></svg>
        </div>
      </div>
    )}

    <div class="select-control sort-control">
      <label for={`${kind}-sort`}>Ordenar</label>
      <div class="select-input-wrap">
        <span class="select-symbol" aria-hidden="true">↕</span>
        <select id={`${kind}-sort`} data-filter-sort>
          <option value="price-desc">Maior preço</option>
          <option value="price-asc">Menor preço</option>
          <option value="name-asc">Nome A–Z</option>
        </select>
        <svg class="select-chevron" viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 7.5 4.5 4.5 4.5-4.5" /></svg>
      </div>
    </div>

    <button class="clear-button" type="button" data-filter-clear>Limpar</button>
  </div>

  <div class="catalog-summary">
    <p><strong data-result-count>{items.length}</strong> {items.length === 1 ? nounSingular : noun} {items.length === 1 ? 'encontrado' : 'encontrados'}</p>
    <span>Selecione um item para abrir os detalhes e ver quem publicou.</span>
  </div>

  <div class="empty-state" data-empty-state>
    <span>◇</span>
    <h2>Nenhum resultado encontrado</h2>
    <p>Tente remover um filtro ou pesquisar por outro termo.</p>
  </div>

  <div class="catalog-grid" data-catalog-grid>
    {items.map((item) => <ProductCard item={item} catalog hideOwner={hideOwnerOnCards} />)}
  </div>
</section>
