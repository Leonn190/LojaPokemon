---
import { TCG_CONFIG } from '../lib/tcg-metadata';
interface Props {
  kind: 'card' | 'booster' | 'kit' | 'product';
  showOwnerFilter?: boolean;
}
const { kind, showOwnerFilter = true } = Astro.props;
const noun = kind === 'card' ? 'cartas' : kind === 'booster' ? 'boosters' : kind === 'kit' ? 'kits' : 'produtos';
const placeholder = kind === 'card'
  ? 'Nome, número, coleção, classe, tipo...'
  : kind === 'booster'
    ? 'Nome da coleção ou do booster...'
    : kind === 'kit'
      ? 'Nome, descrição ou conteúdo do kit...'
      : 'Nome do produto lacrado...';
const skeletonCount = kind === 'card' ? 8 : 6;
const supportsFreeMode = kind === 'card' || kind === 'booster' || kind === 'kit';
const hasEraFilters = kind === 'card' || kind === 'booster';
---
<section class="shell catalog-section online-catalog-section" data-online-catalog data-kind={kind} data-owner-filter={showOwnerFilter ? 'true' : 'false'} data-tcg-config={JSON.stringify(TCG_CONFIG)}>
  <div class="explore-search-stack" data-reveal>
    <div class="explore-search-toolbar">
      <div class="search-control explore-main-search">
        <label for={`${kind}-search`}>Pesquisar {noun}</label>
        <div class="search-input-wrap">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m21 21-4.35-4.35m2.35-5.65a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z" /></svg>
          <input id={`${kind}-search`} type="search" placeholder={placeholder} autocomplete="off" data-online-search />
          <kbd>/</kbd>
        </div>
      </div>

      <button class="explore-toolbar-button" type="button" data-online-filter-toggle aria-expanded="false">
        <span aria-hidden="true">☷</span><strong>Filtros</strong><i data-online-filter-indicator hidden></i>
      </button>

      <div class="select-control explore-sort-control">
        <label>Ordenar</label>
        <div class="select-input-wrap"><span class="select-symbol" aria-hidden="true">↕</span><select data-online-sort><option value="name">Nome A–Z</option><option value="name-desc">Nome Z–A</option><option value="price-asc">Menor preço</option><option value="price-desc">Maior preço</option></select><svg class="select-chevron" viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 7.5 4.5 4.5 4.5-4.5" /></svg></div>
      </div>

      {supportsFreeMode && (
        <button class="explore-toolbar-button free-mode-toggle" type="button" data-online-free-toggle aria-pressed="false">
          <span aria-hidden="true">▦</span><strong>Modo livre</strong>
        </button>
      )}
    </div>

    <div class="explore-filter-drawer" data-online-filter-drawer hidden>
      {hasEraFilters && (
        <>
          <div class="select-control"><label>Era</label><div class="select-input-wrap"><span class="select-symbol" aria-hidden="true">◈</span><select data-online-era><option value="">Todas</option>{Object.values(TCG_CONFIG.eras).map((era) => <option value={era.id}>{era.label}</option>)}</select><svg class="select-chevron" viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 7.5 4.5 4.5 4.5-4.5" /></svg></div></div>
          <div class="select-control"><label>Coleção</label><div class="select-input-wrap"><span class="select-symbol" aria-hidden="true">▦</span><select data-online-collection disabled><option value="">Todas</option></select><svg class="select-chevron" viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 7.5 4.5 4.5 4.5-4.5" /></svg></div></div>
        </>
      )}

      {kind === 'card' && (
        <>
          <div class="select-control"><label>Grupo</label><div class="select-input-wrap"><span class="select-symbol" aria-hidden="true">◎</span><select data-online-group><option value="">Todos</option>{TCG_CONFIG.groups.map((group) => <option value={group.id}>{group.label}</option>)}</select><svg class="select-chevron" viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 7.5 4.5 4.5 4.5-4.5" /></svg></div></div>
          <div class="select-control"><label>Classe</label><div class="select-input-wrap"><span class="select-symbol" aria-hidden="true">◇</span><select data-online-class disabled><option value="">Todas</option></select><svg class="select-chevron" viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 7.5 4.5 4.5 4.5-4.5" /></svg></div></div>
          <div class="select-control"><label>Tipo</label><div class="select-input-wrap"><span class="select-symbol" aria-hidden="true">◆</span><select data-online-type disabled><option value="">Todos</option></select><svg class="select-chevron" viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 7.5 4.5 4.5 4.5-4.5" /></svg></div></div>
        </>
      )}

      {hasEraFilters && (
        <div class="select-control"><label>Idioma</label><div class="select-input-wrap"><span class="select-symbol" aria-hidden="true">A</span><select data-online-language><option value="">Todos</option>{TCG_CONFIG.languages.map((language) => <option value={language.id}>{language.label}</option>)}</select><svg class="select-chevron" viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 7.5 4.5 4.5 4.5-4.5" /></svg></div></div>
      )}

      {kind === 'card' && (
        <>
          <div class="select-control"><label>Estado</label><div class="select-input-wrap"><span class="select-symbol" aria-hidden="true">✓</span><select data-online-condition><option value="">Todos</option>{Object.keys(TCG_CONFIG.conditions).map((condition) => <option value={condition}>{condition}</option>)}</select><svg class="select-chevron" viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 7.5 4.5 4.5 4.5-4.5" /></svg></div></div>
          <div class="select-control"><label>Integridade</label><div class="search-input-wrap integrity-filter-wrap"><input type="number" min="1" max="100" step="1" placeholder="1–100" data-online-integrity /><b>%</b></div></div>
        </>
      )}

      {showOwnerFilter && (
        <div class="select-control" data-online-owner-wrap hidden>
          <label>Coleção Vault</label>
          <div class="select-input-wrap"><span class="select-symbol" aria-hidden="true">◎</span><select data-online-owner><option value="">Todas</option></select><svg class="select-chevron" viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 7.5 4.5 4.5 4.5-4.5" /></svg></div>
        </div>
      )}

      <button class="clear-button explore-clear-filters" type="button" data-online-clear-filters>Limpar filtros</button>
    </div>
  </div>

  <div class="catalog-results-heading catalog-results-heading-clean">
    <span class="section-kicker">Catálogo</span>
    <span class="cloud-save-state" data-online-status aria-live="polite"></span>
  </div>

  <div class="catalog-skeleton-grid" data-online-skeleton aria-hidden="true">
    {Array.from({ length: skeletonCount }, () => (
      <article class="catalog-skeleton-card"><div class="catalog-skeleton-media skeleton-pulse"></div><div class="catalog-skeleton-copy"><i class="skeleton-pulse"></i><b class="skeleton-pulse"></b><span class="skeleton-pulse"></span><span class="skeleton-pulse short"></span></div></article>
    ))}
  </div>
  <div class="catalog-grid" data-online-grid hidden></div>
  <div class="catalog-load-sentinel" data-online-sentinel aria-hidden="true"></div>
  <div class="empty-state" data-online-empty hidden><span>⌕</span><h2>Nenhum item encontrado</h2><p>Não há itens para esta busca ou combinação de filtros.</p></div>
</section>

<script>
  import '../scripts/online-catalog-browser';
</script>
