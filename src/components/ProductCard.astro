---
import ProductImage from './ProductImage.astro';
import { formatBRL, getItemPrice, type CatalogItem } from '../lib/catalog';

interface Props {
  item: CatalogItem;
  compact?: boolean;
  catalog?: boolean;
  hideOwner?: boolean;
}

const { item, compact = false, catalog = false, hideOwner = false } = Astro.props;
const price = getItemPrice(item);
const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const itemType = item.kind === 'card' ? item.type : item.kind === 'booster' ? 'Booster avulso' : item.kind === 'kit' ? 'Kit personalizado' : 'Produto lacrado';
const number = item.kind === 'card' ? item.number : '';
const pokemonCollection = item.kind === 'card' ? item.collection : item.name;
const description = item.kind === 'kit' || item.kind === 'product' ? item.description : '';
const contents = item.kind === 'kit' ? item.contents : '';
const kitItems = item.kind === 'kit' ? item.contentItems.map((entry) => ({ ...entry, type: entry.type || '', imageCandidates: entry.imageCandidates || [] })) : [];
const kitDiscount = item.kind === 'kit' && item.sourceTotal && item.price !== null && item.sourceTotal > 0
  ? Math.max(0, ((item.sourceTotal - item.price) / item.sourceTotal) * 100)
  : 0;
const blocksDefinedPrice = item.proposalTerms.policy === 'no_defined_price' || item.proposalTerms.policy === 'fixed_price_multi_only';
const canPropose = item.forSale && item.proposalTerms.policy !== 'none' && !(item.kind === 'card' && price !== null && blocksDefinedPrice);
const showPublicQuantity = item.kind === 'kit' && item.showQuantity;
---

<article
  class:list={['product-card', compact && 'compact-card']}
  data-product-card
  data-product-id={`${item.kind}:${item.slug}`}
  data-kind={item.kind}
  data-name={item.name}
  data-number={number}
  data-collection={pokemonCollection}
  data-language={item.kind === 'card' ? item.language : ''}
  data-condition={item.kind === 'card' ? item.condition : ''}
  data-year={item.kind === 'card' ? item.year : ''}
  data-type={itemType}
  data-description={description}
  data-contents={contents}
  data-link-liga={item.kind === 'card' || item.kind === 'booster' || item.kind === 'product' ? item.linkLiga : ''}
  data-kit-items={item.kind === 'kit' ? JSON.stringify(kitItems) : ''}
  data-kit-discount={item.kind === 'kit' ? kitDiscount.toFixed(1) : ''}
  data-kit-source-total={item.kind === 'kit' && item.sourceTotal !== null ? String(item.sourceTotal) : ''}
  data-owner={item.ownerName}
  data-owner-collection={item.ownerCollectionName}
  data-owner-slug={item.ownerCollectionSlug}
  data-owner-phone={item.ownerPhone}
  data-proposal-policy={item.proposalTerms.policy}
  data-proposal-flexible={item.proposalTerms.flexibleDiscounts ? 'true' : 'false'}
  data-proposal-tiers={JSON.stringify(item.proposalTerms.discountTiers)}
  data-proposal-allowed={canPropose ? 'true' : 'false'}
  data-price-value={price === null ? '' : String(price)}
  data-price-label={formatBRL(price)}
  data-stock={String(item.quantity)}
  data-for-sale={item.forSale ? 'true' : 'false'}
  data-show-quantity={showPublicQuantity ? 'true' : 'false'}
  data-catalog-item={catalog ? '' : undefined}
  data-search={catalog ? item.searchText : undefined}
  data-price={catalog ? String(price ?? -1) : undefined}
  data-quantity={catalog ? String(item.quantity) : undefined}
  data-filter-collection={catalog && item.kind === 'card' ? item.collection : undefined}
  data-filter-condition={catalog && item.kind === 'card' ? item.condition : undefined}
  data-filter-type={catalog && item.kind === 'card' ? item.type : undefined}
  data-filter-owner={catalog ? item.ownerCollectionSlug : undefined}
>
  <button class="product-open-button" type="button" data-open-product aria-label={`Ver detalhes de ${item.name}`}>
    <div class="product-card-media">
      <ProductImage item={item} />
      {showPublicQuantity && <span class="quantity-chip">{item.quantity} {item.quantity === 1 ? 'unidade' : 'unidades'}</span>}
    </div>

    <div class="product-card-body">
      <div class="product-card-heading">
        <div>
          <span class="product-kicker">{itemType}</span>
          <h3>{item.name}</h3>
        </div>
        <span class="open-arrow" aria-hidden="true">⌗</span>
      </div>

      {item.kind === 'card' ? (
        <p class="product-description"><strong>{item.number}</strong><span>•</span>{item.collection}</p>
      ) : item.kind === 'kit' ? (
        <p class="product-description">{item.description}</p>
      ) : item.kind === 'product' ? (
        <p class="product-description">{item.description || 'Produto Pokémon lacrado.'}</p>
      ) : (
        <p class="product-description">Pacote lacrado publicado pelo colecionador.</p>
      )}

      <div class="product-card-footer">
        <div class="price-block">
          <small>Preço</small>
          <strong>{formatBRL(price)}</strong>
        </div>
        {item.kind === 'card' && <span class={`condition-badge condition-${item.condition.toLowerCase()}`}>{item.condition}</span>}
      </div>
    </div>
  </button>

  {!hideOwner && (
    <a class="collection-origin" href={`${base}colecoes/${item.ownerCollectionSlug}/`}>
      <span class="origin-avatar">{item.ownerName.slice(0, 2).toUpperCase()}</span>
      <span><small>Publicado por</small><strong>{item.ownerName}</strong></span>
      <b aria-hidden="true">↗</b>
    </a>
  )}

  {canPropose ? (
    <div class="product-purchase-actions single-action">
      <button class="add-proposal-button" type="button" data-add-proposal>
        <span aria-hidden="true">◇</span>
        Adicionar à proposta
      </button>
    </div>
  ) : item.forSale ? (
    <span class="not-for-sale-label">Os termos desta coleção não permitem proposta para este item</span>
  ) : (
    <span class="not-for-sale-label">Não está à venda</span>
  )}
</article>
