---
import ProductImage from './ProductImage.astro';
import type { CollectorCollection } from '../lib/catalog';

interface Props { collection: CollectorCollection; compact?: boolean; }
const { collection, compact = false } = Astro.props;
const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const initials = collection.owner.slice(0, 2).toUpperCase();
const preview = collection.coverItems.slice(0, compact ? 3 : 4);
---

<a class:list={['collection-card', compact && 'compact-collection-card']} href={`${base}colecoes/${collection.slug}/`}>
  <div class="collection-card-preview">
    {preview.length > 0 ? (
      preview.map((item, index) => (
        <div class={`collection-preview-item preview-${index + 1}`}>
          <ProductImage item={item} />
        </div>
      ))
    ) : (
      <div class="collection-preview-empty"><span>{initials}</span><small>Coleção em construção</small></div>
    )}
    <span class="collection-status">{collection.selling ? 'Itens à venda' : 'Somente exposição'}</span>
  </div>
  <div class="collection-card-body">
    <div class="collection-owner-row">
      <span class="collection-avatar">{initials}</span>
      <div><small>Colecionador</small><strong>{collection.owner}</strong></div>
      <b aria-hidden="true">↗</b>
    </div>
    <h3>{collection.title}</h3>
    <p>{collection.description}</p>
    <div class="collection-card-stats">
      <span><strong>{collection.cards.length}</strong> cartas</span>
      <span><strong>{collection.boosters.length}</strong> boosters</span>
      <span><strong>{collection.kits.length}</strong> kits</span>
    </div>
  </div>
</a>
