---
import CollectionFlow from './CollectionFlow.astro';
import type { CollectorCollection } from '../lib/catalog';

interface Props { collection: CollectorCollection; compact?: boolean; }
const { collection, compact = false } = Astro.props;
const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const initials = collection.owner.slice(0, 2).toUpperCase();
const encodePath = (path: string) => path.split('/').map(encodeURIComponent).join('/');
const imageUrl = (path: string) => /^(?:https?:|data:|blob:)/i.test(path) ? path : `${base}${encodePath(path.replace(/^\/+/, ''))}`;
---

<a class:list={['collection-card', compact && 'compact-collection-card']} href={`${base}colecao/?slug=${encodeURIComponent(collection.slug)}`}>
  <div class="collection-card-preview">
    <CollectionFlow collection={collection} compact />
    <span class="collection-status">{collection.selling ? 'Itens à venda' : 'Somente exposição'}</span>
  </div>
  <div class="collection-card-body">
    <div class="collection-owner-row">
      <span class:list={['collection-avatar', collection.profilePhoto && 'has-photo']}>{collection.profilePhoto ? <img src={imageUrl(collection.profilePhoto)} alt="" loading="lazy" /> : initials}</span>
      <div><small>Colecionador</small><strong>{collection.owner}</strong></div>
      <b aria-hidden="true">↗</b>
    </div>
    <h3>{collection.title}</h3>
    <p>{collection.description}</p>
    <div class="collection-card-stats">
      {collection.cards.length > 0 && <span><strong>{collection.cards.length}</strong> cartas</span>}
      {collection.boosters.length > 0 && <span><strong>{collection.boosters.length}</strong> boosters</span>}
      {collection.kits.length > 0 && <span><strong>{collection.kits.length}</strong> kits</span>}
      {collection.products.length > 0 && <span><strong>{collection.products.length}</strong> produtos</span>}
      {collection.albums.length > 0 && <span><strong>{collection.albums.length}</strong> álbuns</span>}
    </div>
  </div>
</a>
