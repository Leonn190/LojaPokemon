---
import type { CatalogItem, KitContentItem } from '../lib/catalog';

interface Props {
  item: CatalogItem;
  detail?: boolean;
  eager?: boolean;
  interactive?: boolean;
  deferred?: boolean;
}

const { item, detail = false, eager = false, interactive = true, deferred = false } = Astro.props;
const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const encodePath = (path: string) => path.split('/').map(encodeURIComponent).join('/');
const toImageUrl = (path: string) => /^(?:https?:|data:|blob:)/i.test(path) ? path : `${base}${encodePath(path.replace(/^\/+/, ''))}`;
const imageUrls = item.imageCandidates.map(toImageUrl);
const primaryImage = imageUrls[0] || '';
const fallbackImages = imageUrls.slice(1);
const isCard = item.kind === 'card';
const isKit = item.kind === 'kit';
const isBooster = item.kind === 'booster';
const isProduct = item.kind === 'product';
const initials = isKit
  ? 'KIT'
  : item.name
      .split(/\s+/)
      .filter(Boolean)
      .slice(0, 2)
      .map((word) => word[0])
      .join('')
      .toUpperCase();
const fallbackLabel = isCard ? 'Carta Pokémon' : isBooster ? 'Booster Pokémon' : isKit ? 'Kit personalizado' : 'Produto Pokémon';
const isInteractive = interactive && (isCard || isKit || isBooster || isProduct);

const normalizeRarity = (value: string) => value
  .normalize('NFD')
  .replace(/[\u0300-\u036f]/g, '')
  .trim()
  .toLowerCase();
const rarityText = isCard ? normalizeRarity(item.cardClass || item.type || '') : '';
const compactRarity = rarityText.replace(/[^a-z0-9]+/g, '');
const premiumTokens = [
  'full art', 'ultra rara', 'ultra rare', 'secret', 'secreta', 'gold', 'dourad', 'rainbow',
  'illustration rare', 'ilustracao rara', 'arte rara', 'special illustration', 'sir', 'alt art',
  'galeria de treinador', 'trainer gallery', 'shiny rare', 'shiny ultra', 'hyper rare',
];
const premiumCodes = new Set(['ru', 'sr', 're']);
const holoTokens = ['holo', 'foil', 'reverse', 'radiante', 'radiant', 'vmax', 'v-astro', 'vstar', 'mega ex', ' ex', 'gx', ' v', 'rh', 'rl', 'rd'];
const foilTier = !isCard
  ? ''
  : premiumCodes.has(rarityText) || premiumTokens.some((token) => rarityText.includes(token))
    ? 'premium'
    : holoTokens.some((token) => rarityText.includes(token)) || /^(?:mega\s+)?(?:ex|gx|v(?:max|star|-astro|-union)?)(?:\b|\s|—|-)/.test(rarityText) || /^(?:ex|gx|v|vmax|vstar|v-astro|megaex|rh|rl|rd|s)$/.test(compactRarity)
      ? 'holo'
      : 'basic';

const kitContent = isKit ? item.contentItems : [];
const kitWithImages = kitContent.filter((entry: KitContentItem) => Array.isArray(entry.imageCandidates) && entry.imageCandidates.length > 0);
const firstCard = kitWithImages.find((entry) => entry.kind === 'cards');
const secondCard = kitWithImages.find((entry) => entry.kind === 'cards' && entry !== firstCard);
const firstBooster = kitWithImages.find((entry) => entry.kind === 'boosters');
const kitPreviewItems = [firstCard, secondCard, firstBooster, ...kitWithImages]
  .filter((entry, index, list): entry is KitContentItem => Boolean(entry) && list.indexOf(entry) === index)
  .slice(0, 3)
  .map((entry) => ({
    ...entry,
    imageUrls: (entry.imageCandidates || []).map(toImageUrl),
  }));
const kitUnits = isKit
  ? kitContent.reduce((total: number, entry: KitContentItem) => total + Math.max(1, Number(entry.quantity) || 1), 0)
  : 0;
const kitDiscount = isKit && item.sourceTotal && item.price !== null && item.sourceTotal > 0
  ? Math.max(0, ((item.sourceTotal - item.price) / item.sourceTotal) * 100)
  : 0;
const hasKitComposition = isKit && kitPreviewItems.length > 0;
---

<div
  class:list={[
    'collectible-visual',
    isCard && `foil-tier-${foilTier}`,
    isBooster && 'booster-visual',
    isKit && 'kit-visual',
    isProduct && 'sealed-product-visual',
    hasKitComposition && 'kit-composite-visual',
    detail && 'detail-visual',
  ]}
  data-foil-tier={isCard ? foilTier : undefined}
  data-tilt={isInteractive ? '' : undefined}
  data-tilt-strength={isInteractive ? (detail ? (isKit ? '8' : isBooster ? '5' : isProduct ? '6' : '11') : (isKit ? '4' : isBooster ? '3' : isProduct ? '4' : '5')) : undefined}
>
  <div class:list={['image-stage', hasKitComposition && 'kit-image-stage']}>
    <span class="image-fallback" aria-hidden="true">
      <b>{initials}</b>
      <small>{fallbackLabel}</small>
    </span>

    {hasKitComposition ? (
      <>
        <div class="kit-stack" aria-hidden="true">
          {kitPreviewItems.map((entry, index) => {
            const [entryPrimary = '', ...entryFallbacks] = entry.imageUrls;
            const entryInitials = entry.name.split(/\s+/).filter(Boolean).slice(0, 2).map((word) => word[0]).join('').toUpperCase();
            return (
              <span class:list={[`kit-stack-card kit-stack-card-${index + 1}`, entry.kind === 'boosters' && 'booster-item']}>
                <span class="kit-stack-card-surface" data-image-stage>
                  <span class="kit-stack-fallback">{entryInitials || 'TCG'}</span>
                  {entryPrimary && (
                    <img
                      src={entryPrimary}
                      alt=""
                      loading={eager && index === 1 ? 'eager' : 'lazy'}
                      decoding="async"
                      fetchpriority={eager && index === 1 ? 'high' : 'auto'}
                      data-image-candidates={JSON.stringify(entryFallbacks)}
                    />
                  )}
                </span>
              </span>
            );
          })}
        </div>
        <span class="kit-composite-badge">{kitUnits || kitContent.length} {kitUnits === 1 ? 'item' : 'itens'}</span>
        {kitDiscount > 0 && <span class="kit-discount-badge">−{Math.round(kitDiscount)}%</span>}
        <span class="kit-composite-shine" aria-hidden="true"></span>
      </>
    ) : primaryImage ? (
      <img
        src={deferred ? undefined : primaryImage}
        data-deferred-src={deferred ? primaryImage : undefined}
        data-defer-load={deferred ? 'true' : undefined}
        alt={isCard ? `${item.name}, ${item.number}` : isBooster ? `Booster ${item.name}` : isKit ? `Kit ${item.name}` : `Produto ${item.name}`}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={eager ? 'high' : deferred ? 'low' : 'auto'}
        data-image-candidates={JSON.stringify(fallbackImages)}
        data-image-gallery={item.kind === 'booster' ? JSON.stringify(imageUrls) : undefined}
      />
    ) : null}

    {isCard && <span class="holo-band" aria-hidden="true"></span>}
    {isCard && <span class="foil-spectrum" aria-hidden="true"></span>}
    {isCard && <span class="glare" aria-hidden="true"></span>}
  </div>
</div>
