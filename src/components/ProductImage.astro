---
import type { CatalogItem, KitContentItem } from '../lib/catalog';

interface Props {
  item: CatalogItem;
  detail?: boolean;
  eager?: boolean;
  interactive?: boolean;
}

const { item, detail = false, eager = false, interactive = true } = Astro.props;
const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const encodePath = (path: string) => path.split('/').map(encodeURIComponent).join('/');
const toImageUrl = (path: string) => /^(?:https?:|data:|blob:)/i.test(path) ? path : `${base}${encodePath(path.replace(/^\/+/, ''))}`;
const imageUrls = item.imageCandidates.map(toImageUrl);
const primaryImage = imageUrls[0] || '';
const fallbackImages = imageUrls.slice(1);
const isCard = item.kind === 'card';
const isKit = item.kind === 'kit';
const initials = isKit
  ? 'KIT'
  : item.name
      .split(/\s+/)
      .filter(Boolean)
      .slice(0, 2)
      .map((word) => word[0])
      .join('')
      .toUpperCase();
const fallbackLabel = isCard ? 'Carta Pokémon' : item.kind === 'booster' ? 'Booster Pokémon' : 'Kit personalizado';
const isInteractive = interactive && (isCard || isKit);

const kitContent = isKit ? item.contentItems : [];
const kitPreviewItems = kitContent
  .filter((entry: KitContentItem) => Array.isArray(entry.imageCandidates) && entry.imageCandidates.length > 0)
  .slice(0, 3)
  .map((entry: KitContentItem) => ({
    ...entry,
    imageUrls: (entry.imageCandidates || []).map(toImageUrl),
  }));
const kitUnits = isKit
  ? kitContent.reduce((total: number, entry: KitContentItem) => total + Math.max(1, Number(entry.quantity) || 1), 0)
  : 0;
const hasKitComposition = isKit && kitPreviewItems.length > 0;
---

<div
  class:list={[
    'collectible-visual',
    item.kind === 'booster' && 'booster-visual',
    isKit && 'kit-visual',
    hasKitComposition && 'kit-composite-visual',
    detail && 'detail-visual',
  ]}
  data-tilt={isInteractive ? '' : undefined}
  data-tilt-strength={isInteractive ? (detail ? (isKit ? '8' : '11') : (isKit ? '4' : '5')) : undefined}
>
  <div class:list={['image-stage', hasKitComposition && 'kit-image-stage']}>
    <span class="image-fallback" aria-hidden="true">
      <b>{initials}</b>
      <small>{fallbackLabel}</small>
    </span>

    {hasKitComposition ? (
      <>
        <div class="kit-stack" aria-hidden="true">
          {kitPreviewItems.map((entry, index) => {
            const [entryPrimary = '', ...entryFallbacks] = entry.imageUrls;
            const entryInitials = entry.name.split(/\s+/).filter(Boolean).slice(0, 2).map((word) => word[0]).join('').toUpperCase();
            return (
              <span class={`kit-stack-card kit-stack-card-${index + 1}`}>
                <span class="kit-stack-card-surface" data-image-stage>
                  <span class="kit-stack-fallback">{entryInitials || 'TCG'}</span>
                  {entryPrimary && (
                    <img
                      src={entryPrimary}
                      alt=""
                      loading={eager && index === 1 ? 'eager' : 'lazy'}
                      decoding="async"
                      fetchpriority={eager && index === 1 ? 'high' : 'auto'}
                      data-image-candidates={JSON.stringify(entryFallbacks)}
                    />
                  )}
                </span>
              </span>
            );
          })}
        </div>
        <span class="kit-composite-badge">{kitUnits || kitContent.length} {kitUnits === 1 ? 'item' : 'itens'}</span>
        <span class="kit-composite-shine" aria-hidden="true"></span>
      </>
    ) : primaryImage ? (
      <img
        src={primaryImage}
        alt={isCard ? `${item.name}, ${item.number}` : item.kind === 'booster' ? `Booster ${item.name}` : `Kit ${item.name}`}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={eager ? 'high' : 'auto'}
        data-image-candidates={JSON.stringify(fallbackImages)}
        data-image-gallery={item.kind === 'booster' ? JSON.stringify(imageUrls) : undefined}
      />
    ) : null}

    {isCard && <span class="foil-spectrum" aria-hidden="true"></span>}
    {isCard && <span class="glare" aria-hidden="true"></span>}
  </div>
</div>
