---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductImage from '../../components/ProductImage.astro';
import ProductCard from '../../components/ProductCard.astro';
import { formatBRL, getCards, type CardItem } from '../../lib/catalog';
import { getEra, languageLabel as getLanguageLabel } from '../../lib/tcg-metadata';

export function getStaticPaths() {
  return getCards().map((card) => ({ params: { slug: card.slug }, props: { card } }));
}

interface Props { card: CardItem; }
const { card } = Astro.props;
const base = import.meta.env.BASE_URL;
const eraLabel = getEra(card.era)?.label || card.era || 'Não informada';
const groupLabel = card.group === 'pokemon' ? 'Pokémon' : card.group === 'trainer' ? 'Treinador' : card.group === 'energy' ? 'Energia' : 'Não informado';
const classLabel = card.cardClass || 'Não informada';
const typeLabel = card.group === 'pokemon' ? (card.type || 'Não informado') : '';
const language = card.languageLabel || getLanguageLabel(card.language) || card.language || 'Não informado';
const allCards = getCards();
const related = allCards
  .filter((item) => item.slug !== card.slug)
  .sort((a, b) => {
    const scoreA = Number(a.collection === card.collection) * 3 + Number((a.cardClass || a.type) === (card.cardClass || card.type)) * 2 + Number(a.type === card.type);
    const scoreB = Number(b.collection === card.collection) * 3 + Number((b.cardClass || b.type) === (card.cardClass || card.type)) * 2 + Number(b.type === card.type);
    return scoreB - scoreA || (b.price ?? 0) - (a.price ?? 0);
  })
  .slice(0, 4);
---

<BaseLayout
  title={`${card.name} ${card.number}`}
  description={`${card.name} ${card.number}, da coleção ${card.collection}. Veja imagem, classificação, estado, idioma, ano e preço registrado no catálogo.`}
  active="cards"
  bodyClass="detail-page"
>
  <section class="shell detail-section">
    <nav class="breadcrumbs" aria-label="Navegação estrutural">
      <a href={base}>Início</a><span>/</span><a href={`${base}cartas/`}>Cartas</a><span>/</span><strong>{card.name}</strong>
    </nav>

    <div class="detail-grid">
      <div class="detail-media-column" data-reveal>
        <ProductImage item={card} detail eager />
        <p class="tilt-hint"><span>✦</span> Mova o cursor sobre a carta para ativar o brilho e a inclinação 3D.</p>
      </div>

      <article class="detail-content" data-reveal>
        <div class="detail-tags">
          <span>{classLabel}</span>
          <span class={`condition-badge condition-${card.condition.toLowerCase()}`}>{card.condition}</span>
        </div>
        <span class="detail-number">{card.number}</span>
        <h1>{card.name}</h1>
        <p class="detail-lead">Visualização desta variação com os dados do inventário organizados sem links externos ou valores paralelos.</p>

        <div class="detail-price-panel">
          <div><small>Preço</small><strong>{formatBRL(card.price)}</strong></div>
          <span>Valor registrado no inventário</span>
        </div>

        <dl class="detail-specs">
          <div><dt>Era</dt><dd>{eraLabel}</dd></div>
          <div><dt>Coleção</dt><dd>{card.collection}{card.collectionCode ? ` · ${card.collectionCode}` : ''}</dd></div>
          <div><dt>Numeração</dt><dd>{card.number}</dd></div>
          <div><dt>Grupo</dt><dd>{groupLabel}</dd></div>
          <div><dt>Classe</dt><dd>{classLabel}</dd></div>
          {card.group === 'pokemon' && <div><dt>Tipo</dt><dd>{typeLabel}</dd></div>}
          <div><dt>Idioma</dt><dd>{language}</dd></div>
          <div><dt>Estado</dt><dd>{card.condition || 'Não informado'}</dd></div>
          <div><dt>Integridade</dt><dd>{card.integrity ? `${card.integrity}%` : 'Não informada'}</dd></div>
          <div><dt>Ano</dt><dd>{card.year || 'Não informado'}</dd></div>
        </dl>

        <a class="back-catalog-button" href={`${base}cartas/`}><span>←</span> Voltar para todas as cartas</a>
      </article>
    </div>
  </section>

  <section class="shell related-section" data-reveal>
    <div class="section-heading">
      <div><span class="section-eyebrow">Continue explorando</span><h2>Cartas relacionadas</h2></div>
      <a class="text-link" href={`${base}cartas/`}>Catálogo completo <span>↗</span></a>
    </div>
    <div class="related-grid">
      {related.map((item) => <ProductCard item={item} />)}
    </div>
  </section>
</BaseLayout>
