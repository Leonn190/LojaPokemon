---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CatalogBrowser from '../../components/CatalogBrowser.astro';
import { getCards, getCollections } from '../../lib/catalog';

const cards = getCards();
const collections = getCollections();
const pokemonSets = new Set(cards.map((item) => item.collection)).size;
---

<BaseLayout
  title="Cartas da comunidade"
  description="Pesquise cartas Pokémon publicadas por todos os colecionadores do Nexus TCG."
  active="cards"
>
  <section class="catalog-hero">
    <div class="shell catalog-hero-grid">
      <div data-reveal>
        <span class="hero-badge"><i></i> {cards.length} cartas publicadas</span>
        <h1>Cartas da comunidade</h1>
        <p>Explore cartas de todas as coleções cadastradas. Cada item mostra o perfil responsável e o preço público definido pela coleção, sem expor o estoque individual.</p>
      </div>
      <div class="catalog-hero-stats" data-reveal>
        <div><strong>{collections.length}</strong><span>colecionadores</span></div>
        <div><strong>{pokemonSets}</strong><span>coleções Pokémon</span></div>
        <div><strong>{new Set(cards.map((item) => item.type)).size}</strong><span>tipos de carta</span></div>
      </div>
    </div>
  </section>

  <CatalogBrowser kind="card" items={cards} />
</BaseLayout>
