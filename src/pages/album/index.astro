---
import BaseLayout from '../../layouts/BaseLayout.astro';
const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
---

<BaseLayout title="Álbum" description="Álbum virtual publicado no Vault TCG." active="albums" bodyClass="immersive-album-page">
  <section class="album-world" data-immersive-album>
    <div class="album-world-aurora" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="album-world-stars" aria-hidden="true"></div>
    <button class="album-focus-exit" type="button" data-album-focus-exit aria-label="Sair da apresentação">× <span>Sair da apresentação</span></button>

    <header class="shell album-experience-header" data-reveal>
      <div class="album-experience-copy">
        <nav class="breadcrumbs" aria-label="Navegação estrutural">
          <a href={base}>Início</a><span>/</span><a href={`${base}albuns/`}>Álbuns</a><span>/</span><strong data-album-name-breadcrumb>Carregando…</strong>
        </nav>
        <span class="album-experience-kicker" data-album-kicker>Álbum virtual</span>
        <h1 data-album-name>Carregando álbum…</h1>
        <p data-album-description>Buscando o fichário publicado pelo colecionador.</p>
        <div class="album-experience-owner-row">
          <a class="album-owner-pill" href={`${base}colecoes/`} data-album-owner-link>
            <span data-album-owner-initials>VT</span>
            <div><small>Organizado por</small><strong data-album-owner>Colecionador</strong></div>
            <b>↗</b>
          </a>
          <button class="secondary-cta album-open-button" type="button" data-album-open><span>Abrir fichário</span><b>↓</b></button>
          <button class="album-focus-button" type="button" data-album-focus aria-pressed="false"><span>◈</span> Apresentar álbum</button>
        </div>
      </div>

      <div class="album-experience-cover binder-style-vault" data-album-cover aria-hidden="true">
        <div class="album-cover-depth"></div>
        <div class="album-cover-spine"><span>VAULT</span></div>
        <div class="album-cover-custom-title"><small>VAULT TCG</small><strong data-album-cover-title>Álbum</strong></div>
        <i class="album-cover-custom-image" aria-hidden="true"></i>
        <div class="album-cover-mosaic" data-album-cover-mosaic>
          {Array.from({ length: 8 }).map(() => <span class="empty"></span>)}
        </div>
      </div>
    </header>

    <section class="shell album-experience-stats" data-reveal>
      <div><small>Páginas</small><strong data-album-pages>0</strong></div>
      <div><small>Formato</small><strong data-album-format>—</strong></div>
      <div><small>Cartas posicionadas</small><strong data-album-occupied>0</strong></div>
      <div class="album-stat-progress"><small>Preenchimento</small><strong data-album-progress>0%</strong><i><span data-album-progress-bar style="--album-progress:0%"></span></i></div>
    </section>

    <section class="album-reading-zone" aria-label="Leitor do álbum" data-album-reading-zone hidden>
      <div class="shell album-reader-shell">
        <div class="album-reader-toolbar">
          <div><span class="section-eyebrow">Fichário aberto</span><strong data-album-page-label>Página 1</strong></div>
          <p>Passe o mouse sobre uma carta para destacá-la. Clique para abrir todas as informações avançadas.</p>
        </div>

        <div class="immersive-album-stage" data-album-stage>
          <button class="immersive-album-arrow previous" type="button" data-album-previous aria-label="Voltar páginas">‹</button>
          <div class="immersive-album-book-wrap" data-album-book-wrap>
            <div class="immersive-album-book" data-album-book>
              <section class="immersive-album-sheet left immersive-album-endpaper" data-album-loading>
                <div class="album-endpaper-mark"><span>VT</span><strong>Carregando álbum</strong><small>Vault TCG</small></div>
                <span class="immersive-page-texture" aria-hidden="true"></span><span class="immersive-page-edge" aria-hidden="true"></span>
              </section>
            </div>
            <div class="immersive-album-rings" aria-hidden="true">{Array.from({ length: 7 }).map(() => <i></i>)}</div>
            <div class="immersive-album-center-shadow" aria-hidden="true"></div>
            <div class="immersive-album-floor-shadow" aria-hidden="true"></div>
          </div>
          <button class="immersive-album-arrow next" type="button" data-album-next aria-label="Avançar páginas">›</button>
        </div>

        <footer class="album-reader-footer">
          <div class="album-page-rail" data-album-page-rail aria-label="Ir para uma página"></div>
          <div class="album-reader-hint"><span>← →</span><p>Você também pode usar as setas do teclado.</p></div>
        </footer>
      </div>
    </section>

    <section class="shell" data-album-error hidden>
      <div class="empty-state show"><span>!</span><h2>Não foi possível abrir este álbum</h2><p data-album-error-message>Confira o endereço e tente novamente.</p><a class="primary-cta" href={`${base}albuns/`}><span>Voltar aos álbuns</span><b>←</b></a></div>
    </section>
  </section>

  <script>
  import '../../scripts/pages/album-page';
</script>
</BaseLayout>
