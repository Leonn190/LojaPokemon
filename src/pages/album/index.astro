---
import BaseLayout from '../../layouts/BaseLayout.astro';
const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
---
<BaseLayout title="Álbum" description="Álbum virtual publicado no Vault TCG." active="albums" bodyClass="immersive-album-page">
  <section class="catalog-hero album-catalog-hero"><div class="shell catalog-hero-grid"><div data-reveal><span class="hero-badge"><i></i> Álbum online</span><h1 data-album-title>Carregando álbum…</h1><p data-album-description>Os dados deste álbum são carregados diretamente do Firestore.</p></div><div class="catalog-hero-stats" data-reveal><div><strong data-album-progress>0 / 0</strong><span>espaços ocupados</span></div><div><strong data-album-owner>—</strong><span>colecionador</span></div></div></div></section>
  <section class="shell" data-online-album-viewer>
    <div class="public-album-dialog" style="width:100%;max-height:none">
      <header class="public-album-dialog-header"><div><span class="section-eyebrow" data-album-format>Álbum</span><h2 data-album-heading>Álbum</h2><p data-album-copy></p></div><a class="secondary-cta" href={`${base}albuns/`}><span>Voltar aos álbuns</span><b>←</b></a></header>
      <div class="public-album-stage"><button class="album-page-arrow" type="button" data-album-prev aria-label="Página anterior">‹</button><div class="public-album-page-wrap"><div class="public-album-page" data-album-page><span class="public-album-rings" aria-hidden="true"><i></i><i></i><i></i><i></i></span></div></div><button class="album-page-arrow" type="button" data-album-next aria-label="Próxima página">›</button></div>
      <footer class="public-album-footer"><strong data-album-page-label>Página 1</strong><span data-album-slots-label></span></footer>
    </div>
    <div class="empty-state" data-album-error hidden><span>!</span><h2>Não foi possível abrir este álbum</h2><p data-album-error-message>Confira o endereço e tente novamente.</p></div>
  </section>
  <script>
    import { escapeHtml, initializeOnlineImages, toImageUrl } from '../../scripts/online-markup';
    const root = document.querySelector<HTMLElement>('[data-online-album-viewer]');
    const params = new URLSearchParams(location.search); const collectionSlug = params.get('collection') || ''; const albumSlug = params.get('album') || ''; let album: any = null; let pageIndex = 0;
    const setText = (selector: string, value: unknown) => { const el = document.querySelector<HTMLElement>(selector); if (el) el.textContent = String(value ?? ''); };
    const render = () => { if (!album) return; const pages = Array.isArray(album.pages) ? album.pages : []; const page = pages[pageIndex] || { slots: [] }; const columns = Number(album.columns || String(album.format || '3x3').split('x')[0] || 3); const rows = Number(album.rows || String(album.format || '3x3').split('x')[1] || 3); const pageEl = root?.querySelector<HTMLElement>('[data-album-page]'); if (!pageEl) return; pageEl.style.setProperty('--album-columns', String(columns)); pageEl.style.setProperty('--album-rows', String(rows)); const slots = Array.isArray(page.slots) ? page.slots : []; pageEl.innerHTML = '<span class="public-album-rings" aria-hidden="true"><i></i><i></i><i></i><i></i></span>' + slots.map((card: any) => { if (!card) return '<article class="public-album-slot empty"><span>◇</span></article>'; const candidates = Array.isArray(card.imageCandidates) ? card.imageCandidates.map(toImageUrl) : []; const [primary='', ...fallbacks] = candidates; return `<article class="public-album-slot occupied"><div>${primary ? `<img src="${escapeHtml(primary)}" alt="${escapeHtml(card.name || '')}" loading="lazy" data-image-candidates="${escapeHtml(JSON.stringify(fallbacks))}" />` : `<span>${escapeHtml(String(card.name || 'TC').slice(0,2).toUpperCase())}</span>`}</div><small>${escapeHtml(card.name || 'Carta')}</small><b>${escapeHtml(card.number || card.collection || '')}</b></article>`; }).join(''); initializeOnlineImages(pageEl); setText('[data-album-page-label]', `Página ${pageIndex + 1} de ${Math.max(1, pages.length)}`); setText('[data-album-slots-label]', `${slots.filter(Boolean).length} cartas nesta página`); const prev = root.querySelector<HTMLButtonElement>('[data-album-prev]'); const next = root.querySelector<HTMLButtonElement>('[data-album-next]'); if (prev) prev.disabled = pageIndex <= 0; if (next) next.disabled = pageIndex >= pages.length - 1; };
    const load = async () => { try { if (!collectionSlug || !albumSlug) throw new Error('Endereço do álbum incompleto.'); const cloud = (window as any).VaultCloud; if (!cloud) throw new Error('Firebase ainda não foi inicializado.'); const data = await cloud.loadCollectionBySlug(collectionSlug); if (!data) throw new Error('Coleção não encontrada.'); album = data.albums.find((entry: any) => String(entry.slug || entry.albumId || entry.id) === albumSlug || String(entry.albumId || entry.id) === albumSlug); if (!album) throw new Error('Álbum não encontrado.'); const pages = Array.isArray(album.pages) ? album.pages : []; const occupied = Number(album.occupiedSlots ?? pages.flatMap((page: any) => page.slots || []).filter(Boolean).length); const total = Number(album.totalSlots ?? pages.reduce((sum: number, page: any) => sum + (page.slots?.length || 0), 0)); document.title = `${album.name || 'Álbum'} · Vault TCG`; setText('[data-album-title]', album.name || 'Álbum'); setText('[data-album-heading]', album.name || 'Álbum'); setText('[data-album-description]', album.description || `Álbum virtual de ${data.profile.owner || 'colecionador'}.`); setText('[data-album-copy]', album.description || 'Álbum virtual organizado no Vault TCG.'); setText('[data-album-owner]', data.profile.owner || 'Colecionador'); setText('[data-album-progress]', `${occupied} / ${total}`); setText('[data-album-format]', `${album.format || 'Álbum'} · ${pages.length} ${pages.length === 1 ? 'página' : 'páginas'}`); render(); } catch (error: any) { const dialog = root?.querySelector<HTMLElement>('.public-album-dialog'); if (dialog) dialog.hidden = true; const box = root?.querySelector<HTMLElement>('[data-album-error]'); if (box) box.hidden = false; setText('[data-album-error-message]', error?.message || 'Confira o endereço e tente novamente.'); } };
    root?.querySelector('[data-album-prev]')?.addEventListener('click', () => { if (pageIndex > 0) { pageIndex -= 1; render(); } }); root?.querySelector('[data-album-next]')?.addEventListener('click', () => { if (album && pageIndex < (album.pages?.length || 1) - 1) { pageIndex += 1; render(); } }); if ((window as any).VaultCloud) load(); else window.addEventListener('vault:cloud-ready', load, { once: true });
  </script>
</BaseLayout>
