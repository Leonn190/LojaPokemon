---
import BaseLayout from '../layouts/BaseLayout.astro';
import Carousel from '../components/Carousel.astro';
import ProductImage from '../components/ProductImage.astro';
import { formatBRL, getBoosters, getCards, getItemPrice } from '../lib/catalog';
import { siteConfig } from '../config';

const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const cards = getCards();
const boosters = getBoosters();
const cardUnits = cards.reduce((total, item) => total + item.quantity, 0);
const boosterUnits = boosters.reduce((total, item) => total + item.quantity, 0);
const collections = new Set(cards.map((item) => item.collection)).size;
const featuredCards = [...cards]
  .filter((item) => item.price !== null)
  .sort((a, b) => (b.price ?? 0) - (a.price ?? 0))
  .slice(0, 14);
const featuredBoosters = [...boosters]
  .filter((item) => item.price !== null)
  .sort((a, b) => (b.price ?? 0) - (a.price ?? 0))
  .slice(0, 14);
const heroCard = cards.find((item) => item.name === 'Giratina V' && item.number === '186/196')
  ?? featuredCards[0]
  ?? cards[0];
---

<BaseLayout active="home">
  <section class="home-hero">
    <div class="shell hero-grid">
      <div class="hero-copy" data-reveal>
        <span class="hero-badge"><i></i> Inventário organizado e pesquisável</span>
        <h1>Seu próximo destaque está <em>na coleção.</em></h1>
        <p>{siteConfig.tagline} Explore imagens, informações completas e valores sem sair do catálogo.</p>
        <div class="hero-actions">
          <a class="primary-cta" href={`${base}cartas/`}><span>Explorar cartas</span><b>↗</b></a>
          <a class="secondary-cta" href={`${base}boosters/`}><span>Ver boosters</span><b>→</b></a>
        </div>
        <div class="hero-metrics">
          <div><strong>{cards.length}</strong><span>cartas catalogadas</span></div>
          <div><strong>{boosterUnits}</strong><span>boosters em estoque</span></div>
          <div><strong>{collections}</strong><span>coleções de cartas</span></div>
        </div>
      </div>

      <div class="hero-showcase" data-reveal>
        <div class="hero-orbit orbit-one" aria-hidden="true"></div>
        <div class="hero-orbit orbit-two" aria-hidden="true"></div>
        <div class="hero-product">
          <ProductImage item={heroCard} detail eager />
        </div>
        <div class="hero-price-card">
          <small>Destaque do catálogo</small>
          <strong>{heroCard.name}</strong>
          <span>{formatBRL(getItemPrice(heroCard))}</span>
        </div>
        <div class="floating-chip chip-top">Efeito holográfico 3D</div>
        <div class="floating-chip chip-bottom">Passe o mouse na carta</div>
      </div>
    </div>
  </section>

  <section class="shell navigation-cards" aria-label="Áreas do catálogo" data-reveal>
    <a class="navigation-card cards-navigation" href={`${base}cartas/`}>
      <div class="navigation-icon" aria-hidden="true"><span>◆</span></div>
      <div><small>Catálogo completo</small><h2>Cartas avulsas</h2><p>Pesquise por nome, numeração, coleção, tipo, idioma e estado.</p></div>
      <span class="navigation-arrow">↗</span>
    </a>
    <a class="navigation-card boosters-navigation" href={`${base}boosters/`}>
      <div class="navigation-icon" aria-hidden="true"><span>▰</span></div>
      <div><small>Pacotes lacrados</small><h2>Boosters avulsos</h2><p>Consulte as coleções disponíveis, estoque e o preço definido no inventário.</p></div>
      <span class="navigation-arrow">↗</span>
    </a>
  </section>

  <Carousel
    eyebrow="Cartas em destaque"
    title="Cartas que se destacam na coleção"
    description="Uma seleção de cartas em movimento contínuo, com os preços definidos no catálogo."
    items={featuredCards}
    viewAllHref={`${base}cartas/`}
    viewAllLabel="Ver todas as cartas"
  />

  <Carousel
    eyebrow="Boosters disponíveis"
    title="Pacotes para todos os estilos de coleção"
    description="Pacotes disponíveis passando automaticamente, com o preço final definido no catálogo."
    items={featuredBoosters}
    viewAllHref={`${base}boosters/`}
    viewAllLabel="Ver todos os boosters"
  />

  <section class="shell inventory-note" data-reveal>
    <div>
      <span class="section-eyebrow">Informação clara</span>
      <h2>Um catálogo feito para decidir sem ruído.</h2>
    </div>
    <p>
      Cartas e boosters exibem somente o preço final do inventário. Ao selecionar um produto, os detalhes aparecem em uma subtela sobre o catálogo, sem redirecionamento.
    </p>
    <div class="inventory-totals">
      <div><span>Unidades de cartas</span><strong>{cardUnits}</strong></div>
      <div><span>Tipos de boosters</span><strong>{boosters.length}</strong></div>
    </div>
  </section>
</BaseLayout>
