---
import BaseLayout from '../layouts/BaseLayout.astro';
import Carousel from '../components/Carousel.astro';
import CollectionCarousel from '../components/CollectionCarousel.astro';
import AlbumCarousel from '../components/AlbumCarousel.astro';
import ProductImage from '../components/ProductImage.astro';
import { getAlbums, getBoosters, getCards, getCollections, getKits, getProducts, shuffleItems } from '../lib/catalog';

const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const cards = getCards();
const boosters = getBoosters();
const kits = getKits();
const products = getProducts();
const albums = getAlbums();
const collections = getCollections();
const featuredCards = shuffleItems(cards).slice(0, 14);
const featuredBoosters = shuffleItems(boosters).slice(0, 14);
const featuredKits = shuffleItems(kits).slice(0, 14);
const featuredProducts = shuffleItems(products).slice(0, 14);
const featuredAlbums = shuffleItems(albums).slice(0, 14);
const featuredCollections = [...collections].sort((a, b) => Number(b.featured) - Number(a.featured));
const totalUnits = [...cards, ...boosters, ...kits, ...products].reduce((total, item) => total + item.quantity, 0);

// O fundo da abertura usa o mesmo princípio visual das coleções: várias colunas
// de cartas subindo continuamente, só que inclinado para a direita e sem hover.
const wallSource = shuffleItems(cards.filter((card) => card.imageCandidates.length > 0)).slice(0, 42);
const rotate = (items: typeof wallSource, amount: number) => items.length
  ? [...items.slice(amount % items.length), ...items.slice(0, amount % items.length)]
  : [];
const wallLanes = Array.from({ length: 6 }, (_, laneIndex) => {
  const lane = wallSource.filter((_, cardIndex) => cardIndex % 6 === laneIndex);
  return rotate(lane, laneIndex + 1);
});
---

<BaseLayout active="home">
  <section class="home-hero nexus-home-hero" aria-labelledby="home-title">
    <div class="nexus-hero-card-flow" aria-hidden="true">
      <div class="nexus-hero-flow-plane">
        {wallLanes.map((lane, laneIndex) => (
          <div class={`nexus-hero-flow-lane nexus-hero-flow-lane-${laneIndex + 1}`}>
            <div class="nexus-hero-flow-track">
              {[0, 1].map((sequence) => (
                <div class="nexus-hero-flow-set">
                  {lane.map((card, cardIndex) => (
                    <div class="nexus-hero-flow-card">
                      <ProductImage
                        item={card}
                        eager={laneIndex < 2 && sequence === 0 && cardIndex < 4}
                        interactive={false}
                      />
                    </div>
                  ))}
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
      <span class="nexus-hero-flow-glow"></span>
      <span class="nexus-hero-flow-vignette"></span>
    </div>

    <div class="shell hero-copy nexus-home-copy">
      <span class="hero-badge"><i></i> Coleções Pokémon em um só lugar</span>
      <h1 id="home-title"><span>Nexus</span> <em>TCG</em></h1>
      <h2 class="nexus-home-tagline">Seu acervo. Sua vitrine.</h2>
      <p class="nexus-home-description">Organize sua coleção Pokémon, publique seus itens e encontre outros colecionadores. Use o Nexus para guardar sua coleção online ou transformar itens selecionados em uma vitrine de venda.</p>
      <div class="hero-actions">
        <a class="primary-cta" href={`${base}cadastro/`}><span>Criar minha coleção</span><b>＋</b></a>
        <a class="secondary-cta" href={`${base}explorar/`}><span>Explorar</span><b>↗</b></a>
      </div>
      <div class="hero-metrics" aria-label="Números da comunidade">
        <div><strong>{collections.length}</strong><span>{collections.length === 1 ? 'coleção publicada' : 'coleções publicadas'}</span></div>
        <div><strong>{cards.length}</strong><span>cartas cadastradas</span></div>
        <div><strong>{totalUnits}</strong><span>itens na comunidade</span></div>
      </div>
    </div>
  </section>

  <section class="shell navigation-cards marketplace-navigation" aria-label="Áreas do Nexus TCG" data-reveal>
    <a class="navigation-card cards-navigation" href={`${base}cartas/`}>
      <div class="navigation-icon" aria-hidden="true"><span>◆</span></div>
      <div><small>Todos os colecionadores</small><h2>Cartas</h2><p>Explore cartas publicadas em todas as coleções e descubra quem possui cada item.</p></div>
      <span class="navigation-arrow">↗</span>
    </a>
    <a class="navigation-card boosters-navigation" href={`${base}boosters/`}>
      <div class="navigation-icon" aria-hidden="true"><span>▰</span></div>
      <div><small>Pacotes da comunidade</small><h2>Boosters</h2><p>Veja boosters lacrados de diferentes colecionadores em um catálogo unificado.</p></div>
      <span class="navigation-arrow">↗</span>
    </a>
    <a class="navigation-card kits-navigation" href={`${base}kits/`}>
      <div class="navigation-icon" aria-hidden="true"><span>▦</span></div>
      <div><small>Ofertas combinadas</small><h2>Kits</h2><p>Encontre conjuntos personalizados de cartas e boosters por um preço único.</p></div>
      <span class="navigation-arrow">↗</span>
    </a>
    <a class="navigation-card products-navigation" href={`${base}produtos/`}>
      <div class="navigation-icon" aria-hidden="true"><span>▣</span></div>
      <div><small>Produtos fechados</small><h2>Produtos</h2><p>Boxes e produtos Pokémon lacrados com informações padronizadas.</p></div>
      <span class="navigation-arrow">↗</span>
    </a>
    <a class="navigation-card albums-navigation" href={`${base}albuns/`}>
      <div class="navigation-icon" aria-hidden="true"><span>▤</span></div>
      <div><small>Organização visual</small><h2>Álbuns</h2><p>Explore álbuns virtuais montados pelos colecionadores da comunidade.</p></div>
      <span class="navigation-arrow">↗</span>
    </a>
    <a class="navigation-card collections-navigation" href={`${base}colecoes/`}>
      <div class="navigation-icon" aria-hidden="true"><span>◎</span></div>
      <div><small>Perfis de colecionador</small><h2>Coleções</h2><p>Entre na página de cada usuário e navegue apenas pelos itens daquele acervo.</p></div>
      <span class="navigation-arrow">↗</span>
    </a>
  </section>

  <Carousel
    eyebrow="Cartas da comunidade"
    title="Descobertas de várias coleções."
    description="Uma seleção aleatória de cartas publicadas por todos os colecionadores do Nexus."
    items={featuredCards}
    viewAllHref={`${base}cartas/`}
    viewAllLabel="Ver todas as cartas"
  />

  <Carousel
    eyebrow="Boosters publicados"
    title="Pacotes lacrados em movimento."
    description="Boosters de diferentes coleções aparecem juntos para facilitar novas descobertas."
    items={featuredBoosters}
    viewAllHref={`${base}boosters/`}
    viewAllLabel="Ver todos os boosters"
  />

  <Carousel
    eyebrow="Kits dos colecionadores"
    title="Combinações feitas pela comunidade."
    description="Kits podem reunir cartas, boosters ou os dois, com quantidade e preço definidos pelo dono da coleção."
    items={featuredKits}
    viewAllHref={`${base}kits/`}
    viewAllLabel="Explorar kits"
    emptyTitle="O primeiro kit ainda não foi publicado"
    emptyDescription="Combine cartas e boosters da coleção para criar a primeira oferta do Nexus."
  />

  {products.length > 0 && (
    <Carousel
      eyebrow="Produtos lacrados"
      title="Produtos Pokémon fechados."
      description="Boxes, coleções especiais e outros produtos lacrados entram em uma categoria própria."
      items={featuredProducts}
      viewAllHref={`${base}produtos/`}
      viewAllLabel="Ver produtos"
    />
  )}

  <AlbumCarousel albums={featuredAlbums} viewAllHref={`${base}albuns/`} />
  <CollectionCarousel collections={featuredCollections} viewAllHref={`${base}colecoes/`} />
</BaseLayout>
