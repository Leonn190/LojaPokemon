---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductImage from '../components/ProductImage.astro';
import { getCards, shuffleItems } from '../lib/catalog';

const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const decorativeCards = getCards();
const carouselSections = [
  { kind: 'cards', eyebrow: 'Cartas da comunidade', title: 'Descobertas de várias coleções.', description: 'Uma seleção de cartas publicadas por todos os colecionadores do Vault.', href: `${base}cartas/`, label: 'Ver todas as cartas' },
  { kind: 'boosters', eyebrow: 'Boosters publicados', title: 'Pacotes lacrados em movimento.', description: 'Boosters de diferentes coleções aparecem juntos para facilitar novas descobertas.', href: `${base}boosters/`, label: 'Ver todos os boosters' },
  { kind: 'kits', eyebrow: 'Kits dos colecionadores', title: 'Combinações feitas pela comunidade.', description: 'Kits podem reunir cartas, boosters ou os dois, com quantidade e preço definidos pelo dono da coleção.', href: `${base}kits/`, label: 'Explorar kits' },
  { kind: 'products', eyebrow: 'Produtos lacrados', title: 'Produtos Pokémon fechados.', description: 'Boxes, coleções especiais e outros produtos lacrados entram em uma categoria própria.', href: `${base}produtos/`, label: 'Ver produtos' },
  { kind: 'albums', eyebrow: 'Álbuns da comunidade', title: 'Organizações que também contam uma história.', description: 'Abra um álbum e entre direto no fichário imersivo, página por página.', href: `${base}albuns/`, label: 'Ver todos os álbuns' },
  { kind: 'collections', eyebrow: 'Coleções da comunidade', title: 'Conheça quem coleciona no Vault.', description: 'Cada perfil reúne cartas, boosters, kits, produtos lacrados e álbuns publicados por um colecionador.', href: `${base}colecoes/`, label: 'Ver todas as coleções' },
];

// O fundo continua local para aparecer instantaneamente; o catálogo abaixo vem do Firestore.
const wallSource = shuffleItems(decorativeCards.filter((card) => card.imageCandidates.length > 0)).slice(0, 56);
const rotate = (items: typeof wallSource, amount: number) => items.length
  ? [...items.slice(amount % items.length), ...items.slice(0, amount % items.length)]
  : [];
const wallLanes = Array.from({ length: 8 }, (_, laneIndex) => {
  const lane = wallSource.filter((_, cardIndex) => cardIndex % 8 === laneIndex);
  return rotate(lane, laneIndex + 1);
});
---

<BaseLayout active="home">
  <section class="home-hero nexus-home-hero vault-intro-pending" aria-labelledby="home-title" data-vault-intro>
    <div class="nexus-hero-card-flow" aria-hidden="true">
      <div class="nexus-hero-flow-plane">
        {wallLanes.map((lane, laneIndex) => (
          <div class={`nexus-hero-flow-lane nexus-hero-flow-lane-${laneIndex + 1}`}>
            <div class="nexus-hero-flow-track">
              {[0, 1].map((sequence) => (
                <div class="nexus-hero-flow-set">
                  {lane.map((card, cardIndex) => (
                    <div class="nexus-hero-flow-card">
                      <ProductImage
                        item={card}
                        eager={sequence === 0 && laneIndex < 4 && cardIndex < 2}
                        interactive={false}
                      />
                    </div>
                  ))}
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
      <span class="nexus-hero-flow-glow"></span>
      <span class="nexus-hero-flow-vignette"></span>
    </div>

    <div class="vault-intro-fx" aria-hidden="true">
      <span class="vault-tech-drop"><i></i></span>
      <span class="vault-impact-core"></span>
      <span class="vault-impact-ring vault-impact-ring-a"></span>
      <span class="vault-impact-ring vault-impact-ring-b"></span>
      <span class="vault-impact-grid"></span>
    </div>

    <div class="shell hero-copy nexus-home-copy">
      <span class="hero-badge"><i></i> Coleções Pokémon em um só lugar</span>
      <h1 id="home-title"><span>Vault</span> <em>TCG</em></h1>
      <h2 class="nexus-home-tagline">Seu acervo. Sua vitrine.</h2>
      <p class="nexus-home-description">Organize sua coleção Pokémon, publique seus itens e encontre outros colecionadores. Use o Vault para organizar seu acervo e transformar itens selecionados em uma vitrine de venda.</p>
      <div class="hero-actions">
        <a class="primary-cta" href={`${base}cadastro/`} data-home-auth-cta><span>Entrar</span><b>→</b></a>
        <a class="secondary-cta" href={`${base}explorar/`}><span>Explorar</span><b>↗</b></a>
      </div>
      <div class="hero-metrics" aria-label="Números da comunidade">
        <div><strong data-home-collections>0</strong><span>coleções públicas</span></div>
        <div><strong data-home-cards>0</strong><span>cartas publicadas</span></div>
        <div><strong data-home-items>0</strong><span>itens publicados</span></div>
      </div>
    </div>
  </section>

  <section class="shell navigation-cards marketplace-navigation" aria-label="Áreas do Vault TCG" data-reveal>
    <a class="navigation-card cards-navigation" href={`${base}cartas/`}><div class="navigation-icon" aria-hidden="true"><span>◆</span></div><div><small>Todos os colecionadores</small><h2>Cartas</h2><p>Explore cartas publicadas em todas as coleções e descubra quem possui cada item.</p></div><span class="navigation-arrow">↗</span></a>
    <a class="navigation-card boosters-navigation" href={`${base}boosters/`}><div class="navigation-icon" aria-hidden="true"><span>▰</span></div><div><small>Pacotes da comunidade</small><h2>Boosters</h2><p>Veja boosters lacrados de diferentes colecionadores em um catálogo unificado.</p></div><span class="navigation-arrow">↗</span></a>
    <a class="navigation-card kits-navigation" href={`${base}kits/`}><div class="navigation-icon" aria-hidden="true"><span>▦</span></div><div><small>Ofertas combinadas</small><h2>Kits</h2><p>Encontre conjuntos personalizados de cartas e boosters por um preço único.</p></div><span class="navigation-arrow">↗</span></a>
    <a class="navigation-card products-navigation" href={`${base}produtos/`}><div class="navigation-icon" aria-hidden="true"><span>▣</span></div><div><small>Produtos fechados</small><h2>Produtos</h2><p>Boxes e produtos Pokémon lacrados com informações padronizadas.</p></div><span class="navigation-arrow">↗</span></a>
    <a class="navigation-card albums-navigation" href={`${base}albuns/`}><div class="navigation-icon" aria-hidden="true"><span>▤</span></div><div><small>Organização visual</small><h2>Álbuns</h2><p>Explore álbuns virtuais montados pelos colecionadores da comunidade.</p></div><span class="navigation-arrow">↗</span></a>
    <a class="navigation-card collections-navigation" href={`${base}colecoes/`}><div class="navigation-icon" aria-hidden="true"><span>◎</span></div><div><small>Perfis de colecionador</small><h2>Coleções</h2><p>Entre na página de cada usuário e navegue apenas pelos itens daquele acervo.</p></div><span class="navigation-arrow">↗</span></a>
  </section>

  {carouselSections.map((section) => (
    <section class:list={['shell', 'showcase-section', section.kind === 'albums' && 'album-carousel-section', section.kind === 'collections' && 'collections-showcase']} data-home-carousel={section.kind} data-reveal>
      <div class="section-heading carousel-heading">
        <div><span class="section-eyebrow">{section.eyebrow}</span><h2>{section.title}</h2><p>{section.description}</p></div>
        <div class="carousel-tools"><a class="text-link" href={section.href}>{section.label} <span>↗</span></a></div>
      </div>
      <div class="carousel-empty-panel home-carousel-loading" data-home-carousel-loading><span class="empty-carousel-icon" aria-hidden="true">◇</span><div><strong>Carregando publicações…</strong><p>Buscando os itens públicos da comunidade.</p></div></div>
      <div class:list={['carousel-track', section.kind === 'albums' && 'album-carousel-track', section.kind === 'collections' && 'collection-carousel-track']} data-home-carousel-track hidden aria-label={`${section.title}: itens passando automaticamente`}>
        <div class:list={['carousel-belt', section.kind === 'collections' && 'collection-carousel-belt']}>
          <div class:list={['carousel-sequence', section.kind === 'collections' && 'collection-carousel-sequence']} data-home-carousel-sequence="primary"></div>
          <div class:list={['carousel-sequence', section.kind === 'collections' && 'collection-carousel-sequence']} data-home-carousel-sequence="copy" aria-hidden="true"></div>
        </div>
      </div>
      <a class="carousel-empty-panel" href={section.href} data-home-carousel-empty hidden><span class="empty-carousel-icon" aria-hidden="true">◇</span><div><strong>Nada publicado por enquanto</strong><p>Os itens aparecerão aqui assim que um colecionador publicar esta categoria.</p></div><b aria-hidden="true">Explorar ↗</b></a>
    </section>
  ))}

  <script>
    import { albumMarkup, collectionMarkup, initializeOnlineImages, productMarkup } from '../scripts/online-markup';

    const intro = document.querySelector<HTMLElement>('[data-vault-intro]');
    const finishIntro = () => {
      if (!intro) return;
      intro.classList.remove('vault-intro-pending', 'vault-intro-running', 'vault-intro-revealing', 'vault-intro-copy');
      intro.classList.add('vault-intro-complete');
    };
    if (intro) {
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduced) finishIntro();
      else {
        intro.classList.add('vault-intro-running');
        window.setTimeout(() => intro.classList.add('vault-intro-revealing'), 520);
        window.setTimeout(() => intro.classList.add('vault-intro-copy'), 1180);
        window.setTimeout(finishIntro, 2050);
        window.setTimeout(finishIntro, 3200);
      }
    }

    const shuffle = <T,>(source: T[]) => {
      const items = [...source];
      for (let i = items.length - 1; i > 0; i -= 1) {
        const j = Math.floor(Math.random() * (i + 1));
        [items[i], items[j]] = [items[j], items[i]];
      }
      return items;
    };
    const fillLoop = <T,>(source: T[], minimum: number) => source.length
      ? Array.from({ length: Math.max(minimum, source.length) }, (_, index) => source[index % source.length])
      : [];

    const renderCarousel = (kind: string, items: any[], markup: (item: any) => string, minimum = 10) => {
      const section = document.querySelector<HTMLElement>(`[data-home-carousel="${kind}"]`);
      if (!section) return;
      const loading = section.querySelector<HTMLElement>('[data-home-carousel-loading]');
      const track = section.querySelector<HTMLElement>('[data-home-carousel-track]');
      const empty = section.querySelector<HTMLElement>('[data-home-carousel-empty]');
      const primary = section.querySelector<HTMLElement>('[data-home-carousel-sequence="primary"]');
      const copy = section.querySelector<HTMLElement>('[data-home-carousel-sequence="copy"]');
      if (loading) loading.hidden = true;
      if (!items.length) {
        if (track) track.hidden = true;
        if (empty) empty.hidden = false;
        return;
      }
      const loop = fillLoop(shuffle(items), minimum);
      const html = loop.map(markup).join('');
      if (primary) primary.innerHTML = html;
      if (copy) copy.innerHTML = html;
      if (empty) empty.hidden = true;
      if (track) track.hidden = false;
      initializeOnlineImages(section);
    };

    const loadHome = async () => {
      try {
        const cloud = (window as any).VaultCloud;
        if (!cloud) throw new Error('Catálogo ainda não foi inicializado.');
        const [collections, cards, boosters, kits, products, albums] = await Promise.all([
          cloud.listPublicCollections(),
          cloud.listPublicItems('card', 80),
          cloud.listPublicItems('booster', 28),
          cloud.listPublicItems('kit', 28),
          cloud.listPublicItems('product', 28),
          cloud.listPublicAlbums(),
        ]);

        const cardCount = collections.reduce((sum: number, profile: any) => sum + Number(profile.stats?.cards || 0), 0);
        const itemCount = collections.reduce((sum: number, profile: any) => sum
          + Number(profile.stats?.cards || 0)
          + Number(profile.stats?.boosters || 0)
          + Number(profile.stats?.kits || 0)
          + Number(profile.stats?.products || 0), 0);
        const collectionMetric = document.querySelector<HTMLElement>('[data-home-collections]');
        const cardMetric = document.querySelector<HTMLElement>('[data-home-cards]');
        const itemMetric = document.querySelector<HTMLElement>('[data-home-items]');
        if (collectionMetric) collectionMetric.textContent = String(collections.length);
        if (cardMetric) cardMetric.textContent = String(cardCount);
        if (itemMetric) itemMetric.textContent = String(itemCount);

        const previewMap = new Map<string, any[]>();
        cards.forEach((card: any) => {
          [card.collectionUid, card.ownerUid, card.ownerCollectionSlug].filter(Boolean).forEach((key: string) => {
            const list = previewMap.get(String(key)) || [];
            if (list.length < 12) list.push(card);
            previewMap.set(String(key), list);
          });
        });
        const collectionsWithCovers = collections.map((profile: any) => {
          const keys = [profile.uid, profile.ownerUid, profile.slug, profile.collectionId].filter(Boolean).map(String);
          const previewCards = keys.flatMap((key) => previewMap.get(key) || []).filter((card, index, list) => list.indexOf(card) === index).slice(0, 12);
          return { ...profile, previewCards };
        });

        renderCarousel('cards', shuffle(cards).slice(0, 14), (item) => productMarkup(item, { compact: true }), 14);
        renderCarousel('boosters', shuffle(boosters).slice(0, 14), (item) => productMarkup(item, { compact: true }), 12);
        renderCarousel('kits', shuffle(kits).slice(0, 14), (item) => productMarkup(item, { compact: true }), 10);
        renderCarousel('products', shuffle(products).slice(0, 14), (item) => productMarkup(item, { compact: true }), 10);
        renderCarousel('albums', shuffle(albums).slice(0, 14), (item) => albumMarkup(item, true), 12);
        renderCarousel('collections', shuffle(collectionsWithCovers), (item) => collectionMarkup(item, true), Math.max(1, collectionsWithCovers.length));
      } catch (_) {
        document.querySelectorAll<HTMLElement>('[data-home-carousel]').forEach((section) => {
          const loading = section.querySelector<HTMLElement>('[data-home-carousel-loading]');
          const empty = section.querySelector<HTMLElement>('[data-home-carousel-empty]');
          if (loading) loading.hidden = true;
          if (empty) empty.hidden = false;
        });
      }
    };

    const scheduleHomeLoad = () => {
      const idle = (window as any).requestIdleCallback;
      if (typeof idle === 'function') idle(loadHome, { timeout: 700 });
      else window.setTimeout(loadHome, 40);
    };
    if ((window as any).VaultCloud) scheduleHomeLoad();
    else window.addEventListener('vault:cloud-ready', scheduleHomeLoad, { once: true });
  </script>
</BaseLayout>
