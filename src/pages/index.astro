---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductImage from '../components/ProductImage.astro';
import { getCards, shuffleItems } from '../lib/catalog';

const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const decorativeCards = getCards();

// O fundo da abertura usa o mesmo princípio visual das coleções: várias colunas
// de cartas subindo continuamente, só que inclinado para a direita e sem hover.
const wallSource = shuffleItems(decorativeCards.filter((card) => card.imageCandidates.length > 0)).slice(0, 56);
const rotate = (items: typeof wallSource, amount: number) => items.length
  ? [...items.slice(amount % items.length), ...items.slice(0, amount % items.length)]
  : [];
const wallLanes = Array.from({ length: 8 }, (_, laneIndex) => {
  const lane = wallSource.filter((_, cardIndex) => cardIndex % 8 === laneIndex);
  return rotate(lane, laneIndex + 1);
});
---

<BaseLayout active="home">
  <section class="home-hero nexus-home-hero vault-intro-pending" aria-labelledby="home-title" data-vault-intro>
    <div class="nexus-hero-card-flow" aria-hidden="true">
      <div class="nexus-hero-flow-plane">
        {wallLanes.map((lane, laneIndex) => (
          <div class={`nexus-hero-flow-lane nexus-hero-flow-lane-${laneIndex + 1}`}>
            <div class="nexus-hero-flow-track">
              {[0, 1].map((sequence) => (
                <div class="nexus-hero-flow-set">
                  {lane.map((card, cardIndex) => (
                    <div class="nexus-hero-flow-card">
                      <ProductImage
                        item={card}
                        eager={true}
                        interactive={false}
                      />
                    </div>
                  ))}
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
      <span class="nexus-hero-flow-glow"></span>
      <span class="nexus-hero-flow-vignette"></span>
    </div>

    <div class="vault-intro-fx" aria-hidden="true">
      <span class="vault-tech-drop"><i></i></span>
      <span class="vault-impact-core"></span>
      <span class="vault-impact-ring vault-impact-ring-a"></span>
      <span class="vault-impact-ring vault-impact-ring-b"></span>
      <span class="vault-impact-grid"></span>
    </div>

    <div class="shell hero-copy nexus-home-copy">
      <span class="hero-badge"><i></i> Coleções Pokémon em um só lugar</span>
      <h1 id="home-title"><span>Vault</span> <em>TCG</em></h1>
      <h2 class="nexus-home-tagline">Seu acervo. Sua vitrine.</h2>
      <p class="nexus-home-description">Organize sua coleção Pokémon, publique seus itens e encontre outros colecionadores. Use o Vault para guardar sua coleção online ou transformar itens selecionados em uma vitrine de venda.</p>
      <div class="hero-actions">
        <a class="primary-cta" href={`${base}cadastro/`} data-home-auth-cta><span>Entrar</span><b>→</b></a>
        <a class="secondary-cta" href={`${base}explorar/`}><span>Explorar</span><b>↗</b></a>
      </div>
      <div class="hero-metrics" aria-label="Números da comunidade">
        <div><strong data-home-collections>0</strong><span>coleções públicas</span></div>
        <div><strong data-home-cards>0</strong><span>cartas publicadas</span></div>
        <div><strong data-home-items>0</strong><span>itens publicados</span></div>
      </div>
    </div>
  </section>

  <section class="shell navigation-cards marketplace-navigation" aria-label="Áreas do Vault TCG" data-reveal>
    <a class="navigation-card cards-navigation" href={`${base}cartas/`}>
      <div class="navigation-icon" aria-hidden="true"><span>◆</span></div>
      <div><small>Todos os colecionadores</small><h2>Cartas</h2><p>Explore cartas publicadas em todas as coleções e descubra quem possui cada item.</p></div>
      <span class="navigation-arrow">↗</span>
    </a>
    <a class="navigation-card boosters-navigation" href={`${base}boosters/`}>
      <div class="navigation-icon" aria-hidden="true"><span>▰</span></div>
      <div><small>Pacotes da comunidade</small><h2>Boosters</h2><p>Veja boosters lacrados de diferentes colecionadores em um catálogo unificado.</p></div>
      <span class="navigation-arrow">↗</span>
    </a>
    <a class="navigation-card kits-navigation" href={`${base}kits/`}>
      <div class="navigation-icon" aria-hidden="true"><span>▦</span></div>
      <div><small>Ofertas combinadas</small><h2>Kits</h2><p>Encontre conjuntos personalizados de cartas e boosters por um preço único.</p></div>
      <span class="navigation-arrow">↗</span>
    </a>
    <a class="navigation-card products-navigation" href={`${base}produtos/`}>
      <div class="navigation-icon" aria-hidden="true"><span>▣</span></div>
      <div><small>Produtos fechados</small><h2>Produtos</h2><p>Boxes e produtos Pokémon lacrados com informações padronizadas.</p></div>
      <span class="navigation-arrow">↗</span>
    </a>
    <a class="navigation-card albums-navigation" href={`${base}albuns/`}>
      <div class="navigation-icon" aria-hidden="true"><span>▤</span></div>
      <div><small>Organização visual</small><h2>Álbuns</h2><p>Explore álbuns virtuais montados pelos colecionadores da comunidade.</p></div>
      <span class="navigation-arrow">↗</span>
    </a>
    <a class="navigation-card collections-navigation" href={`${base}colecoes/`}>
      <div class="navigation-icon" aria-hidden="true"><span>◎</span></div>
      <div><small>Perfis de colecionador</small><h2>Coleções</h2><p>Entre na página de cada usuário e navegue apenas pelos itens daquele acervo.</p></div>
      <span class="navigation-arrow">↗</span>
    </a>
  </section>


  <section class="shell home-online-preview" data-home-online-preview data-reveal>
    <div class="section-heading"><div><span class="section-eyebrow">Agora tudo online</span><h2>Publicações recentes da comunidade</h2><p>Estes cards são carregados do Firestore. Quando um usuário edita a coleção, a mudança passa a aparecer aqui sem baixar ZIP ou fazer novo deploy.</p></div><a class="text-link" href={`${base}explorar/`}>Explorar tudo <span>↗</span></a></div>
    <div class="catalog-grid" data-home-preview-grid></div>
    <div class="empty-state" data-home-preview-empty hidden><span>◇</span><h2>A comunidade online está começando</h2><p>Entre ou crie uma conta para publicar os primeiros itens.</p></div>
  </section>

  <script>
    import { initializeOnlineImages, productMarkup } from '../scripts/online-markup';
    const loadHome = async () => {
      try {
        const cloud = (window as any).VaultCloud; if (!cloud) throw new Error('Firebase ainda não foi inicializado.');
        const [collections, items] = await Promise.all([cloud.listPublicCollections(), cloud.listPublicItems(undefined, 8)]);
        const cardCount = collections.reduce((sum: number, profile: any) => sum + Number(profile.stats?.cards || 0), 0);
        const itemCount = collections.reduce((sum: number, profile: any) => sum + Number(profile.stats?.cards || 0) + Number(profile.stats?.boosters || 0) + Number(profile.stats?.kits || 0) + Number(profile.stats?.products || 0), 0);
        const collectionMetric = document.querySelector<HTMLElement>('[data-home-collections]'); const cardMetric = document.querySelector<HTMLElement>('[data-home-cards]'); const itemMetric = document.querySelector<HTMLElement>('[data-home-items]');
        if (collectionMetric) collectionMetric.textContent = String(collections.length); if (cardMetric) cardMetric.textContent = String(cardCount); if (itemMetric) itemMetric.textContent = String(itemCount);
        const grid = document.querySelector<HTMLElement>('[data-home-preview-grid]'); const empty = document.querySelector<HTMLElement>('[data-home-preview-empty]'); const sample = [...items].sort(() => Math.random() - .5).slice(0, 8);
        if (grid) { grid.innerHTML = sample.map((item: any) => productMarkup(item, { compact: true })).join(''); initializeOnlineImages(grid); } if (empty) empty.hidden = sample.length !== 0;
      } catch (_) { const empty = document.querySelector<HTMLElement>('[data-home-preview-empty]'); if (empty) empty.hidden = false; }
    };
    if ((window as any).VaultCloud) loadHome(); else window.addEventListener('vault:cloud-ready', loadHome, { once: true });
  </script>
</BaseLayout>
