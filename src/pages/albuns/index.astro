---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Álbuns da comunidade" description="Explore álbuns virtuais publicados nas coleções públicas do Vault TCG." active="albums">
  <section class="catalog-hero album-catalog-hero">
    <div class="shell catalog-hero-grid">
      <div data-reveal><span class="hero-badge"><i></i> Organização visual</span><h1>Álbuns virtuais</h1><p>Explore álbuns montados pelos colecionadores. Coleções privadas permanecem fora desta área.</p></div>
    </div>
  </section>

  <section class="shell albums-catalog" data-online-albums>
    <div class="explore-search-stack" data-reveal>
      <div class="explore-search-toolbar">
        <div class="search-control explore-main-search"><label for="album-search">Pesquisar álbuns</label><div class="search-input-wrap"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m21 21-4.35-4.35m2.35-5.65a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z" /></svg><input id="album-search" type="search" placeholder="Buscar álbum ou colecionador..." data-album-search /><kbd>/</kbd></div></div>
        <button class="explore-toolbar-button" type="button" data-album-filter-toggle aria-expanded="false"><span aria-hidden="true">☷</span><strong>Filtros</strong><i data-album-filter-indicator hidden></i></button>
        <div class="select-control explore-sort-control"><label>Ordenar</label><div class="select-input-wrap"><span class="select-symbol" aria-hidden="true">↕</span><select data-album-sort><option value="name">Nome A–Z</option><option value="name-desc">Nome Z–A</option><option value="filled-desc">Mais preenchidos</option><option value="filled-asc">Menos preenchidos</option></select><svg class="select-chevron" viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 7.5 4.5 4.5 4.5-4.5" /></svg></div></div>
      </div>
      <div class="explore-filter-drawer compact-explore-filters" data-album-filter-drawer hidden>
        <div class="select-control" data-album-owner-wrap hidden><label>Colecionador</label><div class="select-input-wrap"><span class="select-symbol" aria-hidden="true">◎</span><select data-album-owner><option value="">Todos</option></select><svg class="select-chevron" viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 7.5 4.5 4.5 4.5-4.5" /></svg></div></div>
        <button class="clear-button explore-clear-filters" type="button" data-album-clear-filters>Limpar filtros</button>
      </div>
    </div>
    <div class="album-skeleton-grid" data-album-skeleton aria-hidden="true">
      {Array.from({ length: 6 }, () => <article class="album-skeleton-card"><div class="album-skeleton-cover skeleton-pulse"></div><div><i class="skeleton-pulse"></i><b class="skeleton-pulse"></b><span class="skeleton-pulse"></span><span class="skeleton-pulse short"></span></div></article>)}
    </div>
    <div class="albums-catalog-grid" data-album-grid hidden></div>
    <div class="catalog-load-sentinel" data-album-sentinel aria-hidden="true"></div>
    <div class="empty-state" data-album-empty hidden><span>▤</span><h2>Nenhum álbum encontrado</h2><p>Não há álbuns para esta busca.</p></div>
  </section>

  <script>
  import '../../scripts/pages/albums-page';
</script>
</BaseLayout>
