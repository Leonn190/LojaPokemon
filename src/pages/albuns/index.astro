---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Álbuns da comunidade" description="Explore álbuns virtuais publicados nas coleções públicas do Vault TCG." active="albums">
  <section class="catalog-hero album-catalog-hero"><div class="shell catalog-hero-grid"><div data-reveal><span class="hero-badge"><i></i> Organização visual online</span><h1>Álbuns virtuais</h1><p>Os álbuns publicados são carregados diretamente do Firestore. Álbuns de coleções privadas nunca aparecem nesta página.</p></div><div class="catalog-hero-stats" data-reveal><div><strong data-album-total>0</strong><span>álbuns publicados</span></div><div><strong data-album-cards>0</strong><span>cartas posicionadas</span></div></div></div></section>
  <section class="shell albums-catalog" data-online-albums><div class="albums-catalog-toolbar"><label><span>⌕</span><input type="search" placeholder="Buscar álbum ou colecionador..." data-album-search /></label><strong data-album-count>Conectando…</strong></div><div class="albums-catalog-grid" data-album-grid></div><div class="empty-state" data-album-empty hidden><span>▤</span><h2>Nenhum álbum publicado</h2><p>Não há resultado para esta busca ou ainda não existem álbuns públicos.</p></div></section>
  <script>
    import { albumMarkup, initializeOnlineImages, normalizeText } from '../../scripts/online-markup';
    const root = document.querySelector<HTMLElement>('[data-online-albums]');
    if (root) {
      const input = root.querySelector<HTMLInputElement>('[data-album-search]'); const grid = root.querySelector<HTMLElement>('[data-album-grid]'); const count = root.querySelector<HTMLElement>('[data-album-count]'); const empty = root.querySelector<HTMLElement>('[data-album-empty]'); let albums: any[] = [];
      const render = () => { const q = normalizeText(input?.value || ''); const visible = albums.filter((album) => !q || normalizeText(`${album.searchText || ''} ${album.name || ''} ${album.ownerName || ''} ${album.ownerCollectionName || ''}`).includes(q)); if (grid) { grid.innerHTML = visible.map((album) => albumMarkup(album)).join(''); initializeOnlineImages(grid); } if (count) count.textContent = `${visible.length} ${visible.length === 1 ? 'álbum' : 'álbuns'}`; if (empty) empty.hidden = visible.length !== 0; };
      const load = async () => { try { const cloud = (window as any).VaultCloud; if (!cloud) throw new Error('Firebase ainda não foi inicializado.'); albums = await cloud.listPublicAlbums(); const total = document.querySelector<HTMLElement>('[data-album-total]'); const cards = document.querySelector<HTMLElement>('[data-album-cards]'); if (total) total.textContent = String(albums.length); if (cards) cards.textContent = String(albums.reduce((sum, album) => sum + Number(album.occupiedSlots || 0), 0)); render(); } catch (error: any) { if (count) count.textContent = 'Firebase indisponível'; if (empty) { empty.hidden = false; const p = empty.querySelector('p'); if (p) p.textContent = error?.message || 'Confira a configuração do Firebase.'; } } };
      input?.addEventListener('input', render); if ((window as any).VaultCloud) load(); else window.addEventListener('vault:cloud-ready', load, { once: true });
    }
  </script>
</BaseLayout>
