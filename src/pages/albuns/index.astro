---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Álbuns da comunidade" description="Explore álbuns virtuais publicados nas coleções públicas do Vault TCG." active="albums">
  <section class="catalog-hero album-catalog-hero">
    <div class="shell catalog-hero-grid">
      <div data-reveal><span class="hero-badge"><i></i> Organização visual</span><h1>Álbuns virtuais</h1><p>Explore álbuns montados pelos colecionadores. Coleções privadas permanecem fora desta área.</p></div>
      <div class="catalog-hero-stats" data-reveal><div><strong data-album-total>—</strong><span>álbuns publicados</span></div><div><strong data-album-cards>—</strong><span>cartas posicionadas</span></div></div>
    </div>
  </section>

  <section class="shell albums-catalog" data-online-albums>
    <div class="albums-catalog-toolbar"><label><span>⌕</span><input type="search" placeholder="Buscar álbum ou colecionador..." data-album-search /></label><strong data-album-count aria-live="polite">—</strong></div>
    <div class="album-skeleton-grid" data-album-skeleton aria-hidden="true">
      {Array.from({ length: 6 }, () => <article class="album-skeleton-card"><div class="album-skeleton-cover skeleton-pulse"></div><div><i class="skeleton-pulse"></i><b class="skeleton-pulse"></b><span class="skeleton-pulse"></span><span class="skeleton-pulse short"></span></div></article>)}
    </div>
    <div class="albums-catalog-grid" data-album-grid hidden></div>
    <div class="catalog-load-sentinel" data-album-sentinel aria-hidden="true"></div>
    <div class="empty-state" data-album-empty hidden><span>▤</span><h2>Nenhum álbum encontrado</h2><p>Não há álbuns para esta busca.</p></div>
  </section>

  <script>
    import { albumMarkup, initializeOnlineImages, normalizeText } from '../../scripts/online-markup';

    const root = document.querySelector<HTMLElement>('[data-online-albums]');
    if (root) {
      const input = root.querySelector<HTMLInputElement>('[data-album-search]');
      const grid = root.querySelector<HTMLElement>('[data-album-grid]');
      const skeleton = root.querySelector<HTMLElement>('[data-album-skeleton]');
      const sentinel = root.querySelector<HTMLElement>('[data-album-sentinel]');
      const count = root.querySelector<HTMLElement>('[data-album-count]');
      const empty = root.querySelector<HTMLElement>('[data-album-empty]');
      const total = document.querySelector<HTMLElement>('[data-album-total]');
      const cards = document.querySelector<HTMLElement>('[data-album-cards]');
      const pageSize = 18;
      let albums: any[] = [];
      let cursor: string | null = null;
      let hasMore = true;
      let fullyLoaded = false;
      let pagePromise: Promise<void> | null = null;
      let completePromise: Promise<void> | null = null;
      let searchTimer = 0;

      const mergeAlbums = (incoming: any[]) => {
        const known = new Set(albums.map((album) => String(album._docId || album.id || album.slug || '')));
        incoming.forEach((album) => {
          const key = String(album._docId || album.id || album.slug || '');
          if (!key || !known.has(key)) { albums.push(album); if (key) known.add(key); }
        });
      };

      const updateMetrics = () => {
        if (total) total.textContent = `${albums.length}${hasMore ? '+' : ''}`;
        if (cards) cards.textContent = `${albums.reduce((sum, album) => sum + Number(album.occupiedSlots || 0), 0)}${hasMore ? '+' : ''}`;
      };

      const render = () => {
        const q = normalizeText(input?.value || '');
        const visible = albums.filter((album) => !q || normalizeText(`${album.searchText || ''} ${album.name || ''} ${album.ownerName || ''} ${album.ownerCollectionName || ''}`).includes(q));
        if (grid) {
          grid.innerHTML = visible.map((album) => albumMarkup(album)).join('');
          grid.hidden = false;
          initializeOnlineImages(grid);
        }
        if (skeleton) skeleton.hidden = true;
        if (count) count.textContent = fullyLoaded ? `${visible.length} ${visible.length === 1 ? 'álbum' : 'álbuns'}` : `${visible.length}+ álbuns carregados`;
        if (empty) empty.hidden = !(fullyLoaded && visible.length === 0);
        updateMetrics();
      };

      const loadNextPage = (renderAfter = true): Promise<void> => {
        if (!hasMore) return Promise.resolve();
        if (pagePromise) return pagePromise;
        pagePromise = (async () => {
          const cloud = (window as any).VaultCloud;
          if (!cloud) throw new Error('Os álbuns ainda não estão disponíveis.');
          const page = await cloud.listPublicAlbumsPage(pageSize, cursor);
          mergeAlbums(Array.isArray(page?.items) ? page.items : []);
          cursor = page?.nextCursor || null;
          hasMore = Boolean(page?.hasMore && cursor);
          fullyLoaded = !hasMore;
          if (renderAfter) render();
        })().finally(() => { pagePromise = null; });
        return pagePromise;
      };

      const ensureComplete = () => {
        if (fullyLoaded) return Promise.resolve();
        if (completePromise) return completePromise;
        completePromise = (async () => {
          while (hasMore) await loadNextPage(false);
          fullyLoaded = true;
          render();
        })().finally(() => { completePromise = null; });
        return completePromise;
      };

      const load = async () => {
        try {
          await loadNextPage();
        } catch (error: any) {
          if (skeleton) skeleton.hidden = true;
          if (grid) grid.hidden = true;
          if (count) count.textContent = '';
          if (empty) {
            empty.hidden = false;
            const title = empty.querySelector('h2');
            const text = empty.querySelector('p');
            if (title) title.textContent = 'Não foi possível carregar';
            if (text) text.textContent = error?.message || 'Não foi possível carregar os álbuns agora.';
          }
        }
      };

      input?.addEventListener('input', () => {
        window.clearTimeout(searchTimer);
        searchTimer = window.setTimeout(async () => {
          if (normalizeText(input.value) && !fullyLoaded) await ensureComplete();
          else render();
        }, 180);
      });

      if (sentinel && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          if (entries.some((entry) => entry.isIntersecting) && !normalizeText(input?.value || '')) loadNextPage().catch(() => {});
        }, { rootMargin: '700px 0px' });
        observer.observe(sentinel);
      }

      if ((window as any).VaultCloud) load();
      else window.addEventListener('vault:cloud-ready', load, { once: true });
    }
  </script>
</BaseLayout>
