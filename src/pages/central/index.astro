---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { TCG_CONFIG } from '../../lib/tcg-metadata';

const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const tcgConfigJson = JSON.stringify(TCG_CONFIG).replace(/</g, '\\u003c');
---

<BaseLayout
  title="Meu Vault"
  description="Gerencie sua coleção, inventário, negociações, perfil e conta no Vault TCG."
  active="central"
  bodyClass="central-page"
>
  <script type="application/json" data-tcg-config set:html={tcgConfigJson}></script>

  <section class="shell collection-editor central-collection-editor" data-editor-root data-base={base}>
    <div class="central-auth-gate" data-editor-notice>
      <span class="central-auth-spinner" aria-hidden="true"></span>
      <div><strong>Carregando sua coleção</strong><small>Confirmando sua sessão e buscando os dados da sua conta…</small></div>
    </div>

    <section class="editor-workspace" data-editor-workspace hidden>
      <header class="editor-workspace-header vault-workspace-header">
        <div class="vault-workspace-title">
          <h2>Meu Vault</h2>
          <div class="vault-collection-identity"><span>Coleção ativa</span><strong data-workspace-title>Sua coleção</strong></div>
        </div>
        <div class="workspace-header-actions">
          <span class="workspace-save-state" data-cloud-save-state><i></i> Tudo salvo</span>
          <a class="secondary-cta vault-profile-link" data-open-public-profile href="#" target="_blank" rel="noreferrer"><span>Ver perfil</span><b>↗</b></a>
          <button type="button" class="secondary-cta" data-save-now><span>Salvar</span><b>✓</b></button>
        </div>
      </header>

      <nav class="editor-admin-tabs" aria-label="Seções do Meu Vault">
        <button type="button" class="active" data-admin-nav="overview"><span>⌂</span><strong>Visão geral</strong></button>
        <button type="button" data-admin-nav="inventory"><span>▦</span><strong>Inventário</strong></button>
        <button type="button" data-admin-nav="negotiations"><span>◇</span><strong>Negociações</strong></button>
        <button type="button" data-admin-nav="profile"><span>✦</span><strong>Perfil</strong></button>
        <button type="button" data-admin-nav="account"><span>⚙</span><strong>Conta</strong></button>
      </nav>

      <div class="editor-admin-layout">
        <div class="editor-admin-main">
          <section class="editor-dashboard vault-overview" id="editor-overview" data-admin-section="overview">
            <header class="editor-dashboard-heading vault-overview-heading">
              <div><h3>Visão geral</h3><p>Valor, tamanho da coleção e reputação da sua conta.</p></div>
              <a class="editor-public-preview-link" data-open-public-profile href="#" target="_blank" rel="noreferrer"><span>Ver perfil público</span><b>↗</b></a>
            </header>

            <div class="vault-overview-summary">
              <article class="vault-value-card">
                <div class="vault-value-copy">
                  <small>Valor da coleção</small><strong data-dashboard-value>R$ 0,00</strong><em data-dashboard-value-note>somente itens com Preço definido</em>
                  <div class="vault-plus-quote-action">
                    <div><span>Vault+ · cotização geral</span><strong data-vaultplus-quote-summary>Disponível para assinantes Vault+</strong></div>
                    <button type="button" class="primary-cta compact" data-open-bulk-quote><span>Cotizar coleção</span><b>↯</b></button>
                  </div>
                </div>
                <details class="vault-valuation-details">
                  <summary>Ver cotação detalhada <b>⌄</b></summary>
                  <div class="editor-card-valuation" aria-label="Cotação das cartas pela MYP">
                    <header><div><h4>Cotação MYP das cartas</h4><small>Detalhes da cotação ponderados pela quantidade.</small></div></header>
                    <div class="editor-card-valuation-grid">
                      <article><small>Mais barato certificado</small><strong data-dashboard-card-certified-low>R$ 0,00</strong></article>
                      <article><small>Mais barato geral</small><strong data-dashboard-card-general-low>R$ 0,00</strong></article>
                      <article><small>Média certificada</small><strong data-dashboard-card-certified-average>R$ 0,00</strong></article>
                      <article><small>Média geral</small><strong data-dashboard-card-general-average>R$ 0,00</strong></article>
                      <article><small>Mínimo</small><strong data-dashboard-card-minimum>R$ 0,00</strong><em>50% do mais barato certificado</em></article>
                    </div>
                  </div>
                </details>
              </article>

              <section class="vault-collection-stats" aria-label="Itens da coleção">
                <header><h4>Sua coleção</h4><button type="button" data-admin-jump="inventory">Abrir inventário →</button></header>
                <div class="editor-dashboard-metrics editor-dashboard-metrics-primary">
                  <article><span>◇</span><small>Cartas</small><strong data-dashboard-cards>0</strong></article>
                  <article><span>▱</span><small>Boosters</small><strong data-dashboard-boosters>0</strong></article>
                  <article><span>▣</span><small>Produtos</small><strong data-dashboard-products>0</strong></article>
                  <article><span>▦</span><small>Kits</small><strong data-dashboard-kits>0</strong></article>
                  <article><span>▤</span><small>Álbuns</small><strong data-dashboard-albums>0</strong></article>
                </div>
              </section>
            </div>

            <section class="account-score-section" aria-label="Scores da conta">
              <header class="account-score-heading">
                <div><h4>Reputação</h4><small>Segurança da conta e visibilidade da coleção.</small></div>
              </header>
              <div class="account-score-grid">
                <article class="account-score-card security-score-card">
                  <div class="score-card-copy">
                    <span class="score-card-icon">⌾</span>
                    <div><strong>Score de segurança</strong><small>Confiança e verificações da conta</small></div>
                  </div>
                  <div class="score-gauge" data-score-gauge="security">
                    <svg viewBox="0 0 240 132" role="img" aria-label="Score de segurança">
                      <path class="score-gauge-track" pathLength="100" d="M20 112 A100 100 0 0 1 220 112"></path>
                      <path class="score-gauge-value" pathLength="100" d="M20 112 A100 100 0 0 1 220 112" data-score-path="security"></path>
                    </svg>
                    <div class="score-gauge-number"><strong data-score-value="security">30</strong><span>/100</span></div>
                  </div>
                  <footer><span data-security-score-note>Gmail ainda não verificado</span><b data-security-score-delta>Base 30</b></footer>
                </article>

                <article class="account-score-card visibility-score-card">
                  <div class="score-card-copy">
                    <span class="score-card-icon">◉</span>
                    <div><strong>Score de visibilidade</strong><small>Potencial de descoberta da coleção</small></div>
                  </div>
                  <div class="score-gauge" data-score-gauge="visibility">
                    <svg viewBox="0 0 240 132" role="img" aria-label="Score de visibilidade">
                      <path class="score-gauge-track" pathLength="100" d="M20 112 A100 100 0 0 1 220 112"></path>
                      <path class="score-gauge-value" pathLength="100" d="M20 112 A100 100 0 0 1 220 112" data-score-path="visibility"></path>
                    </svg>
                    <div class="score-gauge-number"><strong data-score-value="visibility">30</strong><span>/100</span></div>
                  </div>
                  <footer><span data-visibility-score-note>Descoberta da coleção</span><b data-visibility-score-delta>Base 30</b></footer>
                </article>
              </div>
            </section>
          </section>

      <section class="editor-profile-settings settings-profile-card vault-profile-basics" data-profile-settings id="editor-profile" data-admin-section="profile">
        <header class="settings-section-heading"><span>✎</span><div><strong>Perfil público</strong><small>As informações que identificam sua coleção para outros usuários.</small></div></header>
        <div class="profile-settings-body">
          <label class="form-field"><span>Nome da coleção</span><input data-profile-field="title" /></label>
        </div>
      </section>

      <section class="editor-profile-settings settings-profile-card vault-account-basics" id="editor-account" data-admin-section="account">
        <header class="settings-section-heading"><span>◎</span><div><strong>Dados da conta</strong><small>Informações pessoais e de contato usadas no Vault.</small></div></header>
        <div class="profile-settings-body">
          <label class="form-field"><span>Seu nome</span><input data-profile-field="owner" /></label>
          <label class="form-field"><span>Telefone para propostas</span><input data-profile-field="phone" placeholder="(00) 00000-0000" /></label>
          <label class="form-field"><span>Gmail / e-mail da conta</span><input type="email" data-profile-field="email" readonly aria-readonly="true" /></label>
        </div>
      </section>

      <section class="vault-plus-account-panel" data-admin-section="account" data-vaultplus-account>
        <header class="settings-section-heading"><span>✦</span><div><strong>Vault+</strong><small>Ferramentas premium para cotização e visibilidade da sua coleção.</small></div><em data-vaultplus-account-status>Plano não ativo</em></header>
        <div class="vault-plus-account-body">
          <div class="vault-plus-account-copy">
            <strong data-vaultplus-account-title>Mais ferramentas para quem leva sua coleção a sério.</strong>
            <small data-vaultplus-account-copy>Tenha 2 cotizações gerais por semana, +10 no Score de Visibilidade e taxas reduzidas quando a cobrança de transações for lançada.</small>
          </div>
          <div class="vault-plus-account-quota" data-vaultplus-account-quota hidden><span>Cotizações desta semana</span><strong>0/2</strong><small>disponíveis</small></div>
          <a class="primary-cta compact" data-vaultplus-account-link href={`${base}vault-plus/`}><span>Conhecer Vault+</span><b>→</b></a>
        </div>
      </section>

      <section class="account-security-settings" data-admin-section="account" aria-label="Segurança da conta">
        <header class="settings-section-heading"><span>⌾</span><div><strong>Segurança da conta</strong><small>Verifique seu Gmail e mantenha sua senha atualizada.</small></div></header>
        <div class="account-security-grid">
          <article class="account-security-card email-verification-card" data-email-verification-card>
            <div class="account-security-card-top">
              <span class="account-security-icon">✉</span>
              <div><strong>Verificar Gmail</strong><small>Confirme que o endereço pertence a você e ganhe +5 no Score de segurança.</small></div>
              <em class="verification-status pending" data-email-verification-status>Não verificado</em>
            </div>
            <div class="email-verification-body">
              <div class="verification-email-display">
                <span>Gmail da conta</span>
                <strong data-security-email>—</strong>
              </div>
              <div class="account-security-actions">
                <button type="button" class="primary-cta compact" data-send-email-verification><span>Enviar verificação</span><b>→</b></button>
                <button type="button" class="secondary-cta compact" data-check-email-verification><span>Já verifiquei</span><b>✓</b></button>
              </div>
            </div>
            <p class="security-feedback" data-email-verification-feedback></p>
          </article>

          <article class="account-security-card password-change-card">
            <div class="account-security-card-top">
              <span class="account-security-icon">⌁</span>
              <div><strong>Alterar senha</strong><small data-password-reset-copy>Disponível após verificar seu Gmail.</small></div>
            </div>
            <div class="password-reset-email-flow">
              <div class="password-reset-route"><span>Gmail verificado</span><b>→</b><span>Link seguro</span><b>→</b><span>Firebase</span></div>
              <button type="button" class="secondary-cta compact" data-send-password-reset disabled><span>Enviar link para alterar senha</span><b>✉</b></button>
              <p class="security-feedback" data-password-reset-feedback></p>
            </div>
          </article>
        </div>
      </section>

      <section class="editor-control-center vault-profile-controls" aria-label="Visibilidade da coleção" data-admin-section="profile">
        <label class="editor-setting-card">
          <span class="setting-icon">◎</span>
          <span><strong>Coleção pública</strong><small>Define se sua coleção pode ser encontrada e visitada por outras pessoas.</small></span>
          <span class="switch"><input type="checkbox" data-collection-public /><i></i></span>
        </label>
        <label class="editor-setting-card">
          <span class="setting-icon">◉</span>
          <span><strong>Mostrar valor total</strong><small>Exibe ou oculta o valor estimado no seu perfil público.</small></span>
          <span class="switch"><input type="checkbox" data-show-collection-value checked /><i></i></span>
        </label>
      </section>

      <section class="editor-control-center vault-negotiation-controls" aria-label="Disponibilidade para vendas" data-admin-section="negotiations">
        <label class="editor-setting-card">
          <span class="setting-icon">$</span>
          <span><strong>Liberar vendas</strong><small>Permite que itens marcados para venda sejam incluídos em propostas.</small></span>
          <span class="switch"><input type="checkbox" data-collection-selling checked /><i></i></span>
        </label>
      </section>

      <section class="collector-personalization" aria-label="Personalização da página do colecionador" id="editor-appearance" data-admin-section="profile">
        <header><div><h3>Aparência</h3><p>Foto, banner e cores do seu perfil público.</p></div><span class="personalization-note">Prévia ao vivo</span></header>
        <div class="collector-personalization-grid">
          <div class="profile-photo-editor">
            <div class="profile-photo-preview" data-profile-photo-preview><span>TC</span></div>
            <div><strong>Foto do colecionador</strong><small>Informe o caminho da sua foto, por exemplo imagens/perfis/leon.webp.</small><div class="profile-photo-actions"><label><input type="text" data-profile-photo-path placeholder="imagens/perfis/minha-foto.webp" /><span>Caminho da foto</span></label><button type="button" data-remove-profile-photo>Remover</button></div></div>
          </div>
          <div class="profile-banner-editor">
            <div><strong>Banner do perfil</strong><small>Opcional. Use uma imagem horizontal; sem banner, o tema gera um fundo elegante automaticamente.</small></div>
            <label><span>Caminho do banner</span><input type="text" data-profile-banner-path placeholder="imagens/perfis/meu-banner.webp" /></label>
          </div>
          <div class="palette-editor">
            <div class="palette-editor-copy"><strong>Paleta da coleção</strong><small>Principal define o glow e ações, Secundária domina o fundo e Destaque cria contraste. Tudo continua editável a qualquer momento.</small><div class="palette-live-preview" data-palette-preview aria-hidden="true"><i></i><span><b>VAULT</b><small>prévia do tema</small></span><em></em></div></div>
            <div class="palette-inputs">
              <label><span>Principal</span><input type="color" value="#54e8df" data-palette-color="0" /></label>
              <label><span>Secundária</span><input type="color" value="#bc91ff" data-palette-color="1" /></label>
              <label><span>Destaque</span><input type="color" value="#f4c25c" data-palette-color="2" /></label>
            </div>
          </div>
        </div>
        <section class="public-profile-live-preview" data-public-profile-preview aria-label="Prévia em tempo real do perfil público">
          <div class="live-preview-browser"><span></span><span></span><span></span><small>Prévia pública</small></div>
          <div class="live-preview-hero" data-live-preview-hero>
            <div class="live-preview-banner" data-live-preview-banner></div>
            <div class="live-preview-profile">
              <div class="live-preview-avatar" data-live-preview-avatar>VT</div>
              <div><small>Colecionador no Vault</small><h4 data-live-preview-title>Minha coleção</h4></div>
              <button type="button" tabindex="-1">Fazer proposta</button>
            </div>
            <div class="live-preview-stats"><span><strong data-live-preview-cards>0</strong> cartas</span><span><strong data-live-preview-albums>0</strong> álbuns</span><span data-live-preview-value-wrap><strong data-live-preview-value>R$ 0,00</strong> estimados</span></div>
          </div>
        </section>
      </section>

      <section class="workspace-proposal-settings negotiation-center" aria-label="Negociações" id="editor-proposals" data-admin-section="negotiations">
        <header class="negotiation-center-heading">
          <div><h3>Negociações</h3><p>Gerencie regras, propostas enviadas, recebidas e negociações finalizadas.</p></div>
          <button type="button" class="secondary-cta compact" data-refresh-negotiations><span>Atualizar</span><b>↻</b></button>
        </header>

        <nav class="negotiation-tabs" role="tablist" aria-label="Áreas de negociação">
          <button type="button" class="active" data-negotiation-tab="terms"><span>Termos de negociação</span></button>
          <button type="button" data-negotiation-tab="sent"><span>Suas propostas</span><b data-negotiation-count="sent">0</b></button>
          <button type="button" data-negotiation-tab="received"><span>Propostas recebidas</span><b data-negotiation-count="received">0</b></button>
          <button type="button" data-negotiation-tab="completed"><span>Realizadas</span><b data-negotiation-count="completed">0</b></button>
        </nav>

        <div class="negotiation-panel active" data-negotiation-panel="terms">
          <div class="workspace-proposal-grid">
            <label><span>Regra principal</span><select data-proposal-policy><option value="flexible">Sou flexível quanto às regras</option><option value="none">Não aceito nenhuma proposta</option><option value="fixed_price_multi_only">Sem proposta para cartas precificadas e somente com mais de um produto</option><option value="no_defined_price">Sem propostas para cartas com preço definido</option><option value="multi_only">Propostas apenas com mais de um produto</option></select></label>
            <label><span>Preço exibido quando “Preço” estiver vazio</span><select data-price-display-fallback><option value="league_average_then_lowest">Média de mercado; se faltar, menor preço</option><option value="league_lowest_then_average">Menor preço; se faltar, média de mercado</option><option value="consult">Mostrar “Consultar”</option></select></label>
            <label class="proposal-flexible-check"><input type="checkbox" data-flexible-discounts /><span><strong>Descontos flexíveis</strong><small>Permite que o comprador sugira qualquer percentual.</small></span></label>
          </div>
          <div class="workspace-tier-heading"><div><strong>Marcos máximos de desconto</strong><small>O maior marco alcançado pelo valor da proposta define o limite.</small></div><button type="button" data-add-discount-tier><span>＋</span> Adicionar marco</button></div>
          <div class="workspace-tier-list" data-discount-tier-list></div>
        </div>

        <div class="negotiation-panel" data-negotiation-panel="sent" hidden>
          <div class="negotiation-list-heading"><div><strong>Suas propostas</strong><small>Negociações que você iniciou e que ainda estão em andamento.</small></div><span data-negotiation-state="sent">Carregando…</span></div>
          <div class="negotiation-list" data-negotiation-list="sent"><div class="proposal-inbox-loading">Buscando propostas…</div></div>
        </div>

        <div class="negotiation-panel" data-negotiation-panel="received" hidden>
          <div class="negotiation-list-heading"><div><strong>Propostas recebidas</strong><small>Propostas abertas para itens da sua coleção.</small></div><span data-negotiation-state="received">Carregando…</span></div>
          <div class="negotiation-list" data-negotiation-list="received"><div class="proposal-inbox-loading">Buscando propostas…</div></div>
        </div>

        <div class="negotiation-panel" data-negotiation-panel="completed" hidden>
          <div class="negotiation-list-heading"><div><strong>Realizadas</strong><small>Negociações aceitas ou recusadas, com o histórico preservado.</small></div><span data-negotiation-state="completed">Carregando…</span></div>
          <div class="negotiation-list" data-negotiation-list="completed"><div class="proposal-inbox-loading">Buscando histórico…</div></div>
        </div>

        <div class="negotiation-feedback" data-negotiation-feedback hidden></div>
      </section>

      <section class="editor-inventory-shell" data-inventory-section id="editor-inventory" data-admin-section="inventory">
        <header class="inventory-shell-header">
          <div><h3>Inventário</h3><p>Gerencie todos os itens da sua coleção.</p></div>
          <label class="inventory-search"><span>⌕</span><input type="search" placeholder="Buscar nesta aba..." data-inventory-search /></label>
        </header>

        <nav class="inventory-tabs" role="tablist" aria-label="Tipos de inventário">
          <button type="button" class="active" data-inventory-tab="cards"><span>Cartas</span><b data-tab-count="cards">0</b></button>
          <button type="button" data-inventory-tab="boosters"><span>Boosters</span><b data-tab-count="boosters">0</b></button>
          <button type="button" data-inventory-tab="kits"><span>Kits</span><b data-tab-count="kits">0</b></button>
          <button type="button" data-inventory-tab="products"><span>Produtos</span><b data-tab-count="products">0</b></button>
          <button type="button" data-inventory-tab="albums"><span>Álbuns</span><b data-tab-count="albums">0</b></button>
          <button type="button" class="inventory-add-current" data-add-current>
            <span>＋</span><strong data-add-current-label>Adicionar carta</strong>
          </button>
        </nav>

        <div class="inventory-metadata-filters" data-inventory-metadata-filters>
          <label><span>Era</span><select data-inventory-filter="era"><option value="">Todas</option>{Object.values(TCG_CONFIG.eras).map((era) => <option value={era.id}>{era.label}</option>)}</select></label>
          <label><span>Coleção</span><select data-inventory-filter="collectionId" disabled><option value="">Todas</option></select></label>
          <label><span>Grupo</span><select data-inventory-filter="group"><option value="">Todos</option>{TCG_CONFIG.groups.map((group) => <option value={group.id}>{group.label}</option>)}</select></label>
          <label><span>Classe</span><select data-inventory-filter="cardClass" disabled><option value="">Todas</option></select></label>
          <label><span>Tipo</span><select data-inventory-filter="type" disabled><option value="">Todos</option></select></label>
          <label><span>Idioma</span><select data-inventory-filter="language"><option value="">Todos</option>{TCG_CONFIG.languages.map((language) => <option value={language.id}>{language.label}</option>)}</select></label>
          <label><span>Estado</span><select data-inventory-filter="condition"><option value="">Todos</option>{Object.keys(TCG_CONFIG.conditions).map((condition) => <option value={condition}>{condition}</option>)}</select></label>
          <button type="button" data-clear-inventory-filters>Limpar filtros</button>
        </div>

        <div class="editor-inventory" data-editor-inventory></div>
      </section>

      <div class="editor-export-panel cloud-save-panel vault-account-actions" data-admin-section="account">
        <div><h3>Sessão e salvamento</h3><p>Suas alterações são salvas automaticamente na conta.</p></div>
        <div class="editor-export-actions"><button type="button" class="primary-cta" data-save-now><span>Salvar agora</span><b>☁</b></button><button type="button" class="secondary-cta danger-cta" data-reset-editor><span>Sair da conta</span><b>×</b></button></div>
      </div>
        </div>
      </div>
    </section>

    <div class="bulk-quote-modal" data-bulk-quote-modal hidden>
      <button type="button" class="bulk-quote-backdrop" data-bulk-quote-close aria-label="Fechar cotização"></button>
      <section class="bulk-quote-dialog" role="dialog" aria-modal="true" aria-labelledby="bulk-quote-title">
        <header class="bulk-quote-header">
          <div><span class="section-eyebrow">Vault+ · ferramenta de coleção</span><h2 id="bulk-quote-title">Cotizar coleção</h2><p data-bulk-quote-subtitle>Atualize os preços das cartas selecionadas usando a MYP.</p></div>
          <button type="button" data-bulk-quote-close aria-label="Fechar">×</button>
        </header>

        <div class="bulk-quote-state bulk-quote-locked" data-bulk-quote-state="locked" hidden>
          <div class="bulk-quote-locked-icon">✦</div>
          <h3 data-bulk-quote-locked-title>Recurso Vault+</h3>
          <p data-bulk-quote-locked-copy>A cotização geral da coleção está disponível para assinantes Vault+.</p>
