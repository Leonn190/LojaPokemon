      const renderInventory = () => {
        if (!state) return;
        inventory.innerHTML = activeTab === 'cards' ? renderCards() : activeTab === 'boosters' ? renderBoosters() : activeTab === 'kits' ? renderKits() : activeTab === 'products' ? renderProducts() : renderAlbums();
