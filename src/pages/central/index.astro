---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { TCG_CONFIG } from '../../lib/tcg-metadata';

const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const tcgConfigJson = JSON.stringify(TCG_CONFIG).replace(/</g, '\\u003c');
---

<BaseLayout
  title="Meu Vault"
  description="Gerencie sua coleção, inventário, negociações, perfil e conta no Vault TCG."
  active="central"
  bodyClass="central-page"
>
  <script type="application/json" data-tcg-config set:html={tcgConfigJson}></script>

  <section class="shell collection-editor central-collection-editor" data-editor-root data-base={base}>
    <div class="central-auth-gate" data-editor-notice>
      <span class="central-auth-spinner" aria-hidden="true"></span>
      <div><strong>Carregando sua coleção</strong><small>Confirmando sua sessão e buscando os dados da sua conta…</small></div>
    </div>

    <section class="editor-workspace" data-editor-workspace hidden>
      <header class="editor-workspace-header vault-workspace-header">
        <div class="vault-workspace-title">
          <h2>Meu Vault</h2>
          <div class="vault-collection-identity"><span>Coleção ativa</span><strong data-workspace-title>Sua coleção</strong></div>
        </div>
        <div class="workspace-header-actions">
          <span class="workspace-save-state" data-cloud-save-state><i></i> Tudo salvo</span>
          <a class="secondary-cta vault-profile-link" data-open-public-profile href="#" target="_blank" rel="noreferrer"><span>Ver perfil</span><b>↗</b></a>
          <button type="button" class="secondary-cta" data-save-now><span>Salvar</span><b>✓</b></button>
        </div>
      </header>

      <nav class="editor-admin-tabs" aria-label="Seções do Meu Vault">
        <button type="button" class="active" data-admin-nav="overview"><span>⌂</span><strong>Visão geral</strong></button>
        <button type="button" data-admin-nav="inventory"><span>▦</span><strong>Inventário</strong></button>
        <button type="button" data-admin-nav="negotiations"><span>◇</span><strong>Negociações</strong></button>
        <button type="button" data-admin-nav="profile"><span>✦</span><strong>Perfil</strong></button>
        <button type="button" data-admin-nav="account"><span>⚙</span><strong>Conta</strong></button>
      </nav>

      <div class="editor-admin-layout">
        <div class="editor-admin-main">
          <section class="editor-dashboard vault-overview" id="editor-overview" data-admin-section="overview">
            <header class="editor-dashboard-heading vault-overview-heading">
              <div><h3>Visão geral</h3><p>Valor, tamanho da coleção e reputação da sua conta.</p></div>
              <a class="editor-public-preview-link" data-open-public-profile href="#" target="_blank" rel="noreferrer"><span>Ver perfil público</span><b>↗</b></a>
            </header>

            <div class="vault-overview-summary">
              <article class="vault-value-card">
                <div><small>Valor da coleção</small><strong data-dashboard-value>R$ 0,00</strong><em data-dashboard-value-note>somente itens com Preço definido</em></div>
                <details class="vault-valuation-details">
                  <summary>Ver cotação detalhada <b>⌄</b></summary>
                  <div class="editor-card-valuation" aria-label="Cotação das cartas pela MYP">
                    <header><div><h4>Cotação MYP das cartas</h4><small>Detalhes da cotação ponderados pela quantidade.</small></div><button type="button" class="secondary-cta compact" data-refresh-myp-quotes><span>Atualizar cotações</span><b>↻</b></button></header>
                    <div class="editor-card-valuation-grid">
                      <article><small>Mais barato certificado</small><strong data-dashboard-card-certified-low>R$ 0,00</strong></article>
                      <article><small>Mais barato geral</small><strong data-dashboard-card-general-low>R$ 0,00</strong></article>
                      <article><small>Média certificada</small><strong data-dashboard-card-certified-average>R$ 0,00</strong></article>
                      <article><small>Média geral</small><strong data-dashboard-card-general-average>R$ 0,00</strong></article>
                      <article><small>Mínimo</small><strong data-dashboard-card-minimum>R$ 0,00</strong><em>50% do mais barato certificado</em></article>
                    </div>
                    <p class="security-feedback" data-myp-refresh-feedback></p>
                  </div>
                </details>
              </article>

              <section class="vault-collection-stats" aria-label="Itens da coleção">
                <header><h4>Sua coleção</h4><button type="button" data-admin-jump="inventory">Abrir inventário →</button></header>
                <div class="editor-dashboard-metrics editor-dashboard-metrics-primary">
                  <article><span>◇</span><small>Cartas</small><strong data-dashboard-cards>0</strong></article>
                  <article><span>▱</span><small>Boosters</small><strong data-dashboard-boosters>0</strong></article>
                  <article><span>▣</span><small>Produtos</small><strong data-dashboard-products>0</strong></article>
                  <article><span>▦</span><small>Kits</small><strong data-dashboard-kits>0</strong></article>
                  <article><span>▤</span><small>Álbuns</small><strong data-dashboard-albums>0</strong></article>
                </div>
              </section>
            </div>

            <section class="account-score-section" aria-label="Scores da conta">
              <header class="account-score-heading">
                <div><h4>Reputação</h4><small>Segurança da conta e visibilidade da coleção.</small></div>
              </header>
              <div class="account-score-grid">
                <article class="account-score-card security-score-card">
                  <div class="score-card-copy">
                    <span class="score-card-icon">⌾</span>
                    <div><strong>Score de segurança</strong><small>Confiança e verificações da conta</small></div>
                  </div>
                  <div class="score-gauge" data-score-gauge="security">
                    <svg viewBox="0 0 240 132" role="img" aria-label="Score de segurança">
                      <path class="score-gauge-track" pathLength="100" d="M20 112 A100 100 0 0 1 220 112"></path>
                      <path class="score-gauge-value" pathLength="100" d="M20 112 A100 100 0 0 1 220 112" data-score-path="security"></path>
                    </svg>
                    <div class="score-gauge-number"><strong data-score-value="security">30</strong><span>/100</span></div>
                  </div>
                  <footer><span data-security-score-note>Gmail ainda não verificado</span><b data-security-score-delta>Base 30</b></footer>
                </article>

                <article class="account-score-card visibility-score-card">
                  <div class="score-card-copy">
                    <span class="score-card-icon">◉</span>
                    <div><strong>Score de visibilidade</strong><small>Potencial de descoberta da coleção</small></div>
                  </div>
                  <div class="score-gauge" data-score-gauge="visibility">
                    <svg viewBox="0 0 240 132" role="img" aria-label="Score de visibilidade">
                      <path class="score-gauge-track" pathLength="100" d="M20 112 A100 100 0 0 1 220 112"></path>
                      <path class="score-gauge-value" pathLength="100" d="M20 112 A100 100 0 0 1 220 112" data-score-path="visibility"></path>
                    </svg>
                    <div class="score-gauge-number"><strong data-score-value="visibility">30</strong><span>/100</span></div>
                  </div>
                  <footer><span>Descoberta da coleção</span><b>Base 30</b></footer>
                </article>
              </div>
            </section>
          </section>

      <section class="editor-profile-settings settings-profile-card vault-profile-basics" data-profile-settings id="editor-profile" data-admin-section="profile">
        <header class="settings-section-heading"><span>✎</span><div><strong>Perfil público</strong><small>As informações que identificam sua coleção para outros usuários.</small></div></header>
        <div class="profile-settings-body">
          <label class="form-field"><span>Nome da coleção</span><input data-profile-field="title" /></label>
        </div>
      </section>

      <section class="editor-profile-settings settings-profile-card vault-account-basics" id="editor-account" data-admin-section="account">
        <header class="settings-section-heading"><span>◎</span><div><strong>Dados da conta</strong><small>Informações pessoais e de contato usadas no Vault.</small></div></header>
        <div class="profile-settings-body">
          <label class="form-field"><span>Seu nome</span><input data-profile-field="owner" /></label>
          <label class="form-field"><span>Telefone para propostas</span><input data-profile-field="phone" placeholder="(00) 00000-0000" /></label>
          <label class="form-field"><span>Gmail / e-mail da conta</span><input type="email" data-profile-field="email" readonly aria-readonly="true" /></label>
        </div>
      </section>

      <section class="account-security-settings" data-admin-section="account" aria-label="Segurança da conta">
        <header class="settings-section-heading"><span>⌾</span><div><strong>Segurança da conta</strong><small>Verifique seu Gmail e mantenha sua senha atualizada.</small></div></header>
        <div class="account-security-grid">
          <article class="account-security-card email-verification-card" data-email-verification-card>
            <div class="account-security-card-top">
              <span class="account-security-icon">✉</span>
              <div><strong>Verificar Gmail</strong><small>Confirme que o endereço pertence a você e ganhe +5 no Score de segurança.</small></div>
              <em class="verification-status pending" data-email-verification-status>Não verificado</em>
            </div>
            <div class="email-verification-body">
              <div class="verification-email-display">
                <span>Gmail da conta</span>
                <strong data-security-email>—</strong>
              </div>
              <div class="account-security-actions">
                <button type="button" class="primary-cta compact" data-send-email-verification><span>Enviar verificação</span><b>→</b></button>
                <button type="button" class="secondary-cta compact" data-check-email-verification><span>Já verifiquei</span><b>✓</b></button>
              </div>
            </div>
            <p class="security-feedback" data-email-verification-feedback></p>
          </article>

          <article class="account-security-card password-change-card">
            <div class="account-security-card-top">
              <span class="account-security-icon">⌁</span>
              <div><strong>Alterar senha</strong><small>Confirme sua senha atual antes de criar uma nova.</small></div>
            </div>
            <form class="password-change-form" data-password-change-form>
              <label class="form-field"><span>Senha atual</span><input name="currentPassword" type="password" autocomplete="current-password" required /></label>
              <label class="form-field"><span>Nova senha</span><input name="newPassword" type="password" autocomplete="new-password" minlength="6" required /></label>
              <label class="form-field"><span>Confirmar nova senha</span><input name="confirmPassword" type="password" autocomplete="new-password" minlength="6" required /></label>
              <button type="submit" class="secondary-cta compact"><span>Atualizar senha</span><b>✓</b></button>
              <p class="security-feedback" data-password-change-feedback></p>
            </form>
          </article>
        </div>
      </section>

      <section class="editor-control-center vault-profile-controls" aria-label="Visibilidade da coleção" data-admin-section="profile">
        <label class="editor-setting-card">
          <span class="setting-icon">◎</span>
          <span><strong>Coleção pública</strong><small>Define se sua coleção pode ser encontrada e visitada por outras pessoas.</small></span>
          <span class="switch"><input type="checkbox" data-collection-public /><i></i></span>
        </label>
        <label class="editor-setting-card">
          <span class="setting-icon">◉</span>
          <span><strong>Mostrar valor total</strong><small>Exibe ou oculta o valor estimado no seu perfil público.</small></span>
          <span class="switch"><input type="checkbox" data-show-collection-value checked /><i></i></span>
        </label>
      </section>

      <section class="editor-control-center vault-negotiation-controls" aria-label="Disponibilidade para vendas" data-admin-section="negotiations">
        <label class="editor-setting-card">
          <span class="setting-icon">$</span>
          <span><strong>Liberar vendas</strong><small>Permite que itens marcados para venda sejam incluídos em propostas.</small></span>
          <span class="switch"><input type="checkbox" data-collection-selling checked /><i></i></span>
        </label>
      </section>

      <section class="collector-personalization" aria-label="Personalização da página do colecionador" id="editor-appearance" data-admin-section="profile">
        <header><div><h3>Aparência</h3><p>Foto, banner e cores do seu perfil público.</p></div><span class="personalization-note">Prévia ao vivo</span></header>
        <div class="collector-personalization-grid">
          <div class="profile-photo-editor">
            <div class="profile-photo-preview" data-profile-photo-preview><span>TC</span></div>
            <div><strong>Foto do colecionador</strong><small>Informe o caminho da sua foto, por exemplo imagens/perfis/leon.webp.</small><div class="profile-photo-actions"><label><input type="text" data-profile-photo-path placeholder="imagens/perfis/minha-foto.webp" /><span>Caminho da foto</span></label><button type="button" data-remove-profile-photo>Remover</button></div></div>
          </div>
          <div class="profile-banner-editor">
            <div><strong>Banner do perfil</strong><small>Opcional. Use uma imagem horizontal; sem banner, o tema gera um fundo elegante automaticamente.</small></div>
            <label><span>Caminho do banner</span><input type="text" data-profile-banner-path placeholder="imagens/perfis/meu-banner.webp" /></label>
          </div>
          <div class="palette-editor">
            <div class="palette-editor-copy"><strong>Paleta da coleção</strong><small>Principal define o glow e ações, Secundária domina o fundo e Destaque cria contraste. Tudo continua editável a qualquer momento.</small><div class="palette-live-preview" data-palette-preview aria-hidden="true"><i></i><span><b>VAULT</b><small>prévia do tema</small></span><em></em></div></div>
            <div class="palette-inputs">
              <label><span>Principal</span><input type="color" value="#54e8df" data-palette-color="0" /></label>
              <label><span>Secundária</span><input type="color" value="#bc91ff" data-palette-color="1" /></label>
              <label><span>Destaque</span><input type="color" value="#f4c25c" data-palette-color="2" /></label>
            </div>
          </div>
        </div>
        <section class="public-profile-live-preview" data-public-profile-preview aria-label="Prévia em tempo real do perfil público">
          <div class="live-preview-browser"><span></span><span></span><span></span><small>Prévia pública</small></div>
          <div class="live-preview-hero" data-live-preview-hero>
            <div class="live-preview-banner" data-live-preview-banner></div>
            <div class="live-preview-profile">
              <div class="live-preview-avatar" data-live-preview-avatar>VT</div>
              <div><small>Colecionador no Vault</small><h4 data-live-preview-title>Minha coleção</h4></div>
              <button type="button" tabindex="-1">Fazer proposta</button>
            </div>
            <div class="live-preview-stats"><span><strong data-live-preview-cards>0</strong> cartas</span><span><strong data-live-preview-albums>0</strong> álbuns</span><span data-live-preview-value-wrap><strong data-live-preview-value>R$ 0,00</strong> estimados</span></div>
          </div>
        </section>
      </section>

      <section class="workspace-proposal-settings" aria-label="Termos de propostas" id="editor-proposals" data-admin-section="negotiations">
        <header><div><h3>Negociações</h3><p>Propostas recebidas e regras comerciais da sua coleção.</p></div><span class="proposal-settings-badge">Pix após aceite</span></header>
        <div class="workspace-proposal-grid">
          <label><span>Regra principal</span><select data-proposal-policy><option value="flexible">Sou flexível quanto às regras</option><option value="none">Não aceito nenhuma proposta</option><option value="fixed_price_multi_only">Sem proposta para cartas precificadas e somente com mais de um produto</option><option value="no_defined_price">Sem proposta para cartas com preço definido</option><option value="multi_only">Propostas apenas com mais de um produto</option></select></label>
          <label><span>Preço exibido quando “Preço” estiver vazio</span><select data-price-display-fallback><option value="league_average_then_lowest">Média de mercado; se faltar, menor preço</option><option value="league_lowest_then_average">Menor preço; se faltar, média de mercado</option><option value="consult">Mostrar “Consultar”</option></select></label>
          <label class="proposal-flexible-check"><input type="checkbox" data-flexible-discounts /><span><strong>Descontos flexíveis</strong><small>Permite que o comprador sugira qualquer percentual.</small></span></label>
        </div>
        <div class="workspace-tier-heading"><div><strong>Marcos máximos de desconto</strong><small>O maior marco alcançado pelo valor da proposta define o limite.</small></div><button type="button" data-add-discount-tier><span>＋</span> Adicionar marco</button></div>
        <div class="workspace-tier-list" data-discount-tier-list></div>
        <section class="proposal-inbox-panel">
          <header><div><strong>Propostas recebidas</strong><small>Visão rápida das propostas enviadas para sua coleção.</small></div><span data-proposal-inbox-count>Carregando…</span></header>
          <div class="proposal-inbox-list" data-proposal-inbox><div class="proposal-inbox-loading">Buscando propostas…</div></div>
        </section>
      </section>

      <section class="editor-inventory-shell" data-inventory-section id="editor-inventory" data-admin-section="inventory">
        <header class="inventory-shell-header">
          <div><h3>Inventário</h3><p>Gerencie todos os itens da sua coleção.</p></div>
          <label class="inventory-search"><span>⌕</span><input type="search" placeholder="Buscar nesta aba..." data-inventory-search /></label>
        </header>

        <nav class="inventory-tabs" role="tablist" aria-label="Tipos de inventário">
          <button type="button" class="active" data-inventory-tab="cards"><span>Cartas</span><b data-tab-count="cards">0</b></button>
          <button type="button" data-inventory-tab="boosters"><span>Boosters</span><b data-tab-count="boosters">0</b></button>
          <button type="button" data-inventory-tab="kits"><span>Kits</span><b data-tab-count="kits">0</b></button>
          <button type="button" data-inventory-tab="products"><span>Produtos</span><b data-tab-count="products">0</b></button>
          <button type="button" data-inventory-tab="albums"><span>Álbuns</span><b data-tab-count="albums">0</b></button>
          <button type="button" class="inventory-add-current" data-add-current>
            <span>＋</span><strong data-add-current-label>Adicionar carta</strong>
          </button>
        </nav>

        <div class="inventory-metadata-filters" data-inventory-metadata-filters>
          <label><span>Era</span><select data-inventory-filter="era"><option value="">Todas</option>{Object.values(TCG_CONFIG.eras).map((era) => <option value={era.id}>{era.label}</option>)}</select></label>
          <label><span>Coleção</span><select data-inventory-filter="collectionId" disabled><option value="">Todas</option></select></label>
          <label><span>Grupo</span><select data-inventory-filter="group"><option value="">Todos</option>{TCG_CONFIG.groups.map((group) => <option value={group.id}>{group.label}</option>)}</select></label>
          <label><span>Classe</span><select data-inventory-filter="cardClass" disabled><option value="">Todas</option></select></label>
          <label><span>Tipo</span><select data-inventory-filter="type" disabled><option value="">Todos</option></select></label>
          <label><span>Idioma</span><select data-inventory-filter="language"><option value="">Todos</option>{TCG_CONFIG.languages.map((language) => <option value={language.id}>{language.label}</option>)}</select></label>
          <label><span>Estado</span><select data-inventory-filter="condition"><option value="">Todos</option>{Object.keys(TCG_CONFIG.conditions).map((condition) => <option value={condition}>{condition}</option>)}</select></label>
          <button type="button" data-clear-inventory-filters>Limpar filtros</button>
        </div>

        <div class="editor-inventory" data-editor-inventory></div>
      </section>

      <div class="editor-export-panel cloud-save-panel vault-account-actions" data-admin-section="account">
        <div><h3>Sessão e salvamento</h3><p>Suas alterações são salvas automaticamente na conta.</p></div>
        <div class="editor-export-actions"><button type="button" class="primary-cta" data-save-now><span>Salvar agora</span><b>☁</b></button><button type="button" class="secondary-cta danger-cta" data-reset-editor><span>Sair da conta</span><b>×</b></button></div>
      </div>
        </div>
      </div>
    </section>

    <div class="editor-modal" data-editor-modal="card" hidden>
      <button class="editor-modal-backdrop" type="button" data-close-modal aria-label="Fechar"></button>
      <section class="editor-modal-dialog editor-form-dialog tcg-item-dialog" role="dialog" aria-modal="true" aria-labelledby="card-modal-title">
        <header class="editor-modal-header"><div><span class="section-eyebrow" data-card-modal-eyebrow>Nova carta</span><h2 id="card-modal-title">Adicionar carta</h2><p>Identifique a impressão com metadados próprios. Coleção, classe, tipo e integridade são liberados conforme as escolhas anteriores.</p></div><button type="button" data-close-modal aria-label="Fechar">×</button></header>
        <form class="editor-item-form editor-modal-form" data-card-form data-edit-index="">
          <div class="modal-form-section myp-autofill-section">
            <header><strong>Preencher informações automaticamente</strong><small>Cole o link da carta na MYP. Nome, numeração, ano, Era, coleção, grupo, classe, tipo, imagem e cotação serão preenchidos pela API do Vault.</small></header>
            <div class="modal-form-grid">
              <label class="wide"><span>Link da MYP</span><input name="linkMyp" type="url" placeholder="https://mypcards.com/pokemon/produto/..." data-card-myp-link /></label>
              <div class="wide myp-autofill-actions"><button type="button" class="secondary-cta" data-card-myp-fill><span>Preencher pela MYP</span><b>↯</b></button><small data-card-myp-status>Você ainda poderá revisar qualquer campo antes de adicionar.</small></div>
            </div>
          </div>
          <div class="modal-form-section">
            <header><strong>Informações principais</strong><small>Preenchidas automaticamente pela MYP ou manualmente.</small></header>
            <div class="modal-form-grid">
              <label class="wide"><span>Nome da carta</span><input name="name" required placeholder="Ex.: Giratina V" /></label>
              <label><span>Numeração</span><input name="number" required maxlength="40" placeholder="Ex.: 251/198, GG65/GG70, SVP 001" /></label>
              <label><span>Ano</span><input name="year" type="number" min="1996" max="2100" required placeholder="2026" /></label>
            </div>
          </div>
          <div class="modal-form-section">
            <header><strong>Classificação</strong><small>A MYP preenche estes campos; você pode revisar antes de salvar.</small></header>
            <div class="modal-form-grid">
              <label><span>Era</span><select name="era" required data-card-era><option value="">Selecione a Era</option>{Object.values(TCG_CONFIG.eras).map((era) => <option value={era.id}>{era.label}</option>)}</select></label>
              <label><span>Grupo</span><select name="group" required data-card-group><option value="">Selecione o Grupo</option>{TCG_CONFIG.groups.map((group) => <option value={group.id}>{group.label}</option>)}</select></label>
              <label><span>Estado</span><select name="condition" required data-card-condition><option value="">Selecione o Estado</option><option value="NM">NM</option><option value="SP">SP</option><option value="MP">MP</option><option value="HP">HP</option><option value="D">D</option></select></label>
              <label data-card-field="collection" hidden><span>Coleção</span><select name="collectionId" required disabled data-card-collection></select><small data-card-collection-code></small></label>
              <label data-card-field="class" hidden><span>Classe</span><select name="cardClass" required disabled data-card-class></select></label>
              <label data-card-field="integrity" hidden><span>Integridade</span><div class="integrity-input-wrap"><input name="integrity" type="number" required disabled data-card-integrity /><b>%</b></div><small data-card-integrity-hint>Valor sugerido pelo Estado; ajuste se quiser informar com mais precisão.</small></label>
              <label data-card-field="type" hidden><span>Tipo</span><select name="type" required disabled data-card-type></select><small>Somente para Grupo Pokémon.</small></label>
              <label><span>Idioma</span><select name="language" required data-card-language><option value="">Selecione o Idioma</option>{TCG_CONFIG.languages.map((language) => <option value={language.id} selected={language.id === 'BR'}>{language.label}</option>)}</select></label>
            </div>
          </div>
          <div class="modal-form-section">
            <header><strong>Estoque e imagem</strong><small>Controles operacionais continuam independentes da classificação.</small></header>
            <div class="modal-form-grid">
              <label><span>Quantidade</span><input name="quantity" type="number" min="1" value="1" required /></label>
              <label><span>Preço final (opcional)</span><input name="price" type="number" min="0" step="0.01" placeholder="Ex.: 45.90" /></label>
              <label class="wide"><span>Imagem</span><input name="image" placeholder="URL ou caminho da imagem já disponível no projeto" data-card-image /><small>Registros antigos com formato legado continuam aceitos.</small></label>
            </div>
          </div>
          <p class="editor-form-feedback" data-card-form-feedback hidden></p>
          <label class="modal-sale-check"><input name="forSale" type="checkbox" checked /><span><strong>Disponível para venda</strong><small>Pode ser alterado individualmente no inventário.</small></span></label>
          <footer class="modal-form-actions"><button type="button" class="secondary-cta" data-close-modal><span>Cancelar</span><b>×</b></button><button type="submit" class="primary-cta"><span data-card-submit-label>Adicionar carta</span><b>＋</b></button></footer>
        </form>
      </section>
    </div>

    <div class="editor-modal card-advanced-modal" data-editor-modal="card-details" hidden>
      <button class="editor-modal-backdrop" type="button" data-close-modal aria-label="Fechar"></button>
      <section class="editor-modal-dialog card-advanced-dialog" role="dialog" aria-modal="true" aria-labelledby="card-details-title">
        <header class="editor-modal-header"><div><span class="section-eyebrow">Visão de ativo</span><h2 id="card-details-title" data-card-details-title>Análise do item</h2><p>Referências de mercado, liquidez, profundidade das ofertas e histórico de valorização/desvalorização.</p></div><button type="button" data-close-modal aria-label="Fechar">×</button></header>
        <div class="card-advanced-body">
          <aside class="card-advanced-summary">
            <div data-card-details-image></div>
            <div><span data-card-details-number></span><h3 data-card-details-name></h3><p data-card-details-meta></p></div>
            <div class="card-advanced-status" data-card-details-status></div>
          </aside>
          <main class="card-advanced-main">
            <div class="card-market-metrics" data-card-market-metrics></div>
            <section class="card-chart-panel">
              <header><div><strong>Histórico de preços</strong><small>Referências de mercado registradas em cada cotização.</small></div><span data-card-chart-period></span></header>
              <div class="card-price-chart" data-card-price-chart></div>
              <div class="card-chart-legend" data-card-chart-legend></div>
            </section>
            <section class="card-variation-panel"><header><strong>Valorização / desvalorização</strong><small>Comparação entre o primeiro e o último ponto disponível.</small></header><div data-card-variations></div></section>
            <section class="card-market-depth-panel"><header><div><strong>Mercado detalhado</strong><small>Profundidade e liquidez da cotização mais recente.</small></div></header><div data-card-market-depth></div></section>
            <details class="card-json-panel"><summary>Ver informações avançadas</summary><div class="card-json-blocks" data-card-json></div></details>
          </main>
        </div>
      </section>
    </div>

    <div class="editor-modal" data-editor-modal="booster" hidden>
      <button class="editor-modal-backdrop" type="button" data-close-modal aria-label="Fechar"></button>
      <section class="editor-modal-dialog editor-form-dialog tcg-item-dialog" role="dialog" aria-modal="true" aria-labelledby="booster-modal-title">
        <header class="editor-modal-header"><div><span class="section-eyebrow" data-booster-modal-eyebrow>Novo booster</span><h2 id="booster-modal-title">Adicionar booster</h2><p>Booster usa uma estrutura própria: nome, ano, Era, coleção, idioma e até cinco imagens.</p></div><button type="button" data-close-modal aria-label="Fechar">×</button></header>
        <form class="editor-item-form editor-modal-form" data-booster-form data-edit-index="">
          <div class="modal-form-section">
            <header><strong>Identificação</strong><small>Coleção é liberada depois da Era.</small></header>
            <div class="modal-form-grid">
              <label class="wide"><span>Nome do booster</span><input name="name" required placeholder="Ex.: Booster Caos Ascendente" /></label>
              <label><span>Ano</span><input name="year" type="number" min="1996" max="2100" required placeholder="2026" /></label>
              <label><span>Era</span><select name="era" required data-booster-era><option value="">Selecione a Era</option>{Object.values(TCG_CONFIG.eras).map((era) => <option value={era.id}>{era.label}</option>)}</select></label>
              <label data-booster-field="collection" hidden><span>Coleção</span><select name="collectionId" required disabled data-booster-collection></select><small data-booster-collection-code></small></label>
              <label><span>Idioma</span><select name="language" required><option value="">Selecione o Idioma</option>{TCG_CONFIG.languages.map((language) => <option value={language.id} selected={language.id === 'BR'}>{language.label}</option>)}</select></label>
              <label><span>Quantidade</span><input name="quantity" type="number" min="1" value="1" required /></label>
              <label><span>Preço final (opcional)</span><input name="price" type="number" min="0" step="0.01" placeholder="Ex.: 30.00" /></label>
            </div>
          </div>
          <div class="modal-form-section booster-images-section">
            <header><div><strong>Imagens do booster</strong><small>A primeira imagem é a capa. Máximo de 5.</small></div><button type="button" class="secondary-cta compact" data-add-booster-image><span>Adicionar imagem</span><b>＋</b></button></header>
            <div class="booster-image-editor" data-booster-image-editor></div>
            <small class="booster-image-counter" data-booster-image-counter>0/5 imagens</small>
          </div>
          <p class="editor-form-feedback" data-booster-form-feedback hidden></p>
          <label class="modal-sale-check"><input name="forSale" type="checkbox" checked /><span><strong>Disponível para venda</strong><small>Pode ser alterado individualmente no inventário.</small></span></label>
          <footer class="modal-form-actions"><button type="button" class="secondary-cta" data-close-modal><span>Cancelar</span><b>×</b></button><button type="submit" class="primary-cta"><span data-booster-submit-label>Adicionar booster</span><b>＋</b></button></footer>
        </form>
      </section>
    </div>

    <div class="editor-modal" data-editor-modal="product" hidden>
      <button class="editor-modal-backdrop" type="button" data-close-modal aria-label="Fechar"></button>
      <section class="editor-modal-dialog editor-form-dialog" role="dialog" aria-modal="true" aria-labelledby="product-modal-editor-title">
        <header class="editor-modal-header"><div><span class="section-eyebrow">Novo produto lacrado</span><h2 id="product-modal-editor-title">Adicionar produto</h2><p>Para produtos fechados, mantenha apenas as informações basilares padronizadas.</p></div><button type="button" data-close-modal aria-label="Fechar">×</button></header>
        <form class="editor-item-form editor-modal-form" data-product-form>
          <div class="modal-form-grid">
            <label class="wide"><span>Nome do produto</span><input name="name" required placeholder="Ex.: Elite Trainer Box" /></label>
            <label><span>Quantidade</span><input name="quantity" type="number" min="1" value="1" required /></label>
            <label><span>Preço (opcional)</span><input name="price" type="number" min="0" step="0.01" /></label>
            <label class="wide"><span>Imagem local (opcional)</span><input name="image" placeholder="imagens/produtos/meu-produto.webp" /><small>Use o caminho da imagem disponível no projeto.</small></label>
          </div>
          <label class="modal-sale-check"><input name="forSale" type="checkbox" checked /><span><strong>Disponível para venda</strong><small>Pode ser alterado depois no inventário.</small></span></label>
          <footer class="modal-form-actions"><button type="button" class="secondary-cta" data-close-modal><span>Cancelar</span><b>×</b></button><button type="submit" class="primary-cta"><span>Adicionar produto</span><b>＋</b></button></footer>
        </form>
      </section>
    </div>

    <div class="editor-modal editor-kit-modal" data-editor-modal="kit" hidden>
      <button class="editor-modal-backdrop" type="button" data-close-modal aria-label="Fechar"></button>
      <section class="editor-modal-dialog kit-builder-dialog" role="dialog" aria-modal="true" aria-labelledby="kit-modal-title">
        <header class="editor-modal-header"><div><span class="section-eyebrow">Construtor visual</span><h2 id="kit-modal-title">Monte o kit por drag and drop</h2><p>Arraste cartas e boosters para a área do kit, ajuste quantidades e defina o preço final.</p></div><button type="button" data-close-modal aria-label="Fechar">×</button></header>
        <div class="kit-builder-workspace">
          <section class="kit-product-library">
            <header><div><strong>Itens disponíveis</strong><small>Arraste ou clique para adicionar.</small></div><label><span>⌕</span><input type="search" placeholder="Buscar produto..." data-kit-search /></label></header>
            <div class="kit-library-filters"><button type="button" class="active" data-kit-filter="all">Todos</button><button type="button" data-kit-filter="cards">Cartas</button><button type="button" data-kit-filter="boosters">Boosters</button></div>
            <div class="kit-product-bank" data-kit-product-bank></div>
          </section>

          <form class="kit-composer" data-kit-form>
            <div class="kit-drop-zone" data-kit-drop-zone><span>↓</span><strong>Solte os itens do kit aqui</strong><small data-kit-drop-count>Nenhum produto selecionado</small></div>
            <div class="kit-selected-items" data-kit-selected-items></div>
            <div class="kit-form-fields">
              <label class="wide"><span>Nome do kit</span><input name="name" required placeholder="Ex.: Kit Evoluções Prismáticas" /></label>
              <label class="wide"><span>Descrição</span><textarea name="description" rows="3" required placeholder="Explique o conteúdo ou proposta do kit."></textarea></label>
              <label><span>Quantidade de kits</span><input name="quantity" type="number" min="1" value="1" required /></label>
              <label><span>Preço final do kit</span><input name="price" type="number" min="0" step="0.01" required data-kit-price /></label>
            </div>
            <div class="kit-price-summary"><div><span>Preço bruto</span><strong data-kit-gross>R$ 0,00</strong></div><div><span>Preço final</span><strong data-kit-final>R$ 0,00</strong></div><div class="discount"><span>Desconto</span><strong data-kit-discount>0%</strong></div></div>
            <label class="modal-sale-check"><input name="forSale" type="checkbox" checked /><span><strong>Kit disponível para venda</strong><small>O preço final será mostrado na coleção.</small></span></label>
            <footer class="modal-form-actions"><button type="button" class="secondary-cta" data-close-modal><span>Cancelar</span><b>×</b></button><button type="submit" class="primary-cta"><span>Salvar kit</span><b>＋</b></button></footer>
          </form>
        </div>
      </section>
    </div>

    <div class="editor-modal" data-editor-modal="album" hidden>
      <button class="editor-modal-backdrop" type="button" data-close-modal aria-label="Fechar"></button>
      <section class="editor-modal-dialog editor-form-dialog" role="dialog" aria-modal="true" aria-labelledby="album-modal-title">
        <header class="editor-modal-header"><div><span class="section-eyebrow">Novo álbum virtual</span><h2 id="album-modal-title">Escolha a organização</h2><p>O formato define quantas cartas cabem em cada página. Depois você posiciona livremente cada carta e pode criar quantas páginas precisar.</p></div><button type="button" data-close-modal aria-label="Fechar">×</button></header>
        <form class="editor-item-form editor-modal-form" data-album-form>
          <div class="modal-form-grid">
            <label><span>Nome do álbum</span><input name="name" required placeholder="Ex.: Master Set 151" /></label>
            <label><span>Formato das páginas</span><select name="format" required><option value="2x2">2 por 2</option><option value="3x2">3 por 2</option><option value="2x3">2 por 3</option><option value="3x3" selected>3 por 3</option><option value="4x3">4 por 3</option><option value="4x4">4 por 4</option><option value="5x5">5 por 5</option><option value="6x6">6 por 6</option></select></label>
            <label class="wide"><span>Descrição (opcional)</span><textarea name="description" rows="3" placeholder="Ex.: coleção completa em ordem numérica."></textarea></label>
            <label><span>Estilo da capa</span><select name="coverStyle"><option value="vault">Vault clássico</option><option value="leather">Couro</option><option value="holo">Holográfico</option><option value="minimal">Minimalista</option></select></label>
            <label><span>Cor da capa</span><input name="coverColor" type="color" value="#14253d" /></label>
            <label class="wide"><span>Imagem da capa (opcional)</span><input name="coverImage" placeholder="imagens/albuns/minha-capa.webp" /><small>Pode ser uma arte ou uma imagem de carta.</small></label>
            <label class="wide"><span>Título na capa</span><input name="coverTitle" placeholder="Usa o nome do álbum se ficar vazio" /></label>
          </div>
          <footer class="modal-form-actions"><button type="button" class="secondary-cta" data-close-modal><span>Cancelar</span><b>×</b></button><button type="submit" class="primary-cta"><span>Criar e organizar</span><b>→</b></button></footer>
        </form>
      </section>
    </div>

    <div class="editor-modal editor-album-organizer-modal" data-editor-modal="album-organizer" hidden>
      <button class="editor-modal-backdrop" type="button" data-close-modal aria-label="Fechar"></button>
      <section class="editor-modal-dialog album-organizer-dialog" role="dialog" aria-modal="true" aria-labelledby="album-organizer-title">
        <header class="editor-modal-header album-organizer-header"><div><span class="section-eyebrow">Organizador visual</span><h2 id="album-organizer-title" data-album-organizer-title>Álbum</h2><p>Arraste cartas entre slots, reorganize páginas pelas miniaturas e personalize a capa sem sair do editor.</p></div><button type="button" data-close-modal aria-label="Fechar">×</button></header>
        <div class="album-cover-editor-bar">
          <div class="album-cover-mini-preview" data-album-cover-mini><span>VAULT</span><strong data-album-cover-mini-title>Álbum</strong></div>
          <label><span>Estilo</span><select data-album-cover-edit="coverStyle"><option value="vault">Vault clássico</option><option value="leather">Couro</option><option value="holo">Holográfico</option><option value="minimal">Minimalista</option></select></label>
          <label><span>Formato</span><select data-album-layout-edit><option value="2x2">2 × 2</option><option value="3x2">3 × 2</option><option value="2x3">2 × 3</option><option value="3x3">3 × 3</option><option value="4x3">4 × 3</option><option value="4x4">4 × 4</option><option value="5x5">5 × 5</option><option value="6x6">6 × 6</option></select></label>
          <label><span>Cor</span><input type="color" data-album-cover-edit="coverColor" value="#14253d" /></label>
          <label class="wide"><span>Título da capa</span><input data-album-cover-edit="coverTitle" /></label>
          <label class="wide"><span>Imagem da capa</span><input data-album-cover-edit="coverImage" placeholder="imagens/albuns/capa.webp" /></label>
        </div>
        <div class="album-organizer-workspace">
          <aside class="album-card-library">
            <div class="album-library-heading"><div><span>Cartas disponíveis</span><strong data-album-library-count>0 cartas</strong></div><label><span>⌕</span><input type="search" placeholder="Buscar carta..." data-album-card-search /></label></div>
            <div class="album-card-library-list" data-album-card-library></div>
          </aside>
          <main class="album-page-editor">
            <div class="album-page-toolbar">
              <div><span data-album-format-label>Formato 3 por 3</span><strong data-album-progress-label>0 / 9 espaços</strong></div>
              <div class="album-page-navigation"><button type="button" data-album-page-previous aria-label="Página anterior">‹</button><span data-album-page-counter>Página 1 de 1</span><button type="button" data-album-page-next aria-label="Próxima página">›</button></div>
              <div><button type="button" class="album-toolbar-button" data-album-add-page><span>＋</span> Nova página</button><button type="button" class="album-toolbar-button danger" data-album-remove-page><span>−</span> Excluir página</button></div>
            </div>
            <div class="album-page-strip" data-album-page-strip aria-label="Páginas do álbum"></div>
            <div class="album-editor-stage">
              <div class="album-editor-page-wrap" data-album-editor-page-wrap>
                <div class="album-editor-page" data-album-editor-page></div>
                <div class="album-editor-rings" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
              </div>
            </div>
            <div class="album-editor-hint"><span>i</span><p>Clique em uma carta para selecioná-la. Arraste cartas ocupadas para trocar de posição. Use o × para remover uma carta do slot.</p></div>
          </main>
        </div>
        <footer class="album-organizer-footer"><div><span>Alterações salvas no editor</span><strong data-album-organizer-summary>0 cartas organizadas</strong></div><button type="button" class="primary-cta" data-close-modal><span>Concluir organização</span><b>✓</b></button></footer>
      </section>
    </div>
  </section>

  <script>
    import '../../scripts/central-vault.js';
  </script>

</BaseLayout>
