---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEditableCollections } from '../../lib/catalog';
import legacyClaims from '../../data/legacy-claim-verifiers.json';
import { TCG_CONFIG } from '../../lib/tcg-metadata';

const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const legacyCollections = getEditableCollections().map((collection) => ({ ...collection, profile: { ...collection.profile, email: '', phone: '', password: '' } }));
const legacyJson = JSON.stringify(legacyCollections).replace(/</g, '\\u003c');
const legacyClaimsJson = JSON.stringify(legacyClaims).replace(/</g, '\\u003c');
const tcgConfigJson = JSON.stringify(TCG_CONFIG).replace(/</g, '\\u003c');
---

<BaseLayout
  title="Central de Coleções"
  description="Gerencie sua coleção, inventário, propostas, histórico, aparência e configurações no Vault TCG."
  active="central"
  bodyClass="central-page"
>
  <script type="application/json" data-legacy-collections set:html={legacyJson}></script>
  <script type="application/json" data-legacy-claims set:html={legacyClaimsJson}></script>
  <script type="application/json" data-tcg-config set:html={tcgConfigJson}></script>

  <section class="shell collection-editor central-collection-editor" data-editor-root data-base={base}>
    <div class="central-auth-gate" data-editor-notice>
      <span class="central-auth-spinner" aria-hidden="true"></span>
      <div><strong>Carregando sua coleção</strong><small>Confirmando sua sessão e buscando os dados da sua conta…</small></div>
    </div>

    <section class="editor-workspace" data-editor-workspace hidden>
      <header class="editor-workspace-header">
        <div>
          <span class="section-eyebrow">Editor da coleção</span>
          <h2 data-workspace-title>Sua coleção</h2>
        </div>
        <div class="workspace-header-actions">
          <span class="workspace-save-state" data-cloud-save-state><i></i> Tudo salvo</span>
          <button type="button" class="secondary-cta" data-save-now><span>Salvar agora</span><b>✓</b></button>
          <button type="button" class="secondary-cta" data-reset-editor><span>Sair da conta</span><b>×</b></button>
        </div>
      </header>

      <nav class="editor-admin-tabs" aria-label="Seções da Central de Coleções">
        <button type="button" class="active" data-admin-nav="overview"><span>⌂</span><strong>Visão geral</strong></button>
        <button type="button" data-admin-nav="appearance"><span>✦</span><strong>Aparência</strong></button>
        <button type="button" data-admin-nav="inventory"><span>▦</span><strong>Inventário</strong></button>
        <button type="button" data-admin-nav="proposals"><span>◇</span><strong>Propostas</strong></button>
        <button type="button" data-admin-nav="history"><span>↕</span><strong>Histórico</strong></button>
        <button type="button" data-admin-nav="settings"><span>⚙</span><strong>Configurações</strong></button>
      </nav>

      <div class="editor-admin-layout">
        <div class="editor-admin-main">
          <section class="editor-dashboard" id="editor-overview" data-admin-section="overview">
            <header class="editor-dashboard-heading">
              <div><span class="section-eyebrow">Visão geral</span><h3>Painel da coleção</h3><p>O que importa agora: tamanho, valor e os scores da sua conta no Vault TCG.</p></div>
              <a class="editor-public-preview-link" data-open-public-profile href="#" target="_blank" rel="noreferrer"><span>Ver perfil público</span><b>↗</b></a>
            </header>
            <div class="editor-dashboard-metrics editor-dashboard-metrics-primary">
              <article class="metric-wide"><span>R$</span><small>Valor cotado</small><strong data-dashboard-value>R$ 0,00</strong><em data-dashboard-value-note>somente itens com Preço definido</em></article>
              <article><span>◇</span><small>Cartas</small><strong data-dashboard-cards>0</strong><em>unidades na coleção</em></article>
              <article><span>▱</span><small>Boosters</small><strong data-dashboard-boosters>0</strong><em>unidades na coleção</em></article>
              <article><span>▣</span><small>Produtos</small><strong data-dashboard-products>0</strong><em>unidades na coleção</em></article>
              <article><span>▤</span><small>Álbuns</small><strong data-dashboard-albums>0</strong><em>álbuns criados</em></article>
              <article><span>▦</span><small>Kits</small><strong data-dashboard-kits>0</strong><em>unidades na coleção</em></article>
            </div>
            <section class="editor-card-valuation" aria-label="Cotação das cartas pela MYP">
              <header><div><span class="section-eyebrow">Somente cartas</span><h4>Cotação MYP da coleção</h4><small>Totais ponderados pela quantidade. As cartas antigas passam a usar a MYP quando forem recotizadas.</small></div><button type="button" class="secondary-cta compact" data-refresh-myp-quotes><span>Atualizar cotações MYP</span><b>↻</b></button></header>
              <div class="editor-card-valuation-grid">
                <article><small>Mais barato certificado</small><strong data-dashboard-card-certified-low>R$ 0,00</strong></article>
                <article><small>Mais barato geral</small><strong data-dashboard-card-general-low>R$ 0,00</strong></article>
                <article><small>Média certificada</small><strong data-dashboard-card-certified-average>R$ 0,00</strong></article>
                <article><small>Média geral</small><strong data-dashboard-card-general-average>R$ 0,00</strong></article>
                <article><small>Mínimo</small><strong data-dashboard-card-minimum>R$ 0,00</strong><em>50% do mais barato certificado</em></article>
              </div>
              <p class="security-feedback" data-myp-refresh-feedback></p>
            </section>
            <section class="account-score-section" aria-label="Scores da conta">
              <header class="account-score-heading">
                <div><span class="section-eyebrow">Reputação da conta</span><h4>Seus scores</h4></div>
                <small>Os dois scores começam em 30. Novas regras poderão aumentar ou reduzir esses valores futuramente.</small>
              </header>
              <div class="account-score-grid">
                <article class="account-score-card security-score-card">
                  <div class="score-card-copy">
                    <span class="score-card-icon">⌾</span>
                    <div><strong>Score de segurança</strong><small>Confiança e verificações da conta</small></div>
                  </div>
                  <div class="score-gauge" data-score-gauge="security">
                    <svg viewBox="0 0 240 132" role="img" aria-label="Score de segurança">
                      <path class="score-gauge-track" pathLength="100" d="M20 112 A100 100 0 0 1 220 112"></path>
                      <path class="score-gauge-value" pathLength="100" d="M20 112 A100 100 0 0 1 220 112" data-score-path="security"></path>
                    </svg>
                    <div class="score-gauge-number"><strong data-score-value="security">30</strong><span>/100</span></div>
                  </div>
                  <footer><span data-security-score-note>Gmail ainda não verificado</span><b data-security-score-delta>Base 30</b></footer>
                </article>

                <article class="account-score-card visibility-score-card">
                  <div class="score-card-copy">
                    <span class="score-card-icon">◉</span>
                    <div><strong>Score de visibilidade</strong><small>Potencial de descoberta da coleção</small></div>
                  </div>
                  <div class="score-gauge" data-score-gauge="visibility">
                    <svg viewBox="0 0 240 132" role="img" aria-label="Score de visibilidade">
                      <path class="score-gauge-track" pathLength="100" d="M20 112 A100 100 0 0 1 220 112"></path>
                      <path class="score-gauge-value" pathLength="100" d="M20 112 A100 100 0 0 1 220 112" data-score-path="visibility"></path>
                    </svg>
                    <div class="score-gauge-number"><strong data-score-value="visibility">30</strong><span>/100</span></div>
                  </div>
                  <footer><span>Mecânica preparada</span><b>Base 30</b></footer>
                </article>
              </div>
            </section>
          </section>

      {legacyCollections.length > 0 && (
        <details class="editor-legacy-migration" data-legacy-migration data-admin-section="settings">
          <summary><span>↥</span><div><strong>Migrar uma coleção antiga</strong><small>Uso único: transfere os dados da versão anterior para esta conta.</small></div><b>+</b></summary>
          <div class="legacy-migration-body">
            <label class="form-field"><span>Coleção antiga</span><select data-legacy-select><option value="">Selecione…</option>{legacyCollections.map((collection) => <option value={collection.profile.collectionId || collection.slug}>{collection.profile.title} · {collection.profile.owner}</option>)}</select></label>
            <label class="form-field"><span>Senha antiga dessa coleção</span><input type="password" autocomplete="off" data-legacy-password placeholder="A senha usada no sistema antigo" /><small>Sua senha antiga é usada apenas para confirmar a migração.</small></label>
            <button type="button" class="secondary-cta" data-legacy-import><span>Migrar dados para esta conta</span><b>↥</b></button>
            <p class="import-feedback" data-legacy-feedback></p>
          </div>
        </details>
      )}

      <section class="editor-profile-settings settings-profile-card" data-profile-settings id="editor-settings" data-admin-section="settings">
        <header class="settings-section-heading"><span>✎</span><div><strong>Dados da conta e coleção</strong><small>Nome, telefone, Gmail/e-mail e informações públicas da sua coleção.</small></div></header>
        <div class="legacy-migration-body profile-settings-body">
          <label class="form-field"><span>Seu nome</span><input data-profile-field="owner" /></label>
          <label class="form-field"><span>Nome da coleção</span><input data-profile-field="title" /></label>
          <label class="form-field"><span>Telefone para propostas</span><input data-profile-field="phone" placeholder="(00) 00000-0000" /></label>
          <label class="form-field"><span>Gmail / e-mail da conta</span><input type="email" data-profile-field="email" readonly aria-readonly="true" /></label>
          <label class="form-field profile-description-field"><span>Descrição</span><textarea rows="3" data-profile-field="description"></textarea></label>
        </div>
      </section>

      <section class="account-security-settings" data-admin-section="settings" aria-label="Segurança da conta">
        <header class="settings-section-heading"><span>⌾</span><div><strong>Segurança da conta</strong><small>Verifique seu Gmail e mantenha sua senha atualizada.</small></div></header>
        <div class="account-security-grid">
          <article class="account-security-card email-verification-card" data-email-verification-card>
            <div class="account-security-card-top">
              <span class="account-security-icon">✉</span>
              <div><strong>Verificar Gmail</strong><small>Confirme que o endereço pertence a você e ganhe +5 no Score de segurança.</small></div>
              <em class="verification-status pending" data-email-verification-status>Não verificado</em>
            </div>
            <div class="verification-email-display">
              <span>Gmail da conta</span>
              <strong data-security-email>—</strong>
            </div>
            <div class="verification-benefit">
              <span>+5</span>
              <div><strong>Score de segurança</strong><small>O bônus é concedido uma única vez.</small></div>
            </div>
            <div class="account-security-actions">
              <button type="button" class="primary-cta compact" data-send-email-verification><span>Enviar verificação</span><b>→</b></button>
              <button type="button" class="secondary-cta compact" data-check-email-verification><span>Já verifiquei</span><b>✓</b></button>
            </div>
            <p class="security-feedback" data-email-verification-feedback></p>
          </article>

          <article class="account-security-card password-change-card">
            <div class="account-security-card-top">
              <span class="account-security-icon">⌁</span>
              <div><strong>Alterar senha</strong><small>Confirme sua senha atual antes de criar uma nova.</small></div>
            </div>
            <form class="password-change-form" data-password-change-form>
              <label class="form-field"><span>Senha atual</span><input name="currentPassword" type="password" autocomplete="current-password" required /></label>
              <label class="form-field"><span>Nova senha</span><input name="newPassword" type="password" autocomplete="new-password" minlength="6" required /></label>
              <label class="form-field"><span>Confirmar nova senha</span><input name="confirmPassword" type="password" autocomplete="new-password" minlength="6" required /></label>
              <button type="submit" class="secondary-cta compact"><span>Atualizar senha</span><b>✓</b></button>
              <p class="security-feedback" data-password-change-feedback></p>
            </form>
          </article>
        </div>
      </section>

      <section class="editor-control-center" aria-label="Configurações gerais da coleção" data-admin-section="settings">
        <label class="editor-setting-card">
          <span class="setting-icon">◎</span>
          <span><strong>Coleção pública</strong><small>Quando desligado, sua conta continua ativa, mas a coleção não aparece para outras pessoas.</small></span>
          <span class="switch"><input type="checkbox" data-collection-public /><i></i></span>
        </label>
        <label class="editor-setting-card">
          <span class="setting-icon">$</span>
          <span><strong>Liberar vendas</strong><small>Permite que itens marcados sejam incluídos em propostas.</small></span>
          <span class="switch"><input type="checkbox" data-collection-selling checked /><i></i></span>
        </label>
        <label class="editor-setting-card">
          <span class="setting-icon">◉</span>
          <span><strong>Mostrar valor total publicamente</strong><small>Desligue para ocultar completamente o valor estimado no perfil público.</small></span>
          <span class="switch"><input type="checkbox" data-show-collection-value checked /><i></i></span>
        </label>
        <div class="editor-overview-card">
          <span class="setting-icon">Σ</span>
          <span><strong data-overview-units>0 unidades</strong><small data-overview-value>R$ 0,00 em preços definidos</small></span>
        </div>
      </section>

      <section class="collector-personalization" aria-label="Personalização da página do colecionador" id="editor-appearance" data-admin-section="appearance">
        <header><div><span class="section-eyebrow">Identidade visual</span><h3>Personalize sua página</h3><p>As três cores controlam gradientes, glow, partículas, botões e a iluminação da coleção. As cartas favoritadas aparecem no fundo; se houver menos de 10, o Vault completa com as cartas mais valiosas.</p></div><span class="personalization-note">Tema vivo + favoritos</span></header>
        <div class="collector-personalization-grid">
          <div class="profile-photo-editor">
            <div class="profile-photo-preview" data-profile-photo-preview><span>TC</span></div>
            <div><strong>Foto do colecionador</strong><small>Informe o caminho da sua foto, por exemplo imagens/perfis/leon.webp.</small><div class="profile-photo-actions"><label><input type="text" data-profile-photo-path placeholder="imagens/perfis/minha-foto.webp" /><span>Caminho da foto</span></label><button type="button" data-remove-profile-photo>Remover</button></div></div>
          </div>
          <div class="profile-banner-editor">
            <div><strong>Banner do perfil</strong><small>Opcional. Use uma imagem horizontal; sem banner, o tema gera um fundo elegante automaticamente.</small></div>
            <label><span>Caminho do banner</span><input type="text" data-profile-banner-path placeholder="imagens/perfis/meu-banner.webp" /></label>
          </div>
          <div class="palette-editor">
            <div class="palette-editor-copy"><strong>Paleta da coleção</strong><small>Principal define o glow e ações, Secundária domina o fundo e Destaque cria contraste. Tudo continua editável a qualquer momento.</small><div class="palette-live-preview" data-palette-preview aria-hidden="true"><i></i><span><b>VAULT</b><small>prévia do tema</small></span><em></em></div></div>
            <div class="palette-inputs">
              <label><span>Principal</span><input type="color" value="#54e8df" data-palette-color="0" /></label>
              <label><span>Secundária</span><input type="color" value="#bc91ff" data-palette-color="1" /></label>
              <label><span>Destaque</span><input type="color" value="#f4c25c" data-palette-color="2" /></label>
            </div>
          </div>
        </div>
        <section class="public-profile-live-preview" data-public-profile-preview aria-label="Prévia em tempo real do perfil público">
          <div class="live-preview-browser"><span></span><span></span><span></span><small>Prévia pública</small></div>
          <div class="live-preview-hero" data-live-preview-hero>
            <div class="live-preview-banner" data-live-preview-banner></div>
            <div class="live-preview-profile">
              <div class="live-preview-avatar" data-live-preview-avatar>VT</div>
              <div><small>Colecionador no Vault</small><h4 data-live-preview-title>Minha coleção</h4><p data-live-preview-description>Descrição da coleção</p></div>
              <button type="button" tabindex="-1">Fazer proposta</button>
            </div>
            <div class="live-preview-stats"><span><strong data-live-preview-cards>0</strong> cartas</span><span><strong data-live-preview-albums>0</strong> álbuns</span><span data-live-preview-value-wrap><strong data-live-preview-value>R$ 0,00</strong> estimados</span></div>
          </div>
        </section>
      </section>

      <section class="workspace-proposal-settings" aria-label="Termos de propostas" id="editor-proposals" data-admin-section="proposals">
        <header><div><span class="section-eyebrow">Negociação</span><h3>Termos de propostas da coleção</h3><p>Essas regras são exibidas publicamente e usadas pelo site para bloquear propostas incompatíveis.</p></div><span class="proposal-settings-badge">Pix após aceite</span></header>
        <div class="workspace-proposal-grid">
          <label><span>Regra principal</span><select data-proposal-policy><option value="flexible">Sou flexível quanto às regras</option><option value="none">Não aceito nenhuma proposta</option><option value="fixed_price_multi_only">Sem proposta para cartas precificadas e somente com mais de um produto</option><option value="no_defined_price">Sem proposta para cartas com preço definido</option><option value="multi_only">Propostas apenas com mais de um produto</option></select></label>
          <label><span>Preço exibido quando “Preço” estiver vazio</span><select data-price-display-fallback><option value="league_average_then_lowest">Média de mercado; se faltar, menor preço</option><option value="league_lowest_then_average">Menor preço; se faltar, média de mercado</option><option value="consult">Mostrar “Consultar”</option></select></label>
          <label class="proposal-flexible-check"><input type="checkbox" data-flexible-discounts /><span><strong>Descontos flexíveis</strong><small>Permite que o comprador sugira qualquer percentual.</small></span></label>
        </div>
        <div class="workspace-tier-heading"><div><strong>Marcos máximos de desconto</strong><small>O maior marco alcançado pelo valor da proposta define o limite.</small></div><button type="button" data-add-discount-tier><span>＋</span> Adicionar marco</button></div>
        <div class="workspace-tier-list" data-discount-tier-list></div>
        <section class="proposal-inbox-panel">
          <header><div><strong>Propostas recebidas</strong><small>Visão rápida das propostas enviadas para sua coleção.</small></div><span data-proposal-inbox-count>Carregando…</span></header>
          <div class="proposal-inbox-list" data-proposal-inbox><div class="proposal-inbox-loading">Buscando propostas…</div></div>
        </section>
      </section>

      <section class="editor-command-section editor-command-section-compact" aria-label="Adicionar itens à coleção" data-admin-section="inventory">
        <div class="editor-command-grid">
          <button type="button" class="editor-command-card" data-open-modal="card"><span>◇</span><strong>Adicionar carta</strong><small>Cadastre com metadados próprios, sem depender da Liga.</small><b>＋</b></button>
          <button type="button" class="editor-command-card" data-open-modal="booster"><span>▱</span><strong>Adicionar booster</strong><small>Inclua pacotes lacrados no estoque.</small><b>＋</b></button>
          <button type="button" class="editor-command-card is-kit" data-open-modal="kit"><span>▦</span><strong>Adicionar kit</strong><small>Monte visualmente com drag and drop.</small><b>＋</b></button>
          <button type="button" class="editor-command-card is-product" data-open-modal="product"><span>▣</span><strong>Adicionar produto</strong><small>Cadastre um produto Pokémon fechado.</small><b>＋</b></button>
          <button type="button" class="editor-command-card is-album" data-open-modal="album"><span>▤</span><strong>Adicionar álbum</strong><small>Escolha o formato e organize carta por carta.</small><b>＋</b></button>
        </div>
      </section>

      <section class="editor-inventory-shell" data-inventory-section id="editor-inventory" data-admin-section="inventory">
        <header class="inventory-shell-header">
          <div><span class="section-eyebrow">Inventário</span><h3>Todos os itens da coleção</h3><p>Uma visão de planilha, com espaço suficiente para imagens, preços e ações.</p></div>
          <label class="inventory-search"><span>⌕</span><input type="search" placeholder="Buscar nesta aba..." data-inventory-search /></label>
        </header>

        <nav class="inventory-tabs" role="tablist" aria-label="Tipos de inventário">
          <button type="button" class="active" data-inventory-tab="cards"><span>Cartas</span><b data-tab-count="cards">0</b></button>
          <button type="button" data-inventory-tab="boosters"><span>Boosters</span><b data-tab-count="boosters">0</b></button>
          <button type="button" data-inventory-tab="kits"><span>Kits</span><b data-tab-count="kits">0</b></button>
          <button type="button" data-inventory-tab="products"><span>Produtos</span><b data-tab-count="products">0</b></button>
          <button type="button" data-inventory-tab="albums"><span>Álbuns</span><b data-tab-count="albums">0</b></button>
        </nav>

        <div class="inventory-metadata-filters" data-inventory-metadata-filters>
          <label><span>Era</span><select data-inventory-filter="era"><option value="">Todas</option>{Object.values(TCG_CONFIG.eras).map((era) => <option value={era.id}>{era.label}</option>)}</select></label>
          <label><span>Coleção</span><select data-inventory-filter="collectionId" disabled><option value="">Todas</option></select></label>
          <label><span>Grupo</span><select data-inventory-filter="group"><option value="">Todos</option>{TCG_CONFIG.groups.map((group) => <option value={group.id}>{group.label}</option>)}</select></label>
          <label><span>Classe</span><select data-inventory-filter="cardClass" disabled><option value="">Todas</option></select></label>
          <label><span>Tipo</span><select data-inventory-filter="type" disabled><option value="">Todos</option></select></label>
          <label><span>Idioma</span><select data-inventory-filter="language"><option value="">Todos</option>{TCG_CONFIG.languages.map((language) => <option value={language.id}>{language.label}</option>)}</select></label>
          <label><span>Estado</span><select data-inventory-filter="condition"><option value="">Todos</option>{Object.keys(TCG_CONFIG.conditions).map((condition) => <option value={condition}>{condition}</option>)}</select></label>
          <label><span>Integridade</span><div class="inventory-integrity-filter"><input type="number" min="1" max="100" step="1" placeholder="1–100" data-inventory-filter="integrity" /><b>%</b></div></label>
          <button type="button" data-clear-inventory-filters>Limpar filtros</button>
        </div>

        <div class="editor-inventory" data-editor-inventory></div>
      </section>

      <section class="collection-movement-log" aria-label="Linha do tempo da coleção" id="editor-history" data-admin-section="history">
        <header><div><span class="section-eyebrow">Histórico da coleção</span><h3>Entradas e vendas</h3><p>Acompanhe quando cartas e outros itens foram adicionados, vendidos, removidos ou tiveram a quantidade ajustada.</p></div><span class="movement-log-count" data-movement-log-count>0 eventos</span></header>
        <nav class="movement-filter-tabs" aria-label="Filtrar histórico">
          <button type="button" class="active" data-movement-filter="all">Tudo</button>
          <button type="button" data-movement-filter="cards">Cartas</button>
          <button type="button" data-movement-filter="sales">Vendas</button>
        </nav>
        <div data-collection-movements></div>
      </section>

      <section class="editor-sales-panel" id="editor-sales" data-admin-section="history">
