      const importBoosterRow = (row) => ({
        id: row['Id'] || row['ID'] || '', name: row['Tipo de pacote'] || row['Coleção'] || row['Nome'], quantity: row['Quantidade'], certainMinimumPrice: row['Minimo Certeiro'] ?? row['Mínimo Certeiro'], minimumPrice: row['Minimo'] ?? row['Preço mínimo'], quickSalePrice: row['Venda Rapida'] ?? row['Venda rápida'], leaguePrice: row['Menor Liga'] ?? row['Preço Liga mais barato'], averageLeaguePrice: row['Media Liga'] ?? row['Preço médio Liga'] ?? row['Preço Médio Liga'], price: row['Preço'],
        forSale: typeof row['À venda'] === 'boolean' ? row['À venda'] : row['À venda'] !== 'Não', linkLiga: row['Link Liga'], image: importedImage(row['Imagem']), imageCandidates: importedImage(row['Imagem']) ? [importedImage(row['Imagem'])] : [],
      });
      const importKitRow = (row) => {
        let contentItems = Array.isArray(row['Conteúdo']) ? row['Conteúdo'] : [];
        if (!contentItems.length && row['Conteúdo JSON']) contentItems = parseJsonArray(row['Conteúdo JSON']);
        const contents = typeof row['Conteúdo'] === 'string' ? row['Conteúdo'] : contentItems.map((entry) => `${toQuantity(entry.quantity)}x ${entry.name || entry.nome || 'Item'}`).join(' | ');
        return { id: row['Id'] || row['ID'] || '', name: row['Nome'], description: row['Descrição'], contents, contentItems, quantity: row['Quantidade'], price: row['Preço'], sourceTotal: row['Valor avulso'] ?? row['Preço bruto'], forSale: typeof row['À venda'] === 'boolean' ? row['À venda'] : row['À venda'] !== 'Não', image: importedImage(row['Imagem']), imageCandidates: importedImage(row['Imagem']) ? [importedImage(row['Imagem'])] : [] };
      };
      const importAlbumRow = (row) => ({
        albumId: row['Id'] || row['ID'] || '', id: row['Id'] || row['ID'] || '', name: row['Nome'], description: row['Descrição'], format: row['Formato'] || '3x3',
        pages: Array.isArray(row['Páginas']) ? row['Páginas'] : parseJsonArray(row['Páginas JSON'] || row['Paginas JSON']), imageCandidates: importedImage(row['Imagem']) ? [importedImage(row['Imagem'])] : [],
      });
      const importZip = async (file) => {
        const feedback = root.querySelector('[data-import-feedback]');
        try {
          const files = unzipStore(await file.arrayBuffer());
          const profile = JSON.parse(files['perfil.json'] || '{}');
          if (!profile.owner || !profile.title || !profile.email || !profile.password) throw new Error('O ZIP não contém um perfil válido.');
          const cards = inventoryRowsFromZip(files, 'inventario-cartas.json', 'inventario-cartas.csv').map(importCardRow);
          const boosters = inventoryRowsFromZip(files, 'inventario-boosters.json', 'inventario-boosters.csv').map(importBoosterRow);
          const kits = inventoryRowsFromZip(files, 'inventario-kits.json', 'inventario-kits.csv').map(importKitRow);
          const albums = inventoryRowsFromZip(files, 'inventario-albuns.json', 'inventario-albuns.csv').map(importAlbumRow);
          feedback.textContent = '';
          activate({ ...profile, version: Number(profile.version || 0) + 1 }, { cards, boosters, kits, albums }, 'import');
        } catch (error) { feedback.textContent = error.message || 'Não foi possível abrir este ZIP.'; }
      };

      root.querySelector('[data-zip-input]')?.addEventListener('change', (event) => { const file = event.target.files?.[0]; if (file) importZip(file); });
      const drop = root.querySelector('[data-zip-drop]');
      ['dragenter', 'dragover'].forEach((type) => drop?.addEventListener(type, (event) => { event.preventDefault(); drop.classList.add('dragging'); }));
      ['dragleave', 'drop'].forEach((type) => drop?.addEventListener(type, (event) => { event.preventDefault(); drop.classList.remove('dragging'); }));
      drop?.addEventListener('drop', (event) => { const file = event.dataTransfer?.files?.[0]; if (file) importZip(file); });

      const downloadZip = (zip, filename) => { const link = document.createElement('a'); link.href = URL.createObjectURL(new Blob([zip], { type: 'application/zip' })); link.download = filename; link.click(); setTimeout(() => URL.revokeObjectURL(link.href), 0); };
      root.querySelector('[data-download-zip]')?.addEventListener('click', () => {
        if (!state) return;
        state.profile.version = Number(state.profile.version || 1);
        const cards = state.cards.map((item) => cardJson(item));
        const boosters = state.boosters.map((item) => boosterJson(item));
        const kits = state.kits.map((item) => kitJson(item));
        const albums = state.albums.map((item) => albumJson(item));
        const profile = { ...state.profile, generatedAt: new Date().toISOString(), collectionId: state.profile.collectionId || safeSlug(state.profile.title) };
        const zip = zipStore([
          ['perfil.json', JSON.stringify(profile, null, 2)],
          ['inventario-cartas.json', JSON.stringify(cards, null, 2)],
          ['inventario-boosters.json', JSON.stringify(boosters, null, 2)],
          ['inventario-kits.json', JSON.stringify(kits, null, 2)],
          ['inventario-albuns.json', JSON.stringify(albums, null, 2)],
        ]);
        const suffix = state.source === 'new' ? `nao-formatada-v${state.profile.version}` : `v${state.profile.version}`;
        downloadZip(zip, `${safeSlug(profile.collectionId)}-${suffix}.zip`);
      });
      updateButton?.addEventListener('click', () => {
        if (!state) return;
        const cards = state.cards.filter((item) => item._isNew || item._isDirty).map((item) => item._isNew ? cardJson(item, true) : cardJson(item, false, 'patch'));
        const boosters = state.boosters.filter((item) => item._isNew || item._isDirty).map((item) => item._isNew ? boosterJson(item, true) : boosterJson(item, false, 'patch'));
        const kits = state.kits.filter((item) => item._isNew || item._isDirty).map((item) => kitJson(item, 'upsert'));
        const albums = state.albums.filter((item) => item._isNew || item._isDirty).map(albumJson);
        const generatedAt = new Date().toISOString();
        const collectionId = state.profile.collectionId || safeSlug(state.profile.title);
        const metadata = { type: 'collection-update', format: 'json-v2', collectionId, baseVersion: Math.max(1, Number(state.profile.version || 1) - 1), version: Number(state.profile.version || 1), generatedAt, updateId: `${collectionId}-${Number(state.profile.version || 1)}-${Date.now()}`, includesProfile: true };
        const profile = { ...state.profile, collectionId, generatedAt };
        const zip = zipStore([
          ['atualizacao.json', JSON.stringify(metadata, null, 2)],
          ['perfil.json', JSON.stringify(profile, null, 2)],
          ['inventario-cartas.json', JSON.stringify(cards, null, 2)],
          ['inventario-boosters.json', JSON.stringify(boosters, null, 2)],
          ['inventario-kits.json', JSON.stringify(kits, null, 2)],
          ['inventario-albuns.json', JSON.stringify(albums, null, 2)],
        ]);
        downloadZip(zip, `${safeSlug(collectionId)}-update-v${metadata.version}.zip`);
      });

    })();
  </script>
</BaseLayout>
