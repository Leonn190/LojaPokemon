  <script is:inline>
    (() => {
      const root = document.querySelector('[data-editor-root]');
      if (!root) return;

      let legacyCollections = [];
      let legacyClaims = [];
      try { legacyCollections = JSON.parse(document.querySelector('[data-legacy-collections]')?.textContent || '[]'); } catch (_) {}
      try { legacyClaims = JSON.parse(document.querySelector('[data-legacy-claims]')?.textContent || '[]'); } catch (_) {}

      const base = root.dataset.base || '/';
      const panels = [...root.querySelectorAll('[data-start-panel]')];
      const modeButtons = [...root.querySelectorAll('[data-editor-mode]')];
      const workspace = root.querySelector('[data-editor-workspace]');
      const editorHero = document.querySelector('[data-editor-hero]');
      const inventory = root.querySelector('[data-editor-inventory]');
      const inventorySection = root.querySelector('[data-inventory-section]');
      const inventorySearch = root.querySelector('[data-inventory-search]');
      const updateButton = null;
      const saveStateBadge = root.querySelector('[data-cloud-save-state]');
      const modalElements = [...root.querySelectorAll('[data-editor-modal]')];
      const priceFormatter = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' });


      let state = null;
      let activeTab = 'cards';
      let inventoryQuery = '';
      let kitFilter = 'all';
      let kitQuery = '';
      let idSeed = 0;
      let activeAlbumIndex = -1;
      let activeAlbumPage = 0;
      let albumCardQuery = '';
      let selectedAlbumCardId = '';
      let activeKitEditIndex = -1;
      let profileDirty = false;
      let privacyDirty = false;
      let mirrorDirty = false;
      let cloudSaveTimer = 0;
      let cloudSaving = false;
      let cloudSaveQueued = false;
      let authActionInProgress = false;

      const setCloudSaveState = (label, mode = 'saved') => {
        if (!saveStateBadge) return;
        saveStateBadge.dataset.state = mode;
        saveStateBadge.innerHTML = `<i></i> ${label}`;
      };
      const hasCloudChanges = () => {
        if (!state) return false;
        if (profileDirty || privacyDirty || mirrorDirty || (state.pendingMovements || []).length) return true;
        if (Object.values(state.removed || {}).some((rows) => Array.isArray(rows) && rows.length)) return true;
        return ['cards', 'boosters', 'kits', 'products', 'albums'].some((kind) => (state[kind] || []).some((item) => item._isNew || item._isDirty));
      };
      const flushCloudSave = async () => {
        if (!state || !hasCloudChanges()) return;
        if (cloudSaving) { cloudSaveQueued = true; return; }
        cloudSaving = true;
        clearTimeout(cloudSaveTimer);
        setCloudSaveState('Salvando…', 'saving');
        try {
          await window.VaultCloud?.ready;
          await window.VaultCloud.saveEditorState(state, { profileDirty, privacyDirty, mirrorDirty });
          profileDirty = false;
          privacyDirty = false;
          mirrorDirty = false;
          setCloudSaveState('Sincronizado', 'saved');
          renderCollectionTimeline();
        } catch (error) {
          setCloudSaveState('Erro ao salvar', 'error');
          console.error('[Vault TCG] Falha ao salvar no Firebase:', error);
        } finally {
          cloudSaving = false;
          if (cloudSaveQueued) { cloudSaveQueued = false; await flushCloudSave(); }
        }
      };
      const scheduleCloudSave = (delay = 850) => {
        if (!state || !hasCloudChanges()) return;
        clearTimeout(cloudSaveTimer);
        setCloudSaveState('Alterações pendentes', 'pending');
        cloudSaveTimer = window.setTimeout(() => { flushCloudSave(); }, delay);
      };

      const clean = (value) => String(value ?? '').trim();
      const bytesFromBase64 = (value) => Uint8Array.from(atob(String(value || '')), (char) => char.charCodeAt(0));
      const equalBytes = (left, right) => left.length === right.length && left.every((value, index) => value === right[index]);
      const verifyLegacyPassword = async (password, claim) => {
        if (!claim || !password || !window.crypto?.subtle) return false;
        const key = await crypto.subtle.importKey('raw', new TextEncoder().encode(String(password)), 'PBKDF2', false, ['deriveBits']);
        const bits = await crypto.subtle.deriveBits({ name: 'PBKDF2', hash: 'SHA-256', salt: bytesFromBase64(claim.salt), iterations: Number(claim.iterations || 210000) }, key, 256);
        return equalBytes(new Uint8Array(bits), bytesFromBase64(claim.verifier));
      };
      const toPrice = (value) => {
        const raw = clean(value).replace(/R\$/gi, '').replace(/\s/g, '');
        if (!raw || raw === '-') return null;
        const normalized = raw.includes(',') ? raw.replace(/\./g, '').replace(',', '.') : raw;
        const parsed = Number(normalized);
        return Number.isFinite(parsed) ? parsed : null;
      };
      const toQuantity = (value, fallback = 1) => {
        const parsed = Number(value);
        return Number.isFinite(parsed) && parsed >= 0 ? Math.floor(parsed) : fallback;
      };
      const prettyPrice = (value) => value === null || value === undefined ? '—' : priceFormatter.format(Number(value));
      const safeSlug = (value) => clean(value).normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/gi, '-').replace(/(^-|-$)/g, '').toLowerCase() || 'colecao';
      const escapeHtml = (value) => clean(value).replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[char]));
      const uid = (prefix) => `${prefix}-${Date.now().toString(36)}-${(idSeed += 1).toString(36)}`;
      const normalizeText = (value) => clean(value).normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
      const stableIdPart = (value) => clean(value).replace(/[^A-Za-z0-9]+/g, '-').replace(/(^-|-$)/g, '').toUpperCase() || 'SEM';
      const stableLanguage = (value) => { const key = normalizeText(value); if (key.includes('portugu') || key === 'br' || key === 'pt br') return 'BR'; if (key.includes('ingles') || key === 'ing' || key === 'en') return 'ING'; return stableIdPart(value).slice(0, 5); };
      const stableCardId = (item = {}) => {
        let edition = clean(item.collection); let number = clean(item.number);
        try { const url = new URL(item.linkLiga || ''); edition = url.searchParams.get('ed') || edition; number = number || url.searchParams.get('num') || ''; } catch (_) {}
        return `${stableIdPart(edition || 'COLECAO')}-${stableIdPart(number || 'SEM-NUMERO')}-${stableLanguage(item.language || 'BR')}-${stableIdPart(item.condition || 'NM')}`;
      };
      const stableBoosterId = (item = {}) => { let edition = ''; try { edition = new URL(item.linkLiga || '').searchParams.get('ed') || ''; } catch (_) {} return `BOOSTER-${stableIdPart(edition || item.name || 'BOOSTER')}`; };
      const stableProductId = (item = {}) => `PRODUTO-${stableIdPart(item.name || getNameFromLink(item.linkLiga || '', 'PRODUTO'))}`;
      const getNameFromLink = (link, fallback) => {
        try {
          const url = new URL(link);
          const card = url.searchParams.get('card');
          if (card) return clean(card).replace(/\([^)]*\)/g, '').replace(/[-+]/g, ' ') || fallback;
          const pathName = decodeURIComponent(url.pathname.split('/').filter(Boolean).pop() || '').replace(/[-_]+/g, ' ');
          return pathName || fallback;
        } catch (_) { return fallback; }
      };
      const imageUrls = (item) => {
        const candidates = Array.isArray(item?.imageCandidates) ? item.imageCandidates : item?.image ? [item.image] : [];
        return candidates.filter(Boolean).map((candidate) => /^(?:https?:|data:|blob:)/i.test(candidate) ? candidate : `${base}${String(candidate).replace(/^\/+/, '')}`);
      };
      const renderImage = (item, label = '') => {
        const urls = imageUrls(item);
        const name = item?.name || label || 'Item';
        const initials = name.split(/\s+/).filter(Boolean).slice(0, 2).map((part) => part[0]).join('').toUpperCase() || 'TCG';
        return `<div class="inventory-thumb"><span>${escapeHtml(initials)}</span>${urls[0] ? `<img src="${escapeHtml(urls[0])}" alt="${escapeHtml(name)}" loading="lazy" data-image-candidates="${escapeHtml(JSON.stringify(urls.slice(1)))}" data-image-index="0" />` : ''}</div>`;
      };
      const itemPrice = (item) => item?.price ?? item?.leaguePrice ?? null;
      const itemName = (item, kind) => item?.name || item?.collection || getNameFromLink(item?.linkLiga || '', kind === 'cards' ? 'Carta da Liga' : kind === 'products' ? 'Produto Pokémon' : 'Booster da Liga');
      const allMovements = () => state ? [...(state.movements || []), ...(state.pendingMovements || [])] : [];
      const queueSaleMovement = (kind, item, before, after) => {
        if (!state) return;
        state.pendingMovements.push({
          eventId: uid('mov'), updateId: '', collectionId: state.profile.collectionId || safeSlug(state.profile.title),
          version: Number(state.profile.version || 1), date: new Date().toISOString(), eventType: 'venda', itemType: kind,
          itemId: item._id || item.id || '', name: itemName(item, kind), quantityBefore: before, quantityDelta: after - before,
          quantityAfter: after, source: 'site', note: 'Venda registrada pelo botão Vendi 1.',
        });
      };
      const movementTimelineMarkup = (item) => {
        const itemId = clean(item?._id || item?.id);
        const rows = allMovements().filter((entry) => clean(entry.itemId) === itemId).sort((a, b) => String(b.date || '').localeCompare(String(a.date || '')));
        if (!rows.length) return '<div class="movement-empty"><span>↕</span><strong>Nenhuma movimentação registrada</strong><p>Entradas e vendas aparecerão aqui a partir dos próximos updates.</p></div>';
        const labels = { saldo_inicial: 'Saldo inicial', entrada: 'Entrada', venda: 'Venda', ajuste_saida: 'Saída / ajuste', remocao: 'Remoção', ajuste: 'Ajuste' };
        return `<div class="movement-timeline">${rows.map((entry) => {
          const delta = Number(entry.quantityDelta || 0);
          const date = entry.date ? new Date(entry.date).toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short' }) : 'Data não informada';
          const label = labels[entry.eventType] || clean(entry.eventType).replace(/_/g, ' ') || 'Movimentação';
          const version = Number(entry.version || 0);
          return `<article class="movement-event ${escapeHtml(entry.eventType || 'ajuste')}"><i></i><div><header><strong>${escapeHtml(label)}</strong><span>${escapeHtml(date)}${version ? ` · v${version}` : ''}</span></header><p>${escapeHtml(entry.note || (delta > 0 ? 'Item adicionado à coleção.' : delta < 0 ? 'Item saiu da coleção.' : 'Registro de estoque.'))}</p><footer><span>${toQuantity(entry.quantityBefore, 0)} → ${toQuantity(entry.quantityAfter, 0)}</span><b>${delta > 0 ? '+' : ''}${delta}</b></footer></div></article>`;
        }).join('')}</div>`;
      };
      const renderCollectionTimeline = () => {
        const target = root.querySelector('[data-collection-movements]');
        const count = root.querySelector('[data-movement-log-count]');
        if (!target || !state) return;
        const rows = allMovements().sort((a, b) => String(b.date || '').localeCompare(String(a.date || '')));
        if (count) count.textContent = `${rows.length} ${rows.length === 1 ? 'evento' : 'eventos'}`;
        if (!rows.length) {
          target.innerHTML = '<div class="movement-empty collection-movement-empty"><span>↕</span><strong>A timeline começa no primeiro registro</strong><p>Ao formatar uma coleção nova, os saldos entram automaticamente. Depois, updates registram entradas, vendas, remoções e ajustes.</p></div>';
          return;
        }
        const labels = { saldo_inicial: 'Saldo inicial', entrada: 'Entrada', venda: 'Venda', ajuste_saida: 'Saída / ajuste', remocao: 'Remoção', ajuste: 'Ajuste' };
        const kindLabels = { cards: 'Carta', cartas: 'Carta', boosters: 'Booster', kits: 'Kit', products: 'Produto', produtos: 'Produto' };
        target.innerHTML = `<div class="collection-movement-timeline">${rows.slice(0, 80).map((entry) => {
          const delta = Number(entry.quantityDelta || 0);
          const dateValue = entry.date ? new Date(entry.date) : null;
          const date = dateValue && !Number.isNaN(dateValue.getTime()) ? dateValue.toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short' }) : (entry.date || 'Data não informada');
          const label = labels[entry.eventType] || clean(entry.eventType).replace(/_/g, ' ') || 'Movimentação';
          const version = Number(entry.version || 0);
          const kind = kindLabels[entry.itemType] || clean(entry.itemType) || 'Item';
          return `<article class="collection-movement-row ${escapeHtml(entry.eventType || 'ajuste')}"><i></i><div class="movement-row-main"><span>${escapeHtml(label)}</span><strong>${escapeHtml(entry.name || entry.itemId || 'Item')}</strong><small>${escapeHtml(kind)}${version ? ` · versão ${version}` : ''}</small></div><div class="movement-row-balance"><strong>${toQuantity(entry.quantityBefore, 0)} → ${toQuantity(entry.quantityAfter, 0)}</strong><b>${delta > 0 ? '+' : ''}${delta}</b></div><time>${escapeHtml(date)}</time></article>`;
        }).join('')}</div>${rows.length > 80 ? `<p class="movement-log-more">Mostrando os 80 eventos mais recentes de ${rows.length}.</p>` : ''}`;
      };

      const normalizeCard = (item = {}, isNew = false) => {
        const normalized = {
          ...item,
          name: item.name || getNameFromLink(item.linkLiga || '', 'Carta da Liga'), number: item.number || '', collection: item.collection || '', year: item.year || '', type: item.type || '',
          language: item.language || 'Português (PT-BR)', condition: item.condition || 'NM', quantity: toQuantity(item.quantity),
          certainMinimumPrice: toPrice(item.certainMinimumPrice), minimumPrice: toPrice(item.minimumPrice), quickSalePrice: toPrice(item.quickSalePrice), leaguePrice: toPrice(item.leaguePrice), secondLeaguePrice: toPrice(item.secondLeaguePrice), thirdLeaguePrice: toPrice(item.thirdLeaguePrice), averageLeaguePrice: toPrice(item.averageLeaguePrice), medianLeaguePrice: toPrice(item.medianLeaguePrice), price: toPrice(item.price),
          sellersGeneral: Number(item.sellersGeneral || 0), sellersSpecific: Number(item.sellersSpecific || 0), buyersGeneral: Number(item.buyersGeneral || 0), buyersSpecific: Number(item.buyersSpecific || 0),
          linkLiga: item.linkLiga || '', linkMyp: item.linkMyp || '', linkCardmarket: item.linkCardmarket || '', linkTcgplayer: item.linkTcgplayer || '', linkPriceCharting: item.linkPriceCharting || '',
          favorite: item.favorite === true, priceHistory: Array.isArray(item.priceHistory) ? item.priceHistory : [], advancedData: item.advancedData && typeof item.advancedData === 'object' ? item.advancedData : {},
          forSale: item.forSale !== false, image: item.image || '', imageCandidates: Array.isArray(item.imageCandidates) ? item.imageCandidates : [],
        };
        normalized._id = item._id || item.id || item.Id || stableCardId(normalized);
        normalized._isNew = item._isNew ?? isNew;
        normalized._isDirty = item._isDirty ?? false;
        return normalized;
      };
      const normalizeBooster = (item = {}, isNew = false) => {
        const normalized = {
          ...item,
          name: item.name || getNameFromLink(item.linkLiga || '', 'Booster da Liga'), quantity: toQuantity(item.quantity),
