      drop?.addEventListener('drop', (event) => { const file = event.dataTransfer?.files?.[0]; if (file) importZip(file); });

      const downloadZip = (zip, filename) => { const link = document.createElement('a'); link.href = URL.createObjectURL(new Blob([zip], { type: 'application/zip' })); link.download = filename; link.click(); setTimeout(() => URL.revokeObjectURL(link.href), 0); };
      root.querySelector('[data-download-zip]')?.addEventListener('click', () => {
        if (!state) return;
        state.profile.version = Number(state.profile.version || 1);
        const cards = state.cards.map((item) => ({ 'Nome': item.name || '', 'Número': item.number || '', 'Coleção': item.collection || '', 'Idioma': item.language, 'Estado': item.condition, 'Ano': item.year || '', 'Tipo': item.type || '', 'Link Liga': item.linkLiga, 'Link MYP': item.linkMyp, 'Link Cardmarket': item.linkCardmarket, 'Link Tcgplayer': item.linkTcgplayer, 'Link PriceCharting': item.linkPriceCharting, 'Minimo': item.minimumPrice ?? '', 'Venda Rapida': item.quickSalePrice ?? '', 'Menor Liga': item.leaguePrice ?? '', 'Preço': item.price ?? '', 'Quantidade': item.quantity, 'À venda': item.forSale ? 'Sim' : 'Não' }));
        const boosters = state.boosters.map((item) => ({ 'Tipo de pacote': item.name || '', 'Quantidade': item.quantity, 'Preço mínimo': item.minimumPrice ?? '', 'Venda rápida': item.quickSalePrice ?? '', 'Preço Liga mais barato': item.leaguePrice ?? '', 'Preço': item.price ?? '', 'Link Liga': item.linkLiga, 'À venda': item.forSale ? 'Sim' : 'Não' }));
        const kits = state.kits.map(kitRow);
        const albums = state.albums.map(albumRow);
        const profile = { ...state.profile, generatedAt: new Date().toISOString() };
        const zip = zipStore([['perfil.json', JSON.stringify(profile, null, 2)], ['inventario-cartas.csv', csv(csvHeaders.cards, cards)], ['inventario-boosters.csv', csv(csvHeaders.boosters, boosters)], ['inventario-kits.csv', csv(csvHeaders.kits, kits)], ['inventario-albuns.csv', csv(csvHeaders.albums, albums)]]);
        downloadZip(zip, `${safeSlug(state.profile.title)}-v${state.profile.version}.zip`);
      });
      updateButton?.addEventListener('click', () => {
        if (!state) return;
        const cards = state.cards.filter((item) => item._isNew).map((item) => ({ 'Link Liga': item.linkLiga, 'Quantidade': item.quantity, 'Estado': item.condition, 'Idioma': item.language }));
        const boosters = state.boosters.filter((item) => item._isNew).map((item) => ({ 'Link Liga': item.linkLiga, 'Quantidade': item.quantity }));
        const kits = state.kits.filter((item) => item._isNew).map(kitRow);
        const albums = state.albums.filter((item) => item._isNew || item._isDirty).map(albumRow);
        if (!cards.length && !boosters.length && !kits.length && !albums.length) { window.alert('Nenhuma carta, booster, kit ou álbum novo foi criado ou alterado nesta edição.'); return; }
        const generatedAt = new Date().toISOString();
        const metadata = { type: 'collection-update', collectionId: state.profile.collectionId || safeSlug(state.profile.title), baseVersion: Math.max(1, Number(state.profile.version || 1) - 1), version: Number(state.profile.version || 1), generatedAt, updateId: `${state.profile.collectionId || safeSlug(state.profile.title)}-${Number(state.profile.version || 1)}-${Date.now()}` };
        const zip = zipStore([
          ['atualizacao.json', JSON.stringify(metadata, null, 2)],
          ['inventario-cartas.csv', csv(['Link Liga', 'Quantidade', 'Estado', 'Idioma'], cards)],
          ['inventario-boosters.csv', csv(['Link Liga', 'Quantidade'], boosters)],
          ['inventario-kits.csv', csv(csvHeaders.kits, kits)],
          ['inventario-albuns.csv', csv(csvHeaders.albums, albums)],
        ]);
        downloadZip(zip, `${safeSlug(metadata.collectionId)}-update-v${metadata.version}.zip`);
      });
    })();
  </script>
</BaseLayout>
