      const parseCsv = (source) => { const rows = []; let row = []; let field = ''; let quoted = false; for (let index = 0; index < source.length; index += 1) { const char = source[index]; if (char === '"') { if (quoted && source[index + 1] === '"') { field += '"'; index += 1; } else quoted = !quoted; } else if (char === ',' && !quoted) { row.push(field); field = ''; } else if ((char === '\n' || char === '\r') && !quoted) { if (char === '\r' && source[index + 1] === '\n') index += 1; row.push(field); if (row.some((value) => clean(value))) rows.push(row); row = []; field = ''; } else field += char; } if (field || row.length) { row.push(field); rows.push(row); } const [headers = [], ...values] = rows; return values.map((record) => Object.fromEntries(headers.map((header, index) => [clean(header), clean(record[index])]))); };
      const importZip = async (file) => { const feedback = root.querySelector('[data-import-feedback]'); try { const files = unzipStore(await file.arrayBuffer()); const profile = JSON.parse(files['perfil.json'] || '{}'); if (!profile.owner || !profile.title || !profile.email || !profile.password) throw new Error('O ZIP não contém um perfil válido.'); const cards = parseCsv(files['inventario-cartas.csv'] || '').map((row) => ({ name: row['Nome'], number: row['Numeração'] || row['Número'], collection: row['Coleção'], language: row['Idioma'], condition: row['Estado'], quantity: Number(row['Quantidade']) || 1, price: toPrice(row['Preço']), forSale: row['À venda'] !== 'Não', linkLiga: row['Link Liga'] })); const boosters = parseCsv(files['inventario-boosters.csv'] || '').map((row) => ({ name: row['Coleção'] || row['Tipo de pacote'], quantity: Number(row['Quantidade']) || 1, price: toPrice(row['Preço']), forSale: row['À venda'] !== 'Não', linkLiga: row['Link Liga'] })); const kits = parseCsv(files['inventario-kits.csv'] || '').map((row) => ({ name: row['Nome'], description: row['Descrição'] || '', contents: row['Conteúdo'] || '', quantity: Number(row['Quantidade']) || 1, price: toPrice(row['Preço']), forSale: row['À venda'] !== 'Não' })); feedback.textContent = ''; activate({ ...profile, version: Number(profile.version || 0) + 1 }, { cards, boosters, kits }, 'import'); } catch (error) { feedback.textContent = error.message || 'Não foi possível abrir este ZIP.'; } };
      root.querySelector('[data-zip-input]')?.addEventListener('change', (event) => { const file = event.target.files?.[0]; if (file) importZip(file); });
