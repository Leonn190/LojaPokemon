---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEditableCollections } from '../../lib/catalog';

const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const publishedCollections = getEditableCollections();
---

<BaseLayout
  title="Criar ou editar coleção"
  description="Monte, importe ou edite sua coleção Pokémon e gere o ZIP para aprovação."
  active="signup"
  bodyClass="signup-page"
>
  <section class="signup-hero editor-hero">
    <div class="shell signup-hero-grid">
      <div data-reveal>
        <span class="hero-badge"><i></i> Central de coleções</span>
        <h1>Controle sua coleção em um só lugar.</h1>
        <p>Organize o inventário, prepare itens para venda, monte kits visualmente e gere o ZIP para publicação. Envie o arquivo final para <strong>alexeidostoievsky@gmail.com</strong>.</p>
      </div>
      <div class="signup-steps" data-reveal>
        <article><span>01</span><div><strong>Entre na coleção</strong><p>Crie uma nova, importe um ZIP anterior ou abra uma coleção publicada.</p></div></article>
        <article><span>02</span><div><strong>Edite o inventário</strong><p>Veja cartas, boosters, kits e álbuns em abas organizadas.</p></div></article>
        <article><span>03</span><div><strong>Publique a atualização</strong><p>Baixe o ZIP completo ou somente as novas cartas, boosters e kits, além dos álbuns criados ou reorganizados.</p></div></article>
      </div>
    </div>
  </section>

  <section class="shell collection-editor" data-editor-root data-base={base} data-published={JSON.stringify(publishedCollections)}>
    <div class="editor-mode-tabs" role="tablist" aria-label="Forma de iniciar uma coleção">
      <button type="button" class="active" data-editor-mode="new">Criar do zero</button>
      <button type="button" data-editor-mode="import">Importar ZIP</button>
      <button type="button" data-editor-mode="published">Editar coleção publicada</button>
    </div>

    <div class="editor-notice" data-editor-notice>
      <span>i</span><p>Os dados ficam no seu navegador até o download. A validação de acesso desta versão controla apenas a interface do site estático.</p>
    </div>

    <section class="editor-start-panel" data-start-panel="new">
      <div class="form-section-heading"><span class="section-eyebrow">Nova coleção</span><h2>Dados do colecionador</h2><p>Cadastre o perfil e depois organize os itens pelo painel.</p></div>
      <form class="editor-profile-form" data-new-profile-form>
        <label class="form-field"><span>Nome</span><input name="owner" required placeholder="Ex.: Ana Silva" /></label>
        <label class="form-field"><span>Nome da coleção</span><input name="title" required placeholder="Ex.: Coleção da Ana" /></label>
        <label class="form-field"><span>Gmail</span><input name="email" type="email" required placeholder="voce@gmail.com" /></label>
        <label class="form-field"><span>Número de telefone</span><input name="phone" required placeholder="(00) 00000-0000" /></label>
        <label class="form-field"><span>Senha</span><input name="password" type="password" minlength="4" required /></label>
        <label class="form-field"><span>Descrição (opcional)</span><input name="description" placeholder="Conte um pouco sobre a coleção" /></label>
        <button class="primary-cta" type="submit"><span>Abrir editor</span><b>→</b></button>
      </form>
    </section>

    <section class="editor-start-panel" data-start-panel="import" hidden>
      <div class="form-section-heading"><span class="section-eyebrow">ZIP já formatado</span><h2>Continue uma versão anterior</h2><p>Selecione um ZIP gerado pela central. A edição será aberta com todos os itens encontrados.</p></div>
      <label class="zip-drop-zone" data-zip-drop><input type="file" accept=".zip,application/zip" data-zip-input /><span>↑</span><strong>Solte o ZIP aqui ou clique para escolher</strong><small>O arquivo não é enviado para nenhum servidor.</small></label>
      <p class="import-feedback" data-import-feedback></p>
    </section>

    <section class="editor-start-panel" data-start-panel="published" hidden>
      <div class="form-section-heading"><span class="section-eyebrow">Coleções aprovadas</span><h2>Entre para editar</h2><p>Use o Gmail ou telefone e a senha vinculada à coleção.</p></div>
      <form class="editor-profile-form published-login" data-published-login>
        <label class="form-field"><span>Gmail ou número de telefone</span><input name="login" required /></label>
        <label class="form-field"><span>Senha</span><input name="password" type="password" required /></label>
        <button class="primary-cta" type="submit"><span>Autorizar edição</span><b>→</b></button>
      </form>
      <p class="import-feedback" data-login-feedback></p>
    </section>

    <section class="editor-workspace" data-editor-workspace hidden>
      <header class="editor-workspace-header">
        <div>
          <span class="section-eyebrow">Editor da coleção</span>
          <h2 data-workspace-title>Sua coleção</h2>
          <p data-workspace-meta>Versão 1</p>
        </div>
        <div class="workspace-header-actions">
          <span class="workspace-save-state"><i></i> Alterações locais</span>
          <button type="button" class="secondary-cta" data-reset-editor><span>Sair do editor</span><b>×</b></button>
        </div>
      </header>

      <section class="editor-control-center" aria-label="Configurações gerais da coleção">
        <label class="editor-setting-card">
          <span class="setting-icon">#</span>
          <span><strong>Mostrar quantidades</strong><small>Exibe o estoque nas páginas públicas.</small></span>
          <span class="switch"><input type="checkbox" data-show-quantity checked /><i></i></span>
        </label>
        <label class="editor-setting-card">
          <span class="setting-icon">$</span>
          <span><strong>Liberar vendas</strong><small>Permite que itens marcados entrem no carrinho.</small></span>
          <span class="switch"><input type="checkbox" data-collection-selling checked /><i></i></span>
        </label>
        <div class="editor-overview-card">
          <span class="setting-icon">Σ</span>
          <span><strong data-overview-units>0 unidades</strong><small data-overview-value>R$ 0,00 em preços definidos</small></span>
        </div>
      </section>

      <section class="editor-command-section editor-command-section-compact" aria-label="Adicionar itens à coleção">
        <div class="editor-command-grid">
          <button type="button" class="editor-command-card" data-open-modal="card"><span>◇</span><strong>Adicionar carta</strong><small>Cadastre pelo link da Liga e estado.</small><b>＋</b></button>
          <button type="button" class="editor-command-card" data-open-modal="booster"><span>▱</span><strong>Adicionar booster</strong><small>Inclua pacotes lacrados no estoque.</small><b>＋</b></button>
          <button type="button" class="editor-command-card is-kit" data-open-modal="kit"><span>▦</span><strong>Adicionar kit</strong><small>Monte visualmente com drag and drop.</small><b>＋</b></button>
          <button type="button" class="editor-command-card is-album" data-open-modal="album"><span>▤</span><strong>Adicionar álbum</strong><small>Escolha o formato e organize carta por carta.</small><b>＋</b></button>
        </div>
      </section>

      <section class="editor-inventory-shell" data-inventory-section>
        <header class="inventory-shell-header">
          <div><span class="section-eyebrow">Inventário</span><h3>Todos os itens da coleção</h3><p>Uma visão de planilha, com espaço suficiente para imagens, preços e ações.</p></div>
          <label class="inventory-search"><span>⌕</span><input type="search" placeholder="Buscar nesta aba..." data-inventory-search /></label>
        </header>

        <nav class="inventory-tabs" role="tablist" aria-label="Tipos de inventário">
          <button type="button" class="active" data-inventory-tab="cards"><span>Cartas</span><b data-tab-count="cards">0</b></button>
          <button type="button" data-inventory-tab="boosters"><span>Boosters</span><b data-tab-count="boosters">0</b></button>
          <button type="button" data-inventory-tab="kits"><span>Kits</span><b data-tab-count="kits">0</b></button>
          <button type="button" data-inventory-tab="albums"><span>Álbuns</span><b data-tab-count="albums">0</b></button>
        </nav>

        <div class="editor-inventory" data-editor-inventory></div>
      </section>

      <div class="editor-export-panel">
        <div><span class="section-eyebrow">Pronto para aprovação</span><h3>Baixe o ZIP da versão <b data-version-number>1</b></h3><p>O ZIP completo leva todo o inventário. O update inclui novas cartas, boosters, kits e álbuns criados ou reorganizados nesta edição.</p></div>
        <div class="editor-export-actions"><button type="button" class="secondary-cta" data-download-update hidden><span>Baixar só o update</span><b>＋</b></button><button type="button" class="primary-cta" data-download-zip><span>Baixar ZIP completo</span><b>↓</b></button></div>
      </div>
    </section>

    <div class="editor-modal" data-editor-modal="card" hidden>
      <button class="editor-modal-backdrop" type="button" data-close-modal aria-label="Fechar"></button>
      <section class="editor-modal-dialog editor-form-dialog" role="dialog" aria-modal="true" aria-labelledby="card-modal-title">
        <header class="editor-modal-header"><div><span class="section-eyebrow">Nova carta</span><h2 id="card-modal-title">Adicionar carta</h2><p>O formatador poderá completar os dados consultando o link da Liga.</p></div><button type="button" data-close-modal aria-label="Fechar">×</button></header>
        <form class="editor-item-form editor-modal-form" data-card-form>
          <div class="modal-form-grid">
            <label class="wide"><span>Link da Liga</span><input name="linkLiga" type="url" required placeholder="https://www.ligapokemon.com.br/..." /><small>Campo usado pelo formatador para consultar nome, coleção, preços e imagem.</small></label>
            <label><span>Estado</span><select name="condition" required><option value="NM">NM</option><option value="SP">SP</option><option value="MP">MP</option><option value="HP">HP</option><option value="D">D</option></select></label>
            <label><span>Idioma</span><input name="language" required value="Português (PT-BR)" /></label>
            <label><span>Quantidade</span><input name="quantity" type="number" min="1" value="1" required /></label>
            <label><span>Preço final (opcional)</span><input name="price" type="number" min="0" step="0.01" placeholder="Ex.: 45.90" /></label>
          </div>
          <label class="modal-sale-check"><input name="forSale" type="checkbox" checked /><span><strong>Disponível para venda</strong><small>Pode ser alterado individualmente no inventário.</small></span></label>
          <footer class="modal-form-actions"><button type="button" class="secondary-cta" data-close-modal><span>Cancelar</span><b>×</b></button><button type="submit" class="primary-cta"><span>Adicionar carta</span><b>＋</b></button></footer>
        </form>
      </section>
    </div>

    <div class="editor-modal" data-editor-modal="booster" hidden>
      <button class="editor-modal-backdrop" type="button" data-close-modal aria-label="Fechar"></button>
      <section class="editor-modal-dialog editor-form-dialog" role="dialog" aria-modal="true" aria-labelledby="booster-modal-title">
        <header class="editor-modal-header"><div><span class="section-eyebrow">Novo booster</span><h2 id="booster-modal-title">Adicionar booster</h2><p>Cadastre o link e a quantidade. As demais informações podem ser completadas pelo formatador.</p></div><button type="button" data-close-modal aria-label="Fechar">×</button></header>
        <form class="editor-item-form editor-modal-form" data-booster-form>
          <div class="modal-form-grid">
            <label class="wide"><span>Link da Liga</span><input name="linkLiga" type="url" required placeholder="https://www.ligapokemon.com.br/..." /></label>
            <label><span>Quantidade</span><input name="quantity" type="number" min="1" value="1" required /></label>
            <label><span>Preço final (opcional)</span><input name="price" type="number" min="0" step="0.01" placeholder="Ex.: 30.00" /></label>
          </div>
          <label class="modal-sale-check"><input name="forSale" type="checkbox" checked /><span><strong>Disponível para venda</strong><small>Pode ser alterado individualmente no inventário.</small></span></label>
          <footer class="modal-form-actions"><button type="button" class="secondary-cta" data-close-modal><span>Cancelar</span><b>×</b></button><button type="submit" class="primary-cta"><span>Adicionar booster</span><b>＋</b></button></footer>
        </form>
      </section>
    </div>

    <div class="editor-modal editor-kit-modal" data-editor-modal="kit" hidden>
      <button class="editor-modal-backdrop" type="button" data-close-modal aria-label="Fechar"></button>
      <section class="editor-modal-dialog kit-builder-dialog" role="dialog" aria-modal="true" aria-labelledby="kit-modal-title">
        <header class="editor-modal-header"><div><span class="section-eyebrow">Construtor visual</span><h2 id="kit-modal-title">Monte o kit por drag and drop</h2><p>Arraste cartas e boosters para a área do kit, ajuste quantidades e defina o preço final.</p></div><button type="button" data-close-modal aria-label="Fechar">×</button></header>
        <div class="kit-builder-workspace">
          <section class="kit-product-library">
            <header><div><strong>Itens disponíveis</strong><small>Arraste ou clique para adicionar.</small></div><label><span>⌕</span><input type="search" placeholder="Buscar produto..." data-kit-search /></label></header>
            <div class="kit-library-filters"><button type="button" class="active" data-kit-filter="all">Todos</button><button type="button" data-kit-filter="cards">Cartas</button><button type="button" data-kit-filter="boosters">Boosters</button></div>
            <div class="kit-product-bank" data-kit-product-bank></div>
          </section>

          <form class="kit-composer" data-kit-form>
            <div class="kit-drop-zone" data-kit-drop-zone><span>↓</span><strong>Solte os itens do kit aqui</strong><small data-kit-drop-count>Nenhum produto selecionado</small></div>
            <div class="kit-selected-items" data-kit-selected-items></div>
            <div class="kit-form-fields">
              <label class="wide"><span>Nome do kit</span><input name="name" required placeholder="Ex.: Kit Evoluções Prismáticas" /></label>
              <label class="wide"><span>Descrição</span><textarea name="description" rows="3" required placeholder="Explique o conteúdo ou proposta do kit."></textarea></label>
              <label><span>Quantidade de kits</span><input name="quantity" type="number" min="1" value="1" required /></label>
              <label><span>Preço final do kit</span><input name="price" type="number" min="0" step="0.01" required data-kit-price /></label>
            </div>
            <div class="kit-price-summary"><div><span>Preço bruto</span><strong data-kit-gross>R$ 0,00</strong></div><div><span>Preço final</span><strong data-kit-final>R$ 0,00</strong></div><div class="discount"><span>Desconto</span><strong data-kit-discount>0%</strong></div></div>
            <label class="modal-sale-check"><input name="forSale" type="checkbox" checked /><span><strong>Kit disponível para venda</strong><small>O preço final será mostrado na coleção.</small></span></label>
            <footer class="modal-form-actions"><button type="button" class="secondary-cta" data-close-modal><span>Cancelar</span><b>×</b></button><button type="submit" class="primary-cta"><span>Salvar kit</span><b>＋</b></button></footer>
          </form>
        </div>
      </section>
    </div>

    <div class="editor-modal" data-editor-modal="album" hidden>
      <button class="editor-modal-backdrop" type="button" data-close-modal aria-label="Fechar"></button>
      <section class="editor-modal-dialog editor-form-dialog" role="dialog" aria-modal="true" aria-labelledby="album-modal-title">
        <header class="editor-modal-header"><div><span class="section-eyebrow">Novo álbum virtual</span><h2 id="album-modal-title">Escolha a organização</h2><p>O formato define quantas cartas cabem em cada página. Depois você posiciona livremente cada carta e pode criar quantas páginas precisar.</p></div><button type="button" data-close-modal aria-label="Fechar">×</button></header>
        <form class="editor-item-form editor-modal-form" data-album-form>
          <div class="modal-form-grid">
            <label><span>Nome do álbum</span><input name="name" required placeholder="Ex.: Master Set 151" /></label>
            <label><span>Formato das páginas</span><select name="format" required><option value="2x2">2 por 2</option><option value="3x2">3 por 2</option><option value="2x3">2 por 3</option><option value="3x3" selected>3 por 3</option><option value="4x3">4 por 3</option><option value="4x4">4 por 4</option><option value="5x5">5 por 5</option><option value="6x6">6 por 6</option></select></label>
            <label class="wide"><span>Descrição (opcional)</span><textarea name="description" rows="3" placeholder="Ex.: coleção completa em ordem numérica."></textarea></label>
          </div>
          <footer class="modal-form-actions"><button type="button" class="secondary-cta" data-close-modal><span>Cancelar</span><b>×</b></button><button type="submit" class="primary-cta"><span>Criar e organizar</span><b>→</b></button></footer>
        </form>
      </section>
    </div>

    <div class="editor-modal editor-album-organizer-modal" data-editor-modal="album-organizer" hidden>
      <button class="editor-modal-backdrop" type="button" data-close-modal aria-label="Fechar"></button>
      <section class="editor-modal-dialog album-organizer-dialog" role="dialog" aria-modal="true" aria-labelledby="album-organizer-title">
        <header class="editor-modal-header album-organizer-header"><div><span class="section-eyebrow">Organizador visual</span><h2 id="album-organizer-title" data-album-organizer-title>Álbum</h2><p>Arraste uma carta para qualquer espaço ou selecione uma carta e depois clique na posição desejada. A mesma carta pode aparecer em vários álbuns.</p></div><button type="button" data-close-modal aria-label="Fechar">×</button></header>
        <div class="album-organizer-workspace">
          <aside class="album-card-library">
            <div class="album-library-heading"><div><span>Cartas disponíveis</span><strong data-album-library-count>0 cartas</strong></div><label><span>⌕</span><input type="search" placeholder="Buscar carta..." data-album-card-search /></label></div>
            <div class="album-card-library-list" data-album-card-library></div>
          </aside>
          <main class="album-page-editor">
            <div class="album-page-toolbar">
              <div><span data-album-format-label>Formato 3 por 3</span><strong data-album-progress-label>0 / 9 espaços</strong></div>
              <div class="album-page-navigation"><button type="button" data-album-page-previous aria-label="Página anterior">‹</button><span data-album-page-counter>Página 1 de 1</span><button type="button" data-album-page-next aria-label="Próxima página">›</button></div>
              <div><button type="button" class="album-toolbar-button" data-album-add-page><span>＋</span> Nova página</button><button type="button" class="album-toolbar-button danger" data-album-remove-page><span>−</span> Excluir página</button></div>
            </div>
            <div class="album-editor-stage">
              <div class="album-editor-page-wrap" data-album-editor-page-wrap>
                <div class="album-editor-page" data-album-editor-page></div>
                <div class="album-editor-rings" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
              </div>
            </div>
            <div class="album-editor-hint"><span>i</span><p>Clique em uma carta para selecioná-la. Clique em um espaço ocupado para remover a carta daquele espaço.</p></div>
          </main>
        </div>
        <footer class="album-organizer-footer"><div><span>Alterações salvas no editor</span><strong data-album-organizer-summary>0 cartas organizadas</strong></div><button type="button" class="primary-cta" data-close-modal><span>Concluir organização</span><b>✓</b></button></footer>
      </section>
    </div>
  </section>

  <script is:inline>
    (() => {
      const root = document.querySelector('[data-editor-root]');
      if (!root) return;

      const base = root.dataset.base || '/';
      const published = JSON.parse(root.dataset.published || '[]');
      const panels = [...root.querySelectorAll('[data-start-panel]')];
      const modeButtons = [...root.querySelectorAll('[data-editor-mode]')];
      const workspace = root.querySelector('[data-editor-workspace]');
      const inventory = root.querySelector('[data-editor-inventory]');
      const inventorySection = root.querySelector('[data-inventory-section]');
      const inventorySearch = root.querySelector('[data-inventory-search]');
      const updateButton = root.querySelector('[data-download-update]');
      const modalElements = [...root.querySelectorAll('[data-editor-modal]')];
      const priceFormatter = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' });

      const csvHeaders = {
        cards: ['Nome', 'Número', 'Coleção', 'Idioma', 'Estado', 'Ano', 'Tipo', 'Link Liga', 'Link MYP', 'Link Cardmarket', 'Link Tcgplayer', 'Link PriceCharting', 'Minimo', 'Venda Rapida', 'Menor Liga', 'Preço', 'Quantidade', 'À venda'],
        boosters: ['Tipo de pacote', 'Quantidade', 'Preço mínimo', 'Venda rápida', 'Preço Liga mais barato', 'Preço', 'Link Liga', 'À venda'],
        kits: ['Nome', 'Descrição', 'Preço', 'Quantidade', 'Conteúdo', 'Conteúdo JSON', 'Valor avulso', 'Desconto', 'Imagem', 'À venda'],
        albums: ['ID', 'Nome', 'Descrição', 'Formato', 'Páginas JSON', 'Progresso', 'Quantidade', 'Imagem', 'À venda'],
      };

      let state = null;
      let activeTab = 'cards';
      let inventoryQuery = '';
      let kitFilter = 'all';
      let kitQuery = '';
      let idSeed = 0;
      let activeAlbumIndex = -1;
      let activeAlbumPage = 0;
      let albumCardQuery = '';
      let selectedAlbumCardId = '';

      const clean = (value) => String(value ?? '').trim();
      const toPrice = (value) => {
        const raw = clean(value).replace(/R\$/gi, '').replace(/\s/g, '');
        if (!raw || raw === '-') return null;
        const normalized = raw.includes(',') ? raw.replace(/\./g, '').replace(',', '.') : raw;
        const parsed = Number(normalized);
        return Number.isFinite(parsed) ? parsed : null;
      };
      const toQuantity = (value, fallback = 1) => {
        const parsed = Number(value);
        return Number.isFinite(parsed) && parsed > 0 ? Math.floor(parsed) : fallback;
      };
      const prettyPrice = (value) => value === null || value === undefined ? '—' : priceFormatter.format(Number(value));
      const safeSlug = (value) => clean(value).normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/gi, '-').replace(/(^-|-$)/g, '').toLowerCase() || 'colecao';
      const escapeHtml = (value) => clean(value).replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[char]));
      const uid = (prefix) => `${prefix}-${Date.now().toString(36)}-${(idSeed += 1).toString(36)}`;
      const normalizeText = (value) => clean(value).normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
      const getNameFromLink = (link, fallback) => {
        try {
          const url = new URL(link);
          const card = url.searchParams.get('card');
          if (card) return clean(card).replace(/\([^)]*\)/g, '').replace(/[-+]/g, ' ') || fallback;
          const pathName = decodeURIComponent(url.pathname.split('/').filter(Boolean).pop() || '').replace(/[-_]+/g, ' ');
          return pathName || fallback;
        } catch (_) { return fallback; }
      };
      const imageUrls = (item) => {
        const candidates = Array.isArray(item?.imageCandidates) ? item.imageCandidates : item?.image ? [item.image] : [];
        return candidates.filter(Boolean).map((candidate) => /^(?:https?:|data:|blob:)/i.test(candidate) ? candidate : `${base}${String(candidate).replace(/^\/+/, '')}`);
      };
      const renderImage = (item, label = '') => {
        const urls = imageUrls(item);
        const name = item?.name || label || 'Item';
        const initials = name.split(/\s+/).filter(Boolean).slice(0, 2).map((part) => part[0]).join('').toUpperCase() || 'TCG';
        return `<div class="inventory-thumb"><span>${escapeHtml(initials)}</span>${urls[0] ? `<img src="${escapeHtml(urls[0])}" alt="${escapeHtml(name)}" loading="lazy" data-image-candidates="${escapeHtml(JSON.stringify(urls.slice(1)))}" data-image-index="0" />` : ''}</div>`;
      };
      const itemPrice = (item) => item?.price ?? item?.leaguePrice ?? null;
      const itemName = (item, kind) => item?.name || item?.collection || getNameFromLink(item?.linkLiga || '', kind === 'cards' ? 'Carta da Liga' : 'Booster da Liga');

      const normalizeCard = (item = {}, isNew = false) => ({
        _id: item._id || uid('card'), _isNew: item._isNew ?? isNew,
        name: item.name || getNameFromLink(item.linkLiga || '', 'Carta da Liga'), number: item.number || '', collection: item.collection || '', year: item.year || '', type: item.type || '',
        language: item.language || 'Português (PT-BR)', condition: item.condition || 'NM', quantity: toQuantity(item.quantity),
        minimumPrice: toPrice(item.minimumPrice), quickSalePrice: toPrice(item.quickSalePrice), leaguePrice: toPrice(item.leaguePrice), price: toPrice(item.price),
        linkLiga: item.linkLiga || '', linkMyp: item.linkMyp || '', linkCardmarket: item.linkCardmarket || '', linkTcgplayer: item.linkTcgplayer || '', linkPriceCharting: item.linkPriceCharting || '',
        forSale: item.forSale !== false, imageCandidates: Array.isArray(item.imageCandidates) ? item.imageCandidates : [],
      });
      const normalizeBooster = (item = {}, isNew = false) => ({
        _id: item._id || uid('booster'), _isNew: item._isNew ?? isNew,
        name: item.name || getNameFromLink(item.linkLiga || '', 'Booster da Liga'), quantity: toQuantity(item.quantity),
        minimumPrice: toPrice(item.minimumPrice), quickSalePrice: toPrice(item.quickSalePrice), leaguePrice: toPrice(item.leaguePrice), price: toPrice(item.price),
        linkLiga: item.linkLiga || '', forSale: item.forSale !== false, imageCandidates: Array.isArray(item.imageCandidates) ? item.imageCandidates : [],
      });
      const legacyKitContents = (contents, cards, boosters) => clean(contents).split('|').map((part) => clean(part)).filter(Boolean).map((name) => {
        const card = cards.find((item) => normalizeText(item.name) === normalizeText(name));
        const booster = boosters.find((item) => normalizeText(item.name) === normalizeText(name));
        const source = card || booster;
        return { kind: card ? 'cards' : 'boosters', name, quantity: 1, unitPrice: itemPrice(source), imageCandidates: source?.imageCandidates || [] };
      });
      const normalizeKit = (item = {}, cards = [], boosters = []) => {
        const contentItems = Array.isArray(item.contentItems) && item.contentItems.length ? item.contentItems.map((entry) => ({ kind: entry.kind === 'boosters' ? 'boosters' : 'cards', name: entry.name || 'Item', quantity: toQuantity(entry.quantity), unitPrice: toPrice(entry.unitPrice), imageCandidates: Array.isArray(entry.imageCandidates) ? entry.imageCandidates : [] })) : legacyKitContents(item.contents, cards, boosters);
        const sourceTotal = toPrice(item.sourceTotal) ?? contentItems.reduce((sum, entry) => sum + (entry.unitPrice || 0) * entry.quantity, 0);
        return { _id: item._id || uid('kit'), _isNew: item._isNew ?? false, name: item.name || 'Kit sem nome', description: item.description || '', contents: item.contents || contentItems.map((entry) => `${entry.quantity}x ${entry.name}`).join(' | '), contentItems, sourceTotal, quantity: toQuantity(item.quantity), price: toPrice(item.price), forSale: item.forSale !== false, imageCandidates: Array.isArray(item.imageCandidates) ? item.imageCandidates : [] };
      };
      const parseAlbumFormat = (value = '3x3') => {
        const match = clean(value).match(/([2-6])\s*(?:x|por)\s*([2-6])/i);
        const columns = match ? Number(match[1]) : 3;
        const rows = match ? Number(match[2]) : 3;
        return { format: `${columns}x${rows}`, columns, rows, capacity: columns * rows };
      };
      const sameCardReference = (slot, card) => {
        if (!slot || !card) return false;
        if (slot.linkLiga && card.linkLiga && normalizeText(slot.linkLiga.replace(/([?&])show=\d+/i, '$1')) === normalizeText(card.linkLiga.replace(/([?&])show=\d+/i, '$1'))) return true;
        return normalizeText(slot.name) === normalizeText(card.name) && (!slot.number || !card.number || normalizeText(slot.number) === normalizeText(card.number));
      };
      const normalizeAlbumSlot = (slot, cards = []) => {
        if (!slot || typeof slot !== 'object') return null;
        const card = cards.find((candidate) => sameCardReference(slot, candidate));
        return {
          cardId: card?._id || slot.cardId || '',
          linkLiga: card?.linkLiga || slot.linkLiga || '',
          language: card?.language || slot.language || '',
          condition: card?.condition || slot.condition || '',
          name: card?.name || slot.name || 'Carta não localizada',
          number: card?.number || slot.number || '',
          collection: card?.collection || slot.collection || '',
          imageCandidates: Array.isArray(card?.imageCandidates) ? [...card.imageCandidates] : Array.isArray(slot.imageCandidates) ? [...slot.imageCandidates] : [],
        };
      };
      const normalizeAlbum = (item = {}, cards = []) => {
        const layout = parseAlbumFormat(item.format || '3x3');
        const sourcePages = Array.isArray(item.pages) ? item.pages : [];
        const pages = (sourcePages.length ? sourcePages : [{ slots: [] }]).map((page) => {
          const sourceSlots = Array.isArray(page) ? page : Array.isArray(page?.slots) ? page.slots : [];
          return { slots: Array.from({ length: layout.capacity }, (_, index) => normalizeAlbumSlot(sourceSlots[index], cards)) };
        });
        const firstSlot = pages.flatMap((page) => page.slots).find(Boolean);
        return {
          _id: item._id || uid('album'),
          albumId: item.albumId || item.id || item._id || uid('album-id'),
          _isNew: item._isNew ?? false,
          _isDirty: item._isDirty ?? false,
          name: item.name || 'Álbum sem nome',
          description: item.description || '',
          format: layout.format,
          columns: layout.columns,
          rows: layout.rows,
          pages,
          imageCandidates: Array.isArray(item.imageCandidates) ? item.imageCandidates : firstSlot?.imageCandidates || [],
        };
      };

      const makeState = (profile, items = {}, source = 'new') => {
        const cards = (items.cards || []).map((item) => normalizeCard(item, false));
        const boosters = (items.boosters || []).map((item) => normalizeBooster(item, false));
        return {
          profile: { owner: '', title: '', description: '', email: '', phone: '', password: '', selling: true, showQuantity: true, featured: false, version: 1, ...profile },
          cards, boosters,
          kits: (items.kits || []).map((item) => normalizeKit(item, cards, boosters)),
          albums: (items.albums || []).map((item) => normalizeAlbum(item, cards)),
          kitDraft: [], source,
        };
      };

      const setMode = (mode) => {
        modeButtons.forEach((button) => button.classList.toggle('active', button.dataset.editorMode === mode));
        panels.forEach((panel) => { panel.hidden = panel.dataset.startPanel !== mode; });
      };
      modeButtons.forEach((button) => button.addEventListener('click', () => setMode(button.dataset.editorMode)));

      const activate = (profile, items, source = 'new') => {
        state = makeState(profile, items, source);
        modeButtons.forEach((button) => { button.hidden = true; });
        panels.forEach((panel) => { panel.hidden = true; });
        root.querySelector('[data-editor-notice]').hidden = true;
        root.classList.add('is-editing');
        workspace.hidden = false;
        root.querySelector('[data-workspace-title]').textContent = state.profile.title;
        root.querySelector('[data-workspace-meta]').textContent = `${state.profile.owner} · versão ${state.profile.version}`;
        root.querySelector('[data-show-quantity]').checked = state.profile.showQuantity !== false;
        root.querySelector('[data-collection-selling]').checked = state.profile.selling !== false;
        root.querySelector('[data-version-number]').textContent = String(state.profile.version);
        if (updateButton) updateButton.hidden = source === 'new';
        activeTab = 'cards'; inventoryQuery = ''; if (inventorySearch) inventorySearch.value = '';
        render();
        workspace.scrollIntoView({ behavior: 'smooth', block: 'start' });
      };

      const tabLabel = { cards: 'Cartas', boosters: 'Boosters', kits: 'Kits', albums: 'Álbuns' };
      const allPricedItems = () => state ? [...state.cards, ...state.boosters, ...state.kits] : [];
      const updateOverview = () => {
        if (!state) return;
        const totalUnits = [...state.cards, ...state.boosters, ...state.kits].reduce((sum, item) => sum + toQuantity(item.quantity), 0);
        const value = allPricedItems().reduce((sum, item) => sum + (itemPrice(item) || 0) * toQuantity(item.quantity), 0);
        root.querySelector('[data-overview-units]').textContent = `${totalUnits} ${totalUnits === 1 ? 'unidade' : 'unidades'}`;
        root.querySelector('[data-overview-value]').textContent = `${prettyPrice(value)} em preços definidos`;
      };
      const updateTabs = () => {
        if (!state) return;
        root.querySelectorAll('[data-inventory-tab]').forEach((button) => button.classList.toggle('active', button.dataset.inventoryTab === activeTab));
        Object.keys(tabLabel).forEach((kind) => { const count = root.querySelector(`[data-tab-count="${kind}"]`); if (count) count.textContent = String(state[kind].length); });
      };

      const priceInput = (kind, index, field, label, value) => `<label class="inventory-price-field"><span>${label}</span><input type="number" min="0" step="0.01" value="${value ?? ''}" placeholder="—" data-item-edit="${kind}:${index}:${field}" /></label>`;
      const quantityInput = (kind, index, value) => `<label class="inventory-quantity-field"><span>Quantidade</span><input type="number" min="1" step="1" value="${value}" data-item-edit="${kind}:${index}:quantity" /></label>`;
      const saleToggle = (kind, index, checked) => `<label class="inventory-sale-toggle"><input type="checkbox" data-sale-edit="${kind}:${index}" ${checked ? 'checked' : ''} /><span><i></i><b>${checked ? 'À venda' : 'Exposição'}</b></span></label>`;
      const removeButton = (kind, index, name) => `<button type="button" class="inventory-remove" data-remove-item="${kind}:${index}" aria-label="Remover ${escapeHtml(name)}">×</button>`;
      const linkButtons = (links) => {
        const available = links.filter((entry) => entry.url);
        if (!available.length) return '<span class="inventory-no-links">Nenhum link disponível</span>';
        return available.map((entry) => `<a href="${escapeHtml(entry.url)}" target="_blank" rel="noreferrer">${escapeHtml(entry.label)} <span>↗</span></a>`).join('');
      };
      const matchesSearch = (item) => !inventoryQuery || normalizeText(JSON.stringify(item)).includes(inventoryQuery);
      const emptyInventory = (kind) => `<div class="inventory-tab-empty"><span>${kind === 'cards' ? '◇' : kind === 'boosters' ? '▱' : kind === 'kits' ? '▦' : '▤'}</span><strong>Nenhum item nesta aba</strong><p>Use uma das ações acima para adicionar ${tabLabel[kind].toLowerCase()}.</p><button type="button" class="primary-cta" data-empty-add="${kind === 'cards' ? 'card' : kind === 'boosters' ? 'booster' : kind === 'kits' ? 'kit' : 'album'}"><span>Adicionar agora</span><b>＋</b></button></div>`;

      const renderCards = () => {
        const rows = state.cards.map((item, index) => ({ item, index })).filter(({ item }) => matchesSearch(item));
        if (!rows.length) return emptyInventory('cards');
        return `<div class="inventory-sheet inventory-card-sheet"><div class="inventory-sheet-head"><span>Imagem e identificação</span><span>Informações</span><span>Links</span><span>Preços</span><span>Controle</span></div>${rows.map(({ item, index }) => {
          const name = itemName(item, 'cards');
          return `<article class="inventory-record card-inventory-record">
            <div class="inventory-product-cell">${renderImage(item)}<div><strong>${escapeHtml(name)}</strong><small>${escapeHtml(item.number || 'Sem numeração')}</small><em>${escapeHtml(item.collection || 'Coleção a consultar')}</em></div></div>
            <div class="inventory-info-cell"><span>${escapeHtml(item.year || 'Ano —')}</span><span>${escapeHtml(item.condition || 'Estado —')}</span><span>${escapeHtml(item.language || 'Idioma —')}</span><span>${escapeHtml(item.type || 'Tipo —')}</span></div>
            <div class="inventory-links-cell">${linkButtons([{ label: 'Liga', url: item.linkLiga }, { label: 'MYP', url: item.linkMyp }, { label: 'Cardmarket', url: item.linkCardmarket }, { label: 'TCGplayer', url: item.linkTcgplayer }, { label: 'PriceCharting', url: item.linkPriceCharting }])}</div>
            <div class="inventory-prices-cell">${priceInput('cards', index, 'minimumPrice', 'Mínimo', item.minimumPrice)}${priceInput('cards', index, 'quickSalePrice', 'Venda rápida', item.quickSalePrice)}${priceInput('cards', index, 'leaguePrice', 'Liga', item.leaguePrice)}${priceInput('cards', index, 'price', 'Preço', item.price)}</div>
            <div class="inventory-control-cell">${quantityInput('cards', index, item.quantity)}${saleToggle('cards', index, item.forSale)}${removeButton('cards', index, name)}</div>
          </article>`;
        }).join('')}</div>`;
      };

      const renderBoosters = () => {
        const rows = state.boosters.map((item, index) => ({ item, index })).filter(({ item }) => matchesSearch(item));
        if (!rows.length) return emptyInventory('boosters');
        return `<div class="inventory-sheet booster-inventory-sheet"><div class="inventory-sheet-head"><span>Imagem e booster</span><span>Link</span><span>Preços</span><span>Controle</span></div>${rows.map(({ item, index }) => {
          const name = itemName(item, 'boosters');
          return `<article class="inventory-record booster-inventory-record">
            <div class="inventory-product-cell">${renderImage(item)}<div><strong>${escapeHtml(name)}</strong><small>Pacote lacrado</small></div></div>
            <div class="inventory-links-cell">${linkButtons([{ label: 'Liga', url: item.linkLiga }])}</div>
            <div class="inventory-prices-cell">${priceInput('boosters', index, 'minimumPrice', 'Mínimo', item.minimumPrice)}${priceInput('boosters', index, 'quickSalePrice', 'Venda rápida', item.quickSalePrice)}${priceInput('boosters', index, 'leaguePrice', 'Liga', item.leaguePrice)}${priceInput('boosters', index, 'price', 'Preço', item.price)}</div>
            <div class="inventory-control-cell">${quantityInput('boosters', index, item.quantity)}${saleToggle('boosters', index, item.forSale)}${removeButton('boosters', index, name)}</div>
          </article>`;
        }).join('')}</div>`;
      };

      const renderKitContents = (item) => {
        const entries = Array.isArray(item.contentItems) ? item.contentItems : [];
        if (!entries.length) return `<div class="kit-content-text">${escapeHtml(item.contents || 'Conteúdo não estruturado')}</div>`;
        return `<div class="kit-content-grid">${entries.map((entry) => `<div class="kit-content-item">${renderImage(entry, entry.name)}<span><strong>${entry.quantity}×</strong><small>${escapeHtml(entry.name)}</small></span></div>`).join('')}</div>`;
      };
      const renderKits = () => {
        const rows = state.kits.map((item, index) => ({ item, index })).filter(({ item }) => matchesSearch(item));
        if (!rows.length) return emptyInventory('kits');
        return `<div class="kit-inventory-list">${rows.map(({ item, index }) => {
          const gross = toPrice(item.sourceTotal) ?? (item.contentItems || []).reduce((sum, entry) => sum + (entry.unitPrice || 0) * entry.quantity, 0);
          const discountValue = gross > 0 && item.price !== null ? Math.max(0, gross - item.price) : 0;
          const discountPercent = gross > 0 && item.price !== null ? Math.max(0, Math.round((gross - item.price) / gross * 100)) : 0;
          return `<article class="kit-inventory-record">
            <header><div><span class="kit-record-icon">▦</span><div><strong>${escapeHtml(item.name)}</strong><p>${escapeHtml(item.description || 'Kit personalizado')}</p></div></div>${removeButton('kits', index, item.name)}</header>
            <div class="kit-record-body"><section><span class="inventory-cell-label">Conteúdo</span>${renderKitContents(item)}</section><aside><div><span>Preço bruto</span><strong>${prettyPrice(gross)}</strong></div><label><span>Preço final</span><input type="number" min="0" step="0.01" value="${item.price ?? ''}" data-item-edit="kits:${index}:price" /></label><div class="kit-discount-card"><span>Desconto</span><strong>${prettyPrice(discountValue)}</strong><small>${discountPercent}% abaixo do bruto</small></div>${quantityInput('kits', index, item.quantity)}${saleToggle('kits', index, item.forSale)}</aside></div>
          </article>`;
        }).join('')}</div>`;
      };

      const albumOccupied = (album) => (album?.pages || []).reduce((total, page) => total + (page.slots || []).filter(Boolean).length, 0);
      const albumCapacity = (album) => (album?.pages?.length || 1) * (album?.columns || 3) * (album?.rows || 3);
      const renderAlbums = () => {
        const rows = state.albums.map((item, index) => ({ item, index })).filter(({ item }) => matchesSearch(item));
        if (!rows.length) return `<div class="inventory-tab-empty album-empty"><span>▤</span><strong>Nenhum álbum criado</strong><p>Crie um álbum, escolha o formato das páginas e posicione cada carta visualmente.</p><button type="button" class="primary-cta" data-empty-add="album"><span>Criar álbum</span><b>＋</b></button></div>`;
        return `<div class="album-inventory-grid">${rows.map(({ item, index }) => {
          const firstCard = item.pages.flatMap((page) => page.slots).find(Boolean);
          const coverItem = firstCard ? { name: firstCard.name, imageCandidates: firstCard.imageCandidates } : { name: item.name, imageCandidates: item.imageCandidates || [] };
          const occupied = albumOccupied(item);
          const capacity = albumCapacity(item);
          return `<article class="album-inventory-card">${renderImage(coverItem)}<div class="album-inventory-copy"><span class="inventory-cell-label">Álbum ${escapeHtml(item.format.replace('x', ' por '))}</span><h4>${escapeHtml(item.name)}</h4><p>${escapeHtml(item.description || 'Álbum virtual da coleção')}</p><div class="album-progress"><span>Organização</span><strong>${occupied} / ${capacity} espaços</strong><i style="--album-editor-progress:${capacity ? Math.round(occupied / capacity * 100) : 0}%"></i></div><button type="button" class="album-organize-button" data-organize-album="${index}"><span>▤</span> Organizar páginas <b>→</b></button></div>${removeButton('albums', index, item.name)}</article>`;
        }).join('')}</div>`;
      };

      const currentAlbum = () => state?.albums?.[activeAlbumIndex] || null;
      const albumSlotFromCard = (card) => ({
        cardId: card._id,
        linkLiga: card.linkLiga || '',
        language: card.language || '',
        condition: card.condition || '',
        name: itemName(card, 'cards'),
        number: card.number || '',
        collection: card.collection || '',
        imageCandidates: [...(card.imageCandidates || [])],
      });
      const markAlbumDirty = (album) => { if (album) album._isDirty = true; };
      const renderAlbumOrganizer = (direction = 0) => {
        const album = currentAlbum();
        if (!album) return;
        const page = album.pages[activeAlbumPage] || album.pages[0];
        const pageElement = root.querySelector('[data-album-editor-page]');
        const pageWrap = root.querySelector('[data-album-editor-page-wrap]');
        const library = root.querySelector('[data-album-card-library]');
        root.querySelector('[data-album-organizer-title]').textContent = album.name;
        root.querySelector('[data-album-format-label]').textContent = `Formato ${album.format.replace('x', ' por ')}`;
        root.querySelector('[data-album-page-counter]').textContent = `Página ${activeAlbumPage + 1} de ${album.pages.length}`;
        const occupied = albumOccupied(album);
        const capacity = albumCapacity(album);
        root.querySelector('[data-album-progress-label]').textContent = `${occupied} / ${capacity} espaços`;
        root.querySelector('[data-album-organizer-summary]').textContent = `${occupied} ${occupied === 1 ? 'carta organizada' : 'cartas organizadas'}`;
        root.querySelector('[data-album-page-previous]').disabled = activeAlbumPage === 0;
        root.querySelector('[data-album-page-next]').disabled = activeAlbumPage >= album.pages.length - 1;
        root.querySelector('[data-album-remove-page]').disabled = album.pages.length === 1;
        if (pageElement) {
          pageElement.style.setProperty('--album-columns', String(album.columns));
          pageElement.style.setProperty('--album-rows', String(album.rows));
          pageElement.innerHTML = page.slots.map((slot, slotIndex) => slot ? `<button type="button" class="album-editor-slot occupied" data-album-slot="${slotIndex}" title="Clique para remover ${escapeHtml(slot.name)}">${renderImage(slot)}<span><strong>${escapeHtml(slot.name)}</strong><small>${escapeHtml(slot.number || slot.collection || 'Carta')}</small></span><b>×</b></button>` : `<button type="button" class="album-editor-slot empty ${selectedAlbumCardId ? 'ready' : ''}" data-album-slot="${slotIndex}"><span>${slotIndex + 1}</span><small>${selectedAlbumCardId ? 'Colocar aqui' : 'Espaço vazio'}</small></button>`).join('');
        }
        if (direction && pageWrap) {
          pageWrap.classList.remove('turn-forward', 'turn-backward');
          void pageWrap.offsetWidth;
          pageWrap.classList.add(direction > 0 ? 'turn-forward' : 'turn-backward');
        }
        const cards = state.cards.filter((card) => !albumCardQuery || normalizeText(`${itemName(card, 'cards')} ${card.number} ${card.collection}`).includes(albumCardQuery));
        root.querySelector('[data-album-library-count]').textContent = `${cards.length} ${cards.length === 1 ? 'carta' : 'cartas'}`;
        if (library) library.innerHTML = cards.length ? cards.map((card) => `<button type="button" draggable="true" class="album-library-card ${selectedAlbumCardId === card._id ? 'selected' : ''}" data-album-library-card="${card._id}">${renderImage(card)}<span><strong>${escapeHtml(itemName(card, 'cards'))}</strong><small>${escapeHtml(card.number || card.collection || 'Carta da coleção')}</small></span><b>${selectedAlbumCardId === card._id ? '✓' : '＋'}</b></button>`).join('') : '<div class="album-library-empty"><span>◇</span><strong>Nenhuma carta encontrada</strong><p>Adicione cartas à coleção ou ajuste a busca.</p></div>';
      };
      const openAlbumOrganizer = (index) => {
        if (!state?.albums?.[index]) return;
        activeAlbumIndex = index;
        activeAlbumPage = 0;
        albumCardQuery = '';
        selectedAlbumCardId = '';
        const search = root.querySelector('[data-album-card-search]');
        if (search) search.value = '';
        openModal('album-organizer');
        renderAlbumOrganizer();
      };
      const placeAlbumCard = (slotIndex, cardId) => {
        const album = currentAlbum();
        const card = state?.cards?.find((item) => item._id === cardId);
        const page = album?.pages?.[activeAlbumPage];
        if (!album || !card || !page || slotIndex < 0 || slotIndex >= page.slots.length) return;
        page.slots[slotIndex] = albumSlotFromCard(card);
        markAlbumDirty(album);
        renderAlbumOrganizer();
        renderInventory();
      };

      const renderInventory = () => {
        if (!state) return;
        inventory.innerHTML = activeTab === 'cards' ? renderCards() : activeTab === 'boosters' ? renderBoosters() : activeTab === 'kits' ? renderKits() : renderAlbums();
      };

      const sourceProducts = () => state ? [
        ...state.cards.map((item) => ({ kind: 'cards', item })),
        ...state.boosters.map((item) => ({ kind: 'boosters', item })),
      ] : [];
      const addDraftProduct = (kind, itemId) => {
        if (!state) return;
        const source = state[kind]?.find((item) => item._id === itemId);
        if (!source) return;
        const existing = state.kitDraft.find((entry) => entry.kind === kind && entry.itemId === itemId);
        if (existing) existing.quantity += 1;
        else state.kitDraft.push({ kind, itemId, name: itemName(source, kind), quantity: 1, unitPrice: itemPrice(source), imageCandidates: [...(source.imageCandidates || [])] });
        renderKitBuilder();
      };
      const kitGross = () => state ? state.kitDraft.reduce((sum, entry) => sum + (entry.unitPrice || 0) * entry.quantity, 0) : 0;
      const renderKitBuilder = () => {
        if (!state) return;
        const bank = root.querySelector('[data-kit-product-bank]');
        const selected = root.querySelector('[data-kit-selected-items]');
        if (!bank || !selected) return;
        const products = sourceProducts().filter(({ kind, item }) => (kitFilter === 'all' || kitFilter === kind) && (!kitQuery || normalizeText(itemName(item, kind)).includes(kitQuery)));
