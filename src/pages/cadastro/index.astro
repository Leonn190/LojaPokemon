      root.querySelector('[data-card-form]')?.addEventListener('submit', (event) => { event.preventDefault(); const form = event.currentTarget; if (!form.reportValidity() || !state) return; const data = new FormData(form); const linkLiga = clean(data.get('linkLiga')); state.cards.push({ name: getNameFromLink(linkLiga, 'Carta da Liga'), number: '', collection: '', language: clean(data.get('language')), condition: clean(data.get('condition')), quantity: Number(data.get('quantity')), price: toPrice(data.get('price')), forSale: data.get('forSale') === 'on', linkLiga, _isNew: true }); form.reset(); form.querySelector('[name="quantity"]').value = 1; form.querySelector('[name="forSale"]').checked = true; render(); });
      root.querySelector('[data-booster-form]')?.addEventListener('submit', (event) => { event.preventDefault(); const form = event.currentTarget; if (!form.reportValidity() || !state) return; const data = new FormData(form); const linkLiga = clean(data.get('linkLiga')); state.boosters.push({ name: getNameFromLink(linkLiga, 'Booster da Liga'), quantity: Number(data.get('quantity')), price: toPrice(data.get('price')), forSale: data.get('forSale') === 'on', linkLiga, _isNew: true }); form.reset(); form.querySelector('[name="quantity"]').value = 1; form.querySelector('[name="forSale"]').checked = true; render(); });
      root.querySelector('[data-legacy-kit-form]')?.addEventListener('submit', () => {});
      root.querySelectorAll('[data-open-add]').forEach((button) => button.addEventListener('click', () => { const panel = root.querySelector('[data-add-product-panel]'); const kind = button.dataset.openAdd; panel.hidden = false; root.querySelector('[data-card-form]').hidden = kind !== 'card'; root.querySelector('[data-booster-form]').hidden = kind !== 'booster'; panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' }); }));
      root.querySelector('[data-open-kit-builder]')?.addEventListener('click', () => { root.querySelector('[data-kit-builder]').hidden = false; root.querySelector('[data-editor-inventory]').hidden = true; root.querySelector('[data-add-product-panel]').hidden = true; root.querySelector('[data-kit-builder]').scrollIntoView({ behavior: 'smooth', block: 'start' }); renderKitBuilder(); });
      root.querySelector('[data-close-kit-builder]')?.addEventListener('click', () => { root.querySelector('[data-kit-builder]').hidden = true; root.querySelector('[data-editor-inventory]').hidden = false; });
      root.querySelector('[data-kit-product-bank]')?.addEventListener('dragstart', (event) => { const card = event.target.closest('[data-kit-product]'); if (card) event.dataTransfer.setData('text/plain', card.dataset.kitProduct); });
      root.querySelector('[data-kit-product-bank]')?.addEventListener('click', (event) => { const card = event.target.closest('[data-kit-product]'); if (!card || !state) return; const [kind, rawIndex] = card.dataset.kitProduct.split(':'); state.kitDraft.push({ kind, index: Number(rawIndex) }); renderKitBuilder(); });
      const kitDrop = root.querySelector('[data-kit-drop-zone]'); kitDrop?.addEventListener('dragover', (event) => { event.preventDefault(); kitDrop.classList.add('dragging'); }); kitDrop?.addEventListener('dragleave', () => kitDrop.classList.remove('dragging')); kitDrop?.addEventListener('drop', (event) => { event.preventDefault(); kitDrop.classList.remove('dragging'); if (!state) return; const [kind, rawIndex] = event.dataTransfer.getData('text/plain').split(':'); if (kind && Number.isInteger(Number(rawIndex))) { state.kitDraft.push({ kind, index: Number(rawIndex) }); renderKitBuilder(); } });
      root.querySelector('[data-kit-selected-items]')?.addEventListener('click', (event) => { const button = event.target.closest('[data-remove-kit-item]'); if (!button || !state) return; state.kitDraft.splice(Number(button.dataset.removeKitItem), 1); renderKitBuilder(); });
      root.querySelector('[data-kit-price]')?.addEventListener('input', renderKitBuilder);
      root.querySelector('[data-kit-form]')?.addEventListener('submit', (event) => { event.preventDefault(); const form = event.currentTarget; if (!form.reportValidity() || !state || !state.kitDraft.length) return; const data = new FormData(form); const chosen = state.kitDraft.map((entry) => state[entry.kind]?.[entry.index]).filter(Boolean); const sourceTotal = chosen.reduce((sum, item) => sum + (item.price ?? 0), 0); state.kits.push({ name: clean(data.get('name')), description: clean(data.get('description')), contents: chosen.map((item) => productName(item, 'cards')).join(' | '), quantity: Number(data.get('quantity')), price: toPrice(data.get('price')), sourceTotal, forSale: data.get('forSale') === 'on' }); state.kitDraft = []; form.reset(); form.querySelector('[name="quantity"]').value = 1; form.querySelector('[name="forSale"]').checked = true; root.querySelector('[data-kit-builder]').hidden = true; root.querySelector('[data-editor-inventory]').hidden = false; render(); });
      inventory.addEventListener('input', (event) => { const target = event.target; const [kind, rawIndex] = (target.dataset.priceEdit || '').split(':'); if (!kind || !state) return; state[kind][Number(rawIndex)].price = toPrice(target.value); renderKitBuilder(); });
      inventory.addEventListener('change', (event) => { const target = event.target; const [kind, rawIndex] = (target.dataset.saleEdit || '').split(':'); if (!kind || !state) return; state[kind][Number(rawIndex)].forSale = target.checked; });
      inventory.addEventListener('click', (event) => { const button = event.target.closest('[data-remove-item]'); if (!button || !state) return; const [kind, rawIndex] = button.dataset.removeItem.split(':'); state[kind].splice(Number(rawIndex), 1); render(); });
      root.querySelector('[data-show-quantity]')?.addEventListener('change', (event) => { if (state) state.profile.showQuantity = event.target.checked; });
      root.querySelector('[data-collection-selling]')?.addEventListener('change', (event) => { if (state) state.profile.selling = event.target.checked; });
