---
import BaseLayout from '../../layouts/BaseLayout.astro';

const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
---

<BaseLayout
  title="Entrar"
  description="Entre na sua conta do Vault TCG ou crie uma nova conta."
  active="signup"
  bodyClass="auth-page"
>
  <section class="auth-page-shell" data-auth-page data-base={base}>
    <div class="auth-page-intro" data-reveal>
      <span class="hero-badge"><i></i> Conta Vault</span>
      <h1>Entre no Vault TCG.</h1>
      <p>Esta página é somente para acesso e criação de conta. Depois de entrar, sua coleção é gerenciada em uma Central própria.</p>
      <div class="auth-page-points">
        <span><b>01</b> Acesse sua conta</span>
        <span><b>02</b> Vá para a Central de Coleções</span>
        <span><b>03</b> Edite inventário, propostas e aparência</span>
      </div>
    </div>

    <div class="auth-page-card" data-reveal>
      <div class="editor-mode-tabs auth-mode-tabs" role="tablist" aria-label="Acesso à conta">
        <button type="button" class="active" data-auth-mode="login">Entrar</button>
        <button type="button" data-auth-mode="signup">Criar conta</button>
      </div>

      <section class="auth-panel" data-auth-panel="login">
        <div class="form-section-heading"><span class="section-eyebrow">Bem-vindo de volta</span><h2>Entrar</h2><p>Use o e-mail e a senha da sua conta.</p></div>
        <form class="editor-profile-form published-login" data-login-form>
          <label class="form-field"><span>E-mail</span><input name="login" type="email" autocomplete="email" required /></label>
          <label class="form-field"><span>Senha</span><input name="password" type="password" autocomplete="current-password" required /></label>
          <button class="primary-cta" type="submit"><span>Entrar</span><b>→</b></button>
        </form>
        <p class="import-feedback" data-login-feedback></p>
      </section>

      <section class="auth-panel" data-auth-panel="signup" hidden>
        <div class="form-section-heading"><span class="section-eyebrow">Nova conta</span><h2>Crie sua conta</h2><p>Sua conta já nasce com uma coleção, que pode permanecer privada e vazia.</p></div>
        <form class="editor-profile-form auth-signup-form" data-signup-form>
          <label class="form-field"><span>Seu nome</span><input name="owner" required placeholder="Ex.: Ana Silva" /></label>
          <label class="form-field"><span>Nome da coleção</span><input name="title" required placeholder="Ex.: Coleção da Ana" /></label>
          <label class="form-field"><span>E-mail</span><input name="email" type="email" autocomplete="email" required placeholder="voce@email.com" /></label>
          <label class="form-field"><span>Telefone (opcional)</span><input name="phone" autocomplete="tel" placeholder="(00) 00000-0000" /></label>
          <label class="form-field"><span>Senha</span><input name="password" type="password" autocomplete="new-password" minlength="6" required /></label>
          <label class="modal-sale-check"><input name="public" type="checkbox" /><span><strong>Deixar a coleção pública</strong><small>Se ficar desmarcado, somente você poderá acessar a coleção pela Central.</small></span></label>
          <fieldset class="proposal-terms-form new-proposal-terms">
            <legend>Política inicial de propostas</legend>
            <label class="form-field"><span>Regra principal</span><select name="proposalPolicy" required><option value="flexible">Sou flexível quanto às regras</option><option value="none">Não aceito nenhuma proposta</option><option value="fixed_price_multi_only">Sem proposta para cartas com preço definido e somente com mais de um produto</option><option value="no_defined_price">Sem proposta para cartas com preço definido</option><option value="multi_only">Propostas apenas com mais de um produto</option></select></label>
            <label class="proposal-flexible-check"><input name="flexibleDiscounts" type="checkbox" checked /><span><strong>Descontos flexíveis</strong><small>Os marcos abaixo funcionam como referência quando esta opção está ativa.</small></span></label>
            <div class="proposal-tier-heading"><strong>Marcos de desconto</strong><small>Opcional.</small></div>
            <div class="proposal-tier-rows">
              <div><label><span>A partir de R$</span><input name="tierMin" type="number" min="0" step="0.01" placeholder="100" /></label><label><span>Máximo de desconto</span><div><input name="tierDiscount" type="number" min="0" max="100" step="0.1" placeholder="5" /><b>%</b></div></label></div>
              <div><label><span>A partir de R$</span><input name="tierMin" type="number" min="0" step="0.01" placeholder="250" /></label><label><span>Máximo de desconto</span><div><input name="tierDiscount" type="number" min="0" max="100" step="0.1" placeholder="8" /><b>%</b></div></label></div>
              <div><label><span>A partir de R$</span><input name="tierMin" type="number" min="0" step="0.01" placeholder="500" /></label><label><span>Máximo de desconto</span><div><input name="tierDiscount" type="number" min="0" max="100" step="0.1" placeholder="10" /><b>%</b></div></label></div>
            </div>
          </fieldset>
          <button class="primary-cta" type="submit"><span>Criar conta</span><b>→</b></button>
        </form>
        <p class="import-feedback" data-signup-feedback></p>
      </section>
    </div>
  </section>

  <script>
  import '../../scripts/pages/auth-page.js';
</script>
</BaseLayout>
