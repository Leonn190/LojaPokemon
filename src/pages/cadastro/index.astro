---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEditableCollections } from '../../lib/catalog';

const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const publishedCollections = getEditableCollections();
---

<BaseLayout
  title="Criar ou editar coleção"
  description="Monte, importe ou edite sua coleção Pokémon e gere o ZIP para aprovação."
  active="signup"
  bodyClass="signup-page"
>
  <section class="signup-hero editor-hero">
    <div class="shell signup-hero-grid">
      <div data-reveal>
        <span class="hero-badge"><i></i> Central de coleções</span>
        <h1>Crie, edite e envie seu acervo.</h1>
        <p>O ZIP gerado é a solicitação de publicação. Envie-o para <strong>alexeidostoievsky@gmail.com</strong> e peça formalmente a aprovação da sua coleção no site.</p>
      </div>
      <div class="signup-steps" data-reveal>
        <article><span>01</span><div><strong>Comece do seu jeito</strong><p>Crie uma coleção, importe um ZIP anterior ou entre em uma coleção publicada.</p></div></article>
        <article><span>02</span><div><strong>Organize os produtos</strong><p>Adicione cartas, boosters e kits; defina venda, preço e estoque exibido.</p></div></article>
        <article><span>03</span><div><strong>Envie para aprovação</strong><p>Baixe a versão numerada do ZIP e mande-a por e-mail para publicação.</p></div></article>
      </div>
    </div>
  </section>

  <section class="shell collection-editor" data-editor-root data-base={base} data-published={JSON.stringify(publishedCollections)}>
    <div class="editor-mode-tabs" role="tablist" aria-label="Forma de iniciar uma coleção">
      <button type="button" class="active" data-editor-mode="new">Criar do zero</button>
      <button type="button" data-editor-mode="import">Importar ZIP</button>
      <button type="button" data-editor-mode="published">Editar coleção publicada</button>
    </div>

    <div class="editor-notice" data-editor-notice>
      <span>i</span><p>Os dados ficam somente no seu navegador até você baixar o ZIP. Como este é um site estático, a validação de e-mail e senha serve para controlar a interface, não substitui autenticação em servidor.</p>
    </div>

    <section class="editor-start-panel" data-start-panel="new">
      <div class="form-section-heading"><span class="section-eyebrow">Nova coleção</span><h2>Dados do colecionador</h2><p>Todos os campos são obrigatórios. Depois você poderá cadastrar os produtos.</p></div>
      <form class="editor-profile-form" data-new-profile-form>
        <label class="form-field"><span>Nome</span><input name="owner" required placeholder="Ex.: Ana Silva" /></label>
        <label class="form-field"><span>Nome da coleção</span><input name="title" required placeholder="Ex.: Acervo da Ana" /></label>
        <label class="form-field"><span>Gmail</span><input name="email" type="email" required placeholder="voce@gmail.com" /></label>
        <label class="form-field"><span>Número de telefone</span><input name="phone" required placeholder="(00) 00000-0000" /></label>
        <label class="form-field"><span>Senha</span><input name="password" type="password" minlength="4" required /></label>
        <label class="form-field"><span>Descrição (opcional)</span><input name="description" placeholder="Conte um pouco sobre o seu acervo" /></label>
        <button class="primary-cta" type="submit"><span>Continuar para os produtos</span><b>→</b></button>
      </form>
    </section>

    <section class="editor-start-panel" data-start-panel="import" hidden>
      <div class="form-section-heading"><span class="section-eyebrow">ZIP já formatado</span><h2>Continue uma versão anterior</h2><p>Selecione um ZIP gerado nesta central. A nova edição será exportada com o próximo número de versão.</p></div>
      <label class="zip-drop-zone" data-zip-drop><input type="file" accept=".zip,application/zip" data-zip-input /><span>↑</span><strong>Solte o ZIP aqui ou clique para escolher</strong><small>O arquivo não é enviado para nenhum servidor.</small></label>
      <p class="import-feedback" data-import-feedback></p>
    </section>

    <section class="editor-start-panel" data-start-panel="published" hidden>
      <div class="form-section-heading"><span class="section-eyebrow">Coleções aprovadas</span><h2>Entre para editar</h2><p>Use seu Gmail <em>ou</em> número de telefone e a senha vinculada. A coleção correta é encontrada automaticamente.</p></div>
      <form class="editor-profile-form published-login" data-published-login>
        <label class="form-field"><span>Gmail ou número de telefone</span><input name="login" required /></label>
        <label class="form-field"><span>Senha</span><input name="password" type="password" required /></label>
        <button class="primary-cta" type="submit"><span>Autorizar edição</span><b>→</b></button>
      </form>
      <p class="import-feedback" data-login-feedback></p>
    </section>

    <section class="editor-workspace" data-editor-workspace hidden>
      <header class="editor-workspace-header">
        <div><span class="section-eyebrow">Editor da coleção</span><h2 data-workspace-title>Sua coleção</h2><p data-workspace-meta>Versão 1</p></div>
        <button type="button" class="secondary-cta" data-reset-editor><span>Recomeçar</span><b>×</b></button>
      </header>

      <div class="editor-settings">
        <label class="toggle-field"><input type="checkbox" data-show-quantity checked /><span><strong>Mostrar quantidades</strong><small>Exibe o estoque nas páginas públicas.</small></span></label>
        <label class="toggle-field"><input type="checkbox" data-collection-selling checked /><span><strong>Permitir venda</strong><small>Itens marcados à venda poderão entrar no carrinho.</small></span></label>
      </div>

      <div class="editor-action-bar">
        <div><span class="section-eyebrow">Inventário</span><h3>Produtos da coleção</h3></div>
        <div><button type="button" class="secondary-cta" data-open-add="card"><span>Adicionar carta</span><b>＋</b></button><button type="button" class="secondary-cta" data-open-add="booster"><span>Adicionar booster</span><b>＋</b></button><button type="button" class="primary-cta" data-open-kit-builder><span>Criar kit</span><b>▦</b></button></div>
      </div>

      <div class="editor-add-panel" data-add-product-panel hidden>
        <form class="editor-item-form" data-card-form hidden>
          <span class="section-eyebrow">Nova carta</span><h3>Adicionar carta</h3>
          <label><span>Link Liga</span><input name="linkLiga" type="url" required placeholder="https://www.ligapokemon.com.br/..." /></label>
          <label><span>Estado</span><select name="condition" required><option value="NM">NM</option><option value="SP">SP</option><option value="MP">MP</option><option value="HP">HP</option><option value="D">D</option></select></label>
          <label><span>Idioma</span><input name="language" required placeholder="Português (PT-BR)" /></label>
          <label><span>Quantidade</span><input name="quantity" type="number" min="1" value="1" required /></label>
          <label><span>Preço de venda (opcional)</span><input name="price" type="number" min="0" step="0.01" placeholder="Ex.: 45.90" /></label>
          <label class="inline-check"><input name="forSale" type="checkbox" checked /> Disponível para venda</label>
          <button type="submit" class="primary-cta"><span>Adicionar carta</span><b>＋</b></button>
        </form>
        <form class="editor-item-form" data-booster-form hidden>
          <span class="section-eyebrow">Novo booster</span><h3>Adicionar booster</h3>
          <label><span>Link Liga</span><input name="linkLiga" type="url" required placeholder="https://www.ligapokemon.com.br/..." /></label>
          <label><span>Quantidade</span><input name="quantity" type="number" min="1" value="1" required /></label>
          <label><span>Preço de venda (opcional)</span><input name="price" type="number" min="0" step="0.01" placeholder="Ex.: 30.00" /></label>
          <label class="inline-check"><input name="forSale" type="checkbox" checked /> Disponível para venda</label>
          <button type="submit" class="primary-cta"><span>Adicionar booster</span><b>＋</b></button>
        </form>
      </div>

      <div class="editor-inventory" data-editor-inventory></div>

      <section class="kit-builder" data-kit-builder hidden>
        <header><div><span class="section-eyebrow">Construtor de kit</span><h3>Arraste produtos para montar o kit</h3><p>O desconto é calculado usando os preços individuais publicados.</p></div><button type="button" class="secondary-cta" data-close-kit-builder><span>Voltar ao inventário</span><b>×</b></button></header>
        <div class="kit-builder-grid"><div class="kit-product-bank" data-kit-product-bank></div><form class="kit-drop-form" data-kit-form><div class="kit-drop-zone" data-kit-drop-zone><span>↓</span><strong>Solte os produtos aqui</strong><small data-kit-drop-count>Nenhum produto selecionado</small></div><div class="kit-selected-items" data-kit-selected-items></div><label><span>Nome do kit</span><input name="name" required placeholder="Ex.: Kit Evoluções" /></label><label><span>Descrição</span><textarea name="description" rows="3" required placeholder="O que torna este kit especial?"></textarea></label><div class="kit-fields"><label><span>Quantidade</span><input name="quantity" type="number" min="1" value="1" required /></label><label><span>Preço do kit</span><input name="price" type="number" min="0" step="0.01" required data-kit-price /></label></div><div class="kit-discount" data-kit-discount>Adicione produtos com preço para calcular o desconto.</div><label class="inline-check"><input name="forSale" type="checkbox" checked /> Disponível para venda</label><button type="submit" class="primary-cta"><span>Salvar kit</span><b>＋</b></button></form></div>
      </section>
      <div class="editor-export-panel"><div><span class="section-eyebrow">Pronto para aprovação</span><h3>Baixe o ZIP da versão <b data-version-number>1</b></h3><p>O ZIP completo substitui a versão da coleção. O update contém somente as cartas e boosters adicionados nesta edição.</p></div><div class="editor-export-actions"><button type="button" class="secondary-cta" data-download-update hidden><span>Baixar só o update</span><b>＋</b></button><button type="button" class="primary-cta" data-download-zip><span>Baixar ZIP completo</span><b>↓</b></button></div></div>
    </section>
  </section>

  <script is:inline>
    (() => {
      const root = document.querySelector('[data-editor-root]');
      if (!root) return;
      const published = JSON.parse(root.dataset.published || '[]');
      const panels = [...root.querySelectorAll('[data-start-panel]')];
      const modeButtons = [...root.querySelectorAll('[data-editor-mode]')];
      const workspace = root.querySelector('[data-editor-workspace]');
      const inventory = root.querySelector('[data-editor-inventory]');
      const updateButton = root.querySelector('[data-download-update]');
      const csvHeaders = {
        cards: ['Nome', 'Numeração', 'Coleção', 'Idioma', 'Estado', 'Ano', 'Link Liga', 'Preço', 'Quantidade', 'À venda'],
        boosters: ['Coleção', 'Link Liga', 'Preço', 'Quantidade', 'À venda'],
        kits: ['Nome', 'Descrição', 'Conteúdo', 'Quantidade', 'Preço', 'Valor avulso', 'À venda'],
      };
      let state = null;
      const clean = (value) => String(value ?? '').trim();
      const toPrice = (value) => { const parsed = Number(String(value ?? '').replace(',', '.')); return Number.isFinite(parsed) ? parsed : null; };
      const prettyPrice = (value) => value === null ? 'Preço pela Liga' : new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(value);
      const safeSlug = (value) => clean(value).normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/gi, '-').replace(/(^-|-$)/g, '').toLowerCase() || 'colecao';
      const getNameFromLink = (link, fallback) => {
        try { const card = new URL(link).searchParams.get('card'); return clean(card).replace(/\([^)]*\)/g, '').replace(/[-+]/g, ' ') || fallback; } catch (_) { return fallback; }
      };
      const existingItems = (items) => [...(items || [])].map((item) => ({ ...item, _isNew: false }));
      const makeState = (profile, items = {}, source = 'new') => ({
        profile: { owner: '', title: '', description: '', email: '', phone: '', password: '', selling: true, showQuantity: true, featured: false, version: 1, ...profile },
        cards: existingItems(items.cards), boosters: existingItems(items.boosters), kits: existingItems(items.kits), kitDraft: [], source,
      });
      const activate = (profile, items, source = 'new') => {
        state = makeState(profile, items, source);
        modeButtons.forEach((button) => { button.hidden = true; });
        panels.forEach((panel) => { panel.hidden = true; });
        root.querySelector('[data-editor-notice]').hidden = true;
        root.classList.add('is-editing');
        workspace.hidden = false;
        root.querySelector('[data-workspace-title]').textContent = state.profile.title;
        root.querySelector('[data-workspace-meta]').textContent = `${state.profile.owner} · versão ${state.profile.version}`;
        root.querySelector('[data-show-quantity]').checked = state.profile.showQuantity !== false;
        root.querySelector('[data-collection-selling]').checked = state.profile.selling !== false;
        root.querySelector('[data-version-number]').textContent = String(state.profile.version);
        if (updateButton) updateButton.hidden = source === 'new';
        workspace.scrollIntoView({ behavior: 'smooth', block: 'start' });
        render();
      };
      const escapeHtml = (value) => clean(value).replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[char]));
      const renderItems = (kind, items) => {
        const label = kind === 'cards' ? 'Cartas' : kind === 'boosters' ? 'Boosters' : 'Kits';
        const rows = items.length ? items.map((item, index) => {
          const name = item.name || item.collection || 'Produto da Liga';
          const details = kind === 'cards' ? `${item.condition} · ${item.language} · ${item.quantity} un.` : kind === 'boosters' ? `${item.quantity} un.` : `${item.quantity} un. · ${item.contents}`;
          return `<li><div><strong>${escapeHtml(name)}</strong><small>${escapeHtml(details)}</small></div><label>Preço <input data-price-edit="${kind}:${index}" type="number" min="0" step="0.01" value="${item.price ?? ''}" placeholder="Liga" /></label><label class="mini-sale"><input data-sale-edit="${kind}:${index}" type="checkbox" ${item.forSale !== false ? 'checked' : ''} /> À venda</label><button type="button" data-remove-item="${kind}:${index}" aria-label="Remover ${escapeHtml(name)}">×</button></li>`;
        }).join('') : '<li class="inventory-empty">Nenhum item cadastrado.</li>';
        return `<section class="inventory-group"><h3>${label} <span>${items.length}</span></h3><ul>${rows}</ul></section>`;
      };
      const legacyRender = () => {
        if (!state) return;
        inventory.innerHTML = renderItems('cards', state.cards) + renderItems('boosters', state.boosters) + renderItems('kits', state.kits);
        const select = root.querySelector('[data-kit-contents]');
        const products = [...state.cards.map((item, index) => ({ value: `Carta: ${item.name || getNameFromLink(item.linkLiga, 'nova carta')} #${index + 1}`, label: `Carta · ${item.name || getNameFromLink(item.linkLiga, 'nova carta')}` })), ...state.boosters.map((item, index) => ({ value: `Booster: ${item.name || getNameFromLink(item.linkLiga, 'novo booster')} #${index + 1}`, label: `Booster · ${item.name || getNameFromLink(item.linkLiga, 'novo booster')}` }))];
        select.replaceChildren(...products.map((product) => { const option = document.createElement('option'); option.value = product.value; option.textContent = product.label; return option; }));
      };
      const productName = (item, kind) => item.name || item.collection || getNameFromLink(item.linkLiga, kind === 'cards' ? 'Carta da Liga' : 'Booster da Liga');
      const renderSheet = (kind, items) => {
        const card = kind === 'cards'; const kit = kind === 'kits';
        const headers = card ? ['Produto', 'Número', 'Coleção', 'Idioma', 'Estado', 'Link Liga', 'Qtd.', 'Preço', 'Venda', ''] : kit ? ['Kit', 'Descrição', 'Produtos', 'Qtd.', 'Preço', 'Desconto', 'Venda', ''] : ['Booster', 'Link Liga', 'Qtd.', 'Preço', 'Venda', ''];
        const rows = items.map((item, index) => {
          const name = productName(item, kind); const price = `<input data-price-edit="${kind}:${index}" type="number" min="0" step="0.01" value="${item.price ?? ''}" placeholder="Liga" />`; const sale = `<label class="mini-sale"><input data-sale-edit="${kind}:${index}" type="checkbox" ${item.forSale !== false ? 'checked' : ''} /> Sim</label>`; const remove = `<button type="button" data-remove-item="${kind}:${index}">×</button>`;
          if (card) return `<tr><td><strong>${escapeHtml(name)}</strong></td><td>${escapeHtml(item.number || '—')}</td><td>${escapeHtml(item.collection || 'A consultar')}</td><td>${escapeHtml(item.language)}</td><td><b class="sheet-condition">${escapeHtml(item.condition)}</b></td><td><a href="${escapeHtml(item.linkLiga)}" target="_blank" rel="noreferrer">Abrir ↗</a></td><td>${item.quantity}</td><td>${price}</td><td>${sale}</td><td>${remove}</td></tr>`;
          if (kit) { const total = Number(item.sourceTotal || 0); const discount = total > 0 && item.price !== null ? Math.max(0, total - item.price) : null; return `<tr><td><strong>${escapeHtml(name)}</strong></td><td>${escapeHtml(item.description || '—')}</td><td>${escapeHtml(item.contents || '—')}</td><td>${item.quantity}</td><td>${price}</td><td>${discount === null ? '—' : `${prettyPrice(discount)} (${Math.round(discount / total * 100)}%)`}</td><td>${sale}</td><td>${remove}</td></tr>`; }
          return `<tr><td><strong>${escapeHtml(name)}</strong></td><td><a href="${escapeHtml(item.linkLiga)}" target="_blank" rel="noreferrer">Abrir ↗</a></td><td>${item.quantity}</td><td>${price}</td><td>${sale}</td><td>${remove}</td></tr>`;
        }).join('') || `<tr><td colspan="${headers.length}" class="spreadsheet-empty">Nenhum item cadastrado.</td></tr>`;
        const title = card ? 'Cartas' : kit ? 'Kits criados' : 'Boosters';
        return `<section class="spreadsheet"><header><h3>${title} <span>${items.length}</span></h3></header><div class="table-scroll"><table><thead><tr>${headers.map((header) => `<th>${header}</th>`).join('')}</tr></thead><tbody>${rows}</tbody></table></div></section>`;
      };
      const renderKitBuilder = () => {
        const bank = root.querySelector('[data-kit-product-bank]'); const selected = root.querySelector('[data-kit-selected-items]'); const count = root.querySelector('[data-kit-drop-count]'); if (!bank || !selected || !state) return;
        const products = [...state.cards.map((item, index) => ({ kind: 'cards', index, item })), ...state.boosters.map((item, index) => ({ kind: 'boosters', index, item }))];
        bank.innerHTML = products.map((product) => `<button type="button" draggable="true" data-kit-product="${product.kind}:${product.index}"><span class="kit-product-art">${escapeHtml(productName(product.item, product.kind).slice(0, 2).toUpperCase())}</span><strong>${escapeHtml(productName(product.item, product.kind))}</strong><small>${prettyPrice(product.item.price)}</small></button>`).join('') || '<p>Nenhuma carta ou booster para adicionar.</p>';
        const chosen = state.kitDraft.map((entry) => state[entry.kind]?.[entry.index]).filter(Boolean); selected.innerHTML = chosen.map((item, index) => `<span>${escapeHtml(productName(item, 'cards'))}<button type="button" data-remove-kit-item="${index}">×</button></span>`).join(''); count.textContent = chosen.length ? `${chosen.length} produto(s) selecionado(s)` : 'Nenhum produto selecionado';
        const total = chosen.reduce((sum, item) => sum + (item.price ?? 0), 0); const kitPrice = toPrice(root.querySelector('[data-kit-price]')?.value); const message = root.querySelector('[data-kit-discount]'); message.textContent = total > 0 && kitPrice !== null ? `Itens separados: ${prettyPrice(total)} · desconto: ${prettyPrice(Math.max(0, total - kitPrice))} (${Math.max(0, Math.round((total - kitPrice) / total * 100))}%)` : 'Adicione produtos com preço e defina o preço do kit para calcular o desconto.';
      };
      const render = () => { if (!state) return; inventory.innerHTML = renderSheet('cards', state.cards) + renderSheet('boosters', state.boosters) + renderSheet('kits', state.kits); renderKitBuilder(); };
      const setMode = (mode) => {
        modeButtons.forEach((button) => button.classList.toggle('active', button.dataset.editorMode === mode));
        panels.forEach((panel) => { panel.hidden = panel.dataset.startPanel !== mode; });
      };
      modeButtons.forEach((button) => button.addEventListener('click', () => setMode(button.dataset.editorMode)));
      root.querySelector('[data-new-profile-form]')?.addEventListener('submit', (event) => {
        event.preventDefault(); const form = event.currentTarget; if (!form.reportValidity()) return;
        const data = new FormData(form); const profile = Object.fromEntries(data.entries()); profile.collectionId = safeSlug(profile.title); activate(profile, undefined, 'new');
      });
      root.querySelector('[data-published-login]')?.addEventListener('submit', (event) => {
        event.preventDefault(); const form = event.currentTarget; const values = new FormData(form); const login = clean(values.get('login')).toLowerCase(); const collection = published.find((item) => login === clean(item.profile.email).toLowerCase() || login === clean(item.profile.phone).toLowerCase()); const feedback = root.querySelector('[data-login-feedback]');
        if (!collection || values.get('password') !== collection.profile.password) { feedback.textContent = 'Gmail/número ou senha incorretos para uma coleção autorizada.'; return; }
        feedback.textContent = ''; activate({ ...collection.profile, version: Number(collection.profile.version || 1) + 1 }, collection, 'published');
      });
      const csv = (headers, rows) => [headers, ...rows.map((row) => headers.map((header) => `"${String(row[header] ?? '').replaceAll('"', '""')}"`))].map((row) => row.join(',')).join('\r\n');
      const crc32 = (bytes) => { let crc = -1; for (const byte of bytes) { crc ^= byte; for (let bit = 0; bit < 8; bit += 1) crc = (crc >>> 1) ^ (0xedb88320 & -(crc & 1)); } return (crc ^ -1) >>> 0; };
      const u16 = (value) => Uint8Array.of(value & 255, (value >>> 8) & 255);
      const u32 = (value) => Uint8Array.of(value & 255, (value >>> 8) & 255, (value >>> 16) & 255, (value >>> 24) & 255);
      const merge = (parts) => { const length = parts.reduce((sum, part) => sum + part.length, 0); const result = new Uint8Array(length); let offset = 0; parts.forEach((part) => { result.set(part, offset); offset += part.length; }); return result; };
      const zipStore = (files) => { const encoder = new TextEncoder(); let offset = 0; const local = []; const central = []; files.forEach(([name, text]) => { const filename = encoder.encode(name); const data = encoder.encode(text); const crc = crc32(data); local.push(merge([u32(0x04034b50), u16(20), u16(0), u16(0), u16(0), u16(0), u32(crc), u32(data.length), u32(data.length), u16(filename.length), u16(0), filename, data])); central.push(merge([u32(0x02014b50), u16(20), u16(20), u16(0), u16(0), u16(0), u16(0), u32(crc), u32(data.length), u32(data.length), u16(filename.length), u16(0), u16(0), u16(0), u16(0), u32(0), u32(offset), filename])); offset += local[local.length - 1].length; }); const directory = merge(central); return merge([...local, directory, u32(0x06054b50), u16(0), u16(0), u16(files.length), u16(files.length), u32(directory.length), u32(offset), u16(0)]); };
      const read16 = (data, offset) => data[offset] | (data[offset + 1] << 8);
      const read32 = (data, offset) => (data[offset] | (data[offset + 1] << 8) | (data[offset + 2] << 16) | (data[offset + 3] << 24)) >>> 0;
