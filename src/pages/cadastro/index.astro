      const downloadZip = (zip, filename) => { const link = document.createElement('a'); link.href = URL.createObjectURL(new Blob([zip], { type: 'application/zip' })); link.download = filename; link.click(); setTimeout(() => URL.revokeObjectURL(link.href), 0); };
      root.querySelector('[data-download-zip]')?.addEventListener('click', () => {
