---
import BaseLayout from '../../layouts/BaseLayout.astro';
import OnlineCatalogBrowser from '../../components/OnlineCatalogBrowser.astro';
---
<BaseLayout title="Boosters da comunidade" description="Pesquise boosters Pokémon publicados por colecionadores no Vault TCG." active="boosters">
  <section class="catalog-hero booster-catalog-hero"><div class="shell catalog-hero-grid"><div data-reveal><span class="hero-badge"><i></i> Catálogo online</span><h1>Boosters da comunidade</h1><p>Os boosters das coleções públicas são carregados diretamente do Firestore. Alterações feitas pelo dono passam a valer online sem novo deploy.</p></div><div class="catalog-hero-stats" data-reveal><div><strong>Online</strong><span>dados na nuvem</span></div><div><strong>Seguro</strong><span>edição só pelo dono</span></div></div></div></section>
  <OnlineCatalogBrowser kind="booster" />
</BaseLayout>
