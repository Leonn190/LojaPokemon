---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CatalogBrowser from '../../components/CatalogBrowser.astro';
import { getBoosters, getCollections } from '../../lib/catalog';

const boosters = getBoosters();
const collections = getCollections();
const totalUnits = boosters.reduce((total, item) => total + item.quantity, 0);
---

<BaseLayout
  title="Boosters da comunidade"
  description="Pesquise boosters Pokémon publicados por colecionadores no Nexus TCG."
  active="boosters"
>
  <section class="catalog-hero booster-catalog-hero">
    <div class="shell catalog-hero-grid">
      <div data-reveal>
        <span class="hero-badge"><i></i> {totalUnits} pacotes publicados</span>
        <h1>Boosters da comunidade</h1>
        <p>Encontre pacotes lacrados em várias coleções. Abra qualquer item para ver o preço, o estoque e a página do colecionador responsável.</p>
      </div>
      <div class="catalog-hero-stats" data-reveal>
        <div><strong>{boosters.length}</strong><span>tipos de pacote</span></div>
        <div><strong>{totalUnits}</strong><span>unidades totais</span></div>
        <div><strong>{collections.length}</strong><span>coleções participantes</span></div>
      </div>
    </div>
  </section>

  <CatalogBrowser kind="booster" items={boosters} />
</BaseLayout>
