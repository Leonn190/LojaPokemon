---
import BaseLayout from '../layouts/BaseLayout.astro';
const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
---

<BaseLayout title="Página não encontrada">
  <section class="shell not-found-section">
    <span class="section-eyebrow">Erro 404</span>
    <h1>Esse item não foi encontrado.</h1>
    <p>O endereço pode ter mudado. Cartas, boosters e kits abrem em uma subtela dentro das páginas de pesquisa, enquanto cada colecionador possui uma página própria.</p>
    <div class="hero-actions">
      <a class="primary-cta" href={base}><span>Voltar ao início</span><b>←</b></a>
      <a class="secondary-cta" href={`${base}cartas/`}><span>Explorar cartas</span><b>↗</b></a>
    </div>
  </section>
  <script is:inline>
    (() => {
      const path = window.location.pathname;
      const base = document.body.dataset.siteBase || '/';
      const collectionMatch = path.match(/\/colecoes\/([^/]+)\/?$/);
      if (collectionMatch) {
        window.location.replace(`${base}colecao/?slug=${encodeURIComponent(decodeURIComponent(collectionMatch[1]))}`);
        return;
      }
      const albumMatch = path.match(/\/albuns\/([^/]+)\/([^/]+)\/?$/);
      if (albumMatch) {
        window.location.replace(`${base}album/?collection=${encodeURIComponent(decodeURIComponent(albumMatch[1]))}&album=${encodeURIComponent(decodeURIComponent(albumMatch[2]))}`);
      }
    })();
  </script>
</BaseLayout>
