---
import BaseLayout from '../../layouts/BaseLayout.astro';
const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
---
<BaseLayout title="Coleção" description="Coleção pública no Vault TCG." active="collections" bodyClass="collection-profile-page">
  <div class="collector-theme" data-online-collection-page style="--collector-primary:#54e8df;--collector-secondary:#bc91ff;--collector-accent:#f4c25c;">
    <div class="collector-theme-atmosphere" aria-hidden="true">{Array.from({ length: 18 }).map((_, index) => <i style={`--particle-index:${index}`}></i>)}</div>
    <div class="collector-favorite-backdrop" data-online-collection-backdrop aria-hidden="true"></div>
    <section class="collection-profile-hero">
      <div class="shell collection-profile-grid">
        <div class="collection-profile-copy" data-reveal>
          <nav class="breadcrumbs" aria-label="Navegação estrutural"><a href={base}>Início</a><span>/</span><a href={`${base}colecoes/`}>Coleções</a><span>/</span><strong data-profile-owner>Carregando…</strong></nav>
          <div class="profile-identity"><span class="profile-avatar" data-profile-avatar>VT</span><div><small>Colecionador no Vault</small><strong data-profile-owner-name>Carregando…</strong></div><span class="profile-sale-status" data-profile-sale-status>Conectando</span></div>
          <h1 data-profile-title>Coleção</h1>
          <p data-profile-description>Carregando coleção…</p>
          <div class="profile-actions"><a class="primary-cta" href="#itens" data-explore-button hidden><span>Explorar a coleção</span><b>↓</b></a><button class="secondary-cta share-collection-button" type="button" data-share-collection><span>Compartilhar coleção</span><b>↗</b></button></div>
          <div class="profile-stats profile-stats-with-albums">
            <div><strong data-stat-cards>0</strong><span>cartas</span></div><div><strong data-stat-boosters>0</strong><span>boosters</span></div><div><strong data-stat-kits>0</strong><span>kits</span></div><div><strong data-stat-albums>0</strong><span>álbuns</span></div><div><strong data-stat-products>0</strong><span>produtos</span></div>
          </div>
          <aside class="public-proposal-terms"><div><span class="section-eyebrow">Termos de proposta</span><strong data-proposal-policy>Carregando…</strong></div><p data-proposal-detail>Para enviar uma proposta, entre na sua conta.</p><span>O envio de propostas exige autenticação.</span></aside>
        </div>
        <div class="profile-cover profile-cover-flow" data-reveal>
          <div class="profile-cover-glow" aria-hidden="true"></div>
          <div class="collection-flow collection-flow-placeholder online-profile-cover" data-online-profile-cover aria-hidden="true"><span>VAULT TCG</span><strong data-cover-title>Coleção</strong><small>Acervo do colecionador</small></div>
          <div class="profile-value-card"><small>Valor real dos itens da coleção</small><strong data-profile-value>Carregando…</strong><span>cartas, boosters e produtos, sem contar kits novamente</span></div>
        </div>
      </div>
    </section>

    <main id="itens" class="shell online-collection-content" data-online-collection-content hidden>
      <section class="collection-online-section" data-section="albums" hidden><div class="section-heading"><div><span class="section-eyebrow">Álbuns</span><h2>Álbuns publicados</h2></div></div><div class="albums-catalog-grid" data-grid="albums"></div></section>
      <section class="collection-online-section" data-section="cards" hidden><div class="section-heading"><div><span class="section-eyebrow">Cartas</span><h2>Cartas da coleção</h2></div></div><div class="catalog-grid" data-grid="cards"></div></section>
      <section class="collection-online-section" data-section="boosters" hidden><div class="section-heading"><div><span class="section-eyebrow">Boosters</span><h2>Boosters da coleção</h2></div></div><div class="catalog-grid" data-grid="boosters"></div></section>
      <section class="collection-online-section" data-section="kits" hidden><div class="section-heading"><div><span class="section-eyebrow">Kits</span><h2>Kits da coleção</h2></div></div><div class="catalog-grid" data-grid="kits"></div></section>
      <section class="collection-online-section" data-section="products" hidden><div class="section-heading"><div><span class="section-eyebrow">Produtos</span><h2>Produtos da coleção</h2></div></div><div class="catalog-grid" data-grid="products"></div></section>
      <div class="empty-state" data-collection-is-empty hidden><span>◇</span><h2>Coleção vazia</h2><p>Esta conta optou por publicar o perfil, mas ainda não adicionou itens.</p></div>
    </main>
    <section class="shell" data-collection-error hidden><div class="empty-state show"><span>!</span><h2 data-error-title>Não foi possível abrir a coleção</h2><p data-error-message>Confira o endereço e tente novamente.</p><a class="primary-cta" href={`${base}colecoes/`}><span>Voltar às coleções</span><b>←</b></a></div></section>
  </div>

  <script>
    import { albumMarkup, collectionFlowMarkup, escapeHtml, formatBRL, initializeOnlineImages, productMarkup, toImageUrl } from '../../scripts/online-markup';
    const root = document.querySelector<HTMLElement>('[data-online-collection-page]');
    const params = new URLSearchParams(location.search);
    const slug = params.get('slug') || location.pathname.match(/\/colecoes\/([^/]+)/)?.[1] || '';
    const policyLabels: Record<string, string> = {
      flexible: 'Aceita propostas flexíveis',
      none: 'Não aceita propostas',
      fixed_price_multi_only: 'Propostas apenas em múltiplos itens sem preço fixo',
      no_defined_price: 'Propostas somente em itens sem preço definido',
      multi_only: 'Propostas apenas com mais de um item',
    };
    const setText = (selector: string, value: unknown) => { const el = root?.querySelector<HTMLElement>(selector); if (el) el.textContent = String(value ?? ''); };
    const showError = (title: string, message: string) => {
      root?.querySelector<HTMLElement>('[data-online-collection-content]')?.setAttribute('hidden', '');
      const box = root?.querySelector<HTMLElement>('[data-collection-error]'); if (box) box.hidden = false;
      setText('[data-error-title]', title); setText('[data-error-message]', message);
      setText('[data-profile-value]', 'Indisponível');
    };
    const load = async () => {
      try {
        if (!slug) throw new Error('Endereço da coleção ausente.');
        const cloud = (window as any).VaultCloud;
        if (!cloud) throw new Error('Coleção ainda não foi inicializada.');
        const data = await cloud.loadCollectionBySlug(decodeURIComponent(slug));
        if (!data) throw new Error('Esta coleção não existe.');
        const profile = data.profile || {};
        const palette = Array.isArray(profile.palette) ? profile.palette : ['#54e8df','#bc91ff','#f4c25c'];
        root?.style.setProperty('--collector-primary', palette[0] || '#54e8df'); root?.style.setProperty('--collector-secondary', palette[1] || '#bc91ff'); root?.style.setProperty('--collector-accent', palette[2] || '#f4c25c');
        document.title = `${profile.title || 'Coleção'} · Vault TCG`;
        setText('[data-profile-owner]', profile.owner || 'Colecionador'); setText('[data-profile-owner-name]', profile.owner || 'Colecionador'); setText('[data-profile-title]', profile.title || 'Minha coleção'); setText('[data-cover-title]', profile.title || 'Minha coleção'); setText('[data-profile-description]', profile.description || 'Coleção publicada no Vault TCG.');
        setText('[data-profile-sale-status]', profile.selling === false ? 'Coleção para exposição' : 'Itens selecionados à venda');
        const sale = root?.querySelector<HTMLElement>('[data-profile-sale-status]'); sale?.classList.toggle('selling', profile.selling !== false); sale?.classList.toggle('showcase-only', profile.selling === false);
        const avatar = root?.querySelector<HTMLElement>('[data-profile-avatar]'); if (avatar) { const photo = toImageUrl(profile.profilePhoto || ''); if (photo) { avatar.classList.add('has-photo'); avatar.innerHTML = `<img src="${photo.replace(/"/g,'&quot;')}" alt="" />`; } else avatar.textContent = String(profile.owner || 'VT').slice(0,2).toUpperCase(); }
        const coverPlaceholder = root?.querySelector<HTMLElement>('[data-online-profile-cover]');
        if (coverPlaceholder) {
          const holder = document.createElement('div');
          holder.innerHTML = collectionFlowMarkup(data.cards || [], false);
          const flow = holder.firstElementChild as HTMLElement | null;
          if (flow) { coverPlaceholder.replaceWith(flow); initializeOnlineImages(flow); }
        }
        const ambientCards = [...(data.cards || [])]
          .filter((card: any) => Array.isArray(card.imageCandidates) && card.imageCandidates.length)
          .sort((a: any, b: any) => Number(Boolean(b.favorite)) - Number(Boolean(a.favorite)) || Number(b.price || 0) - Number(a.price || 0))
          .slice(0, 10);
        const backdrop = root?.querySelector<HTMLElement>('[data-online-collection-backdrop]');
        if (backdrop) {
          backdrop.innerHTML = ambientCards.map((card: any, index: number) => `<img src="${escapeHtml(toImageUrl(card.imageCandidates[0]))}" alt="" loading="lazy" style="--favorite-index:${index}" />`).join('');
        }
        setText('[data-stat-cards]', data.cards.length); setText('[data-stat-boosters]', data.boosters.length); setText('[data-stat-kits]', data.kits.length); setText('[data-stat-albums]', data.albums.length); setText('[data-stat-products]', data.products.length);
        const terms = profile.proposalTerms || {}; setText('[data-proposal-policy]', policyLabels[terms.policy] || 'Aceita propostas');
        setText('[data-proposal-detail]', terms.flexibleDiscounts === false && Array.isArray(terms.discountTiers) && terms.discountTiers.length ? terms.discountTiers.map((tier: any) => `A partir de R$ ${Number(tier.minValue || 0).toFixed(2).replace('.', ',')}: até ${Number(tier.maxDiscount || 0)}%`).join(' · ') : 'Entre na sua conta para montar e enviar uma proposta.');
        const estimatedValue = Number(profile.stats?.estimatedValue ?? [...(data.cards || []), ...(data.boosters || []), ...(data.products || [])].reduce((sum: number, item: any) => sum + Math.max(0, Number(item.quantity || 0)) * Math.max(0, Number(item.price || 0)), 0));
        setText('[data-profile-value]', formatBRL(estimatedValue));
        const groups: Record<string, any[]> = { albums: data.albums, cards: data.cards, boosters: data.boosters, kits: data.kits, products: data.products };
        let total = 0;
        Object.entries(groups).forEach(([key, items]) => {
          total += items.length;
          const section = root?.querySelector<HTMLElement>(`[data-section="${key}"]`); const grid = root?.querySelector<HTMLElement>(`[data-grid="${key}"]`);
          if (!section || !grid || items.length === 0) return;
          section.hidden = false; grid.innerHTML = key === 'albums' ? items.map((item) => albumMarkup(item)).join('') : items.map((item) => productMarkup(item, { hideOwner: true })).join(''); initializeOnlineImages(grid);
        });
        const content = root?.querySelector<HTMLElement>('[data-online-collection-content]'); if (content) content.hidden = false;
        const empty = root?.querySelector<HTMLElement>('[data-collection-is-empty]'); if (empty) empty.hidden = total !== 0;
        const explore = root?.querySelector<HTMLElement>('[data-explore-button]'); if (explore) explore.hidden = total === 0;
      } catch (error: any) {
        showError(error?.message === 'Esta coleção é privada.' ? 'Coleção privada' : 'Não foi possível abrir a coleção', error?.message || 'Tente novamente em alguns instantes.');
      }
    };
    root?.querySelector('[data-share-collection]')?.addEventListener('click', async () => { try { await navigator.clipboard.writeText(location.href); const button = root.querySelector<HTMLElement>('[data-share-collection] span'); if (button) { const old = button.textContent; button.textContent = 'Link copiado'; setTimeout(() => button.textContent = old, 1800); } } catch (_) {} });
    if ((window as any).VaultCloud) load(); else window.addEventListener('vault:cloud-ready', load, { once: true });
  </script>
</BaseLayout>
