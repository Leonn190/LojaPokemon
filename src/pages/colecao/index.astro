---
import BaseLayout from '../../layouts/BaseLayout.astro';
const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
---
<BaseLayout title="Coleção" description="Coleção pública no Vault TCG." active="collections" bodyClass="collection-profile-page collection-profile-v2-page">
  <div class="collector-theme collector-profile-v2" data-online-collection-page style="--collector-primary:#54e8df;--collector-secondary:#bc91ff;--collector-accent:#f4c25c;">
    <div class="collector-theme-atmosphere" aria-hidden="true">{Array.from({ length: 14 }).map((_, index) => <i style={`--particle-index:${index}`}></i>)}</div>
    <div class="collector-favorite-backdrop" data-online-collection-backdrop aria-hidden="true"></div>

    <section class="collector-profile-hero-v2">
      <div class="shell">
        <nav class="breadcrumbs collector-profile-breadcrumbs" aria-label="Navegação estrutural"><a href={base}>Início</a><span>/</span><a href={`${base}colecoes/`}>Coleções</a><span>/</span><strong data-profile-owner>Carregando…</strong></nav>
        <div class="collector-profile-banner" data-profile-banner aria-hidden="true"><span></span></div>
        <div class="collector-profile-identity-card" data-reveal>
          <div class="collector-profile-avatar-wrap"><span class="profile-avatar collector-profile-avatar" data-profile-avatar>VT</span><i aria-hidden="true"></i></div>
          <div class="collector-profile-main-copy">
            <div class="collector-profile-name-row"><div><small>Colecionador no Vault</small><strong data-profile-owner-name>Carregando…</strong></div><span class="profile-sale-status" data-profile-sale-status>Carregando…</span></div>
            <h1 data-profile-title>Coleção</h1>
          </div>
          <div class="collector-profile-actions">
            <button class="primary-cta" type="button" data-proposal-start hidden><span>Montar proposta</span><b>◇</b></button>
            <button class="secondary-cta share-collection-button" type="button" data-share-collection><span>Compartilhar</span><b>↗</b></button>
          </div>
        </div>

        <div class="collector-profile-quick-stats" data-reveal>
          <article><small>Cartas</small><strong data-stat-cards>—</strong><span>unidades no acervo</span></article>
          <article><small>Boosters</small><strong data-stat-boosters>—</strong><span>unidades lacradas</span></article>
          <article><small>Kits</small><strong data-stat-kits>—</strong><span>itens montados</span></article>
          <article><small>Álbuns</small><strong data-stat-albums>—</strong><span>fichários publicados</span></article>
          <article data-public-value-stat><small>Valor estimado</small><strong data-profile-value>—</strong><span>itens com preço conhecido</span></article>
        </div>
      </div>
    </section>

    <main id="itens" class="shell collector-profile-content-v2" data-online-collection-content hidden>
      <nav class="collector-profile-tabs" id="profile-tabs" aria-label="Conteúdo da coleção" data-profile-tabs>
        <button type="button" class="active" data-profile-tab="overview">Visão geral</button>
        <button type="button" data-profile-tab="cards">Cartas <span data-tab-count="cards">0</span></button>
        <button type="button" data-profile-tab="boosters">Boosters <span data-tab-count="boosters">0</span></button>
        <button type="button" data-profile-tab="kits">Kits <span data-tab-count="kits">0</span></button>
        <button type="button" data-profile-tab="products">Produtos <span data-tab-count="products">0</span></button>
        <button type="button" data-profile-tab="albums">Álbuns <span data-tab-count="albums">0</span></button>
        <button type="button" data-profile-tab="sold">Vendidos <span data-tab-count="sold">0</span></button>
      </nav>

      <section class="collector-profile-panel active" data-profile-panel="overview">
        <div class="collector-overview-grid">
          <section class="collector-overview-card collector-overview-about">
            <header><div><span class="section-eyebrow">Visão geral</span><h2>Sobre este acervo</h2></div></header>
            <div class="collector-overview-facts">
              <article><span>◷</span><div><small>Carta mais antiga</small><strong data-stat-oldest>—</strong></div></article>
              <article><span>◫</span><div><small>Coleções diferentes</small><strong data-stat-sets>—</strong></div></article>
              <article><span>▦</span><div><small>Produtos</small><strong data-stat-products>—</strong></div></article>
              <article><span>◇</span><div><small>Itens à venda</small><strong data-stat-for-sale>—</strong></div></article>
            </div>
            <aside class="public-proposal-terms collector-proposal-summary"><div><span class="section-eyebrow">Termos de proposta</span><strong data-proposal-policy>Carregando…</strong></div><p data-proposal-detail>Para enviar uma proposta, entre na sua conta.</p><span>O envio de propostas exige autenticação.</span></aside>
          </section>
          <section class="collector-overview-card collector-stat-distributions">
            <header><div><span class="section-eyebrow">Composição</span><h2>Como a coleção se distribui</h2></div></header>
            <div class="collector-distribution-block"><div><strong>Raridades / tipos</strong><small>Principais grupos identificados</small></div><div data-rarity-bars></div></div>
            <div class="collector-distribution-block"><div><strong>Coleções / eras</strong><small>Concentração das cartas</small></div><div data-set-bars></div></div>
          </section>
        </div>

        <section class="collector-overview-highlight" data-overview-albums hidden>
          <div class="section-heading"><div><span class="section-eyebrow">Estante</span><h2>Álbuns em destaque</h2><p>Abra um fichário para navegar pelas páginas como um binder.</p></div><button type="button" class="text-link-button" data-open-tab="albums">Ver todos →</button></div>
          <div class="album-virtual-shelf"><div class="albums-catalog-grid album-shelf-grid" data-grid="overview-albums"></div></div>
        </section>

        <section class="collector-overview-highlight" data-overview-cards hidden>
          <div class="section-heading"><div><span class="section-eyebrow">Destaques</span><h2>Cartas da coleção</h2></div><button type="button" class="text-link-button" data-open-tab="cards">Ver todas →</button></div>
          <div class="catalog-grid collector-highlight-grid" data-grid="overview-cards"></div>
        </section>
      </section>

      <section class="collector-profile-panel" data-profile-panel="cards" hidden><div class="section-heading"><div><span class="section-eyebrow">Cartas</span><h2>Cartas da coleção</h2></div></div><div class="catalog-grid" data-grid="cards"></div><div class="empty-state compact" data-panel-empty="cards" hidden><span>◇</span><h2>Nenhuma carta publicada</h2></div></section>
      <section class="collector-profile-panel" data-profile-panel="boosters" hidden><div class="section-heading"><div><span class="section-eyebrow">Boosters</span><h2>Boosters da coleção</h2></div></div><div class="catalog-grid" data-grid="boosters"></div><div class="empty-state compact" data-panel-empty="boosters" hidden><span>◇</span><h2>Nenhum booster publicado</h2></div></section>
      <section class="collector-profile-panel" data-profile-panel="kits" hidden><div class="section-heading"><div><span class="section-eyebrow">Kits</span><h2>Kits da coleção</h2></div></div><div class="catalog-grid" data-grid="kits"></div><div class="empty-state compact" data-panel-empty="kits" hidden><span>◇</span><h2>Nenhum kit publicado</h2></div></section>
      <section class="collector-profile-panel" data-profile-panel="products" hidden><div class="section-heading"><div><span class="section-eyebrow">Produtos</span><h2>Produtos da coleção</h2></div></div><div class="catalog-grid" data-grid="products"></div><div class="empty-state compact" data-panel-empty="products" hidden><span>◇</span><h2>Nenhum produto publicado</h2></div></section>
      <section class="collector-profile-panel" data-profile-panel="albums" hidden><div class="section-heading"><div><span class="section-eyebrow">Estante de álbuns</span><h2>Fichários publicados</h2><p>Cada capa pertence a um álbum. Clique para abrir o binder.</p></div></div><div class="album-virtual-shelf album-virtual-shelf-full"><div class="albums-catalog-grid album-shelf-grid" data-grid="albums"></div></div><div class="empty-state compact" data-panel-empty="albums" hidden><span>▤</span><h2>Nenhum álbum publicado</h2></div></section>
      <section class="collector-profile-panel" data-profile-panel="sold" hidden><div class="section-heading"><div><span class="section-eyebrow">Histórico público</span><h2>Itens vendidos</h2><p>Aparecem aqui apenas itens que continuam publicados com estoque zerado.</p></div></div><div class="catalog-grid" data-grid="sold"></div><div class="empty-state compact" data-panel-empty="sold" hidden><span>✓</span><h2>Nenhum item vendido publicado</h2><p>O histórico administrativo completo permanece privado para o proprietário.</p></div></section>

      <div class="empty-state" data-collection-is-empty hidden><span>◇</span><h2>Coleção vazia</h2><p>Esta conta optou por publicar o perfil, mas ainda não adicionou itens.</p></div>
    </main>
    <section class="shell" data-collection-error hidden><div class="empty-state show"><span>!</span><h2 data-error-title>Não foi possível abrir a coleção</h2><p data-error-message>Confira o endereço e tente novamente.</p><a class="primary-cta" href={`${base}colecoes/`}><span>Voltar às coleções</span><b>←</b></a></div></section>
  </div>

  <script>
  import '../../scripts/pages/collection-page';
</script>
</BaseLayout>
