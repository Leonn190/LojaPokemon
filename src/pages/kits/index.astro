---
import BaseLayout from '../../layouts/BaseLayout.astro';
import OnlineCatalogBrowser from '../../components/OnlineCatalogBrowser.astro';
---
<BaseLayout title="Kits da comunidade" description="Explore kits publicados por colecionadores no Vault TCG." active="kits">
  <section class="catalog-hero"><div class="shell catalog-hero-grid"><div data-reveal><span class="hero-badge"><i></i> Catálogo da comunidade</span><h1>Kits da comunidade</h1><p>Explore combinações de cartas e boosters montadas pelos colecionadores da comunidade.</p></div><div class="catalog-hero-stats" data-reveal><div><strong>Kits</strong><span>ofertas combinadas</span></div><div><strong>Conta</strong><span>necessária para propostas</span></div></div></div></section>
  <OnlineCatalogBrowser kind="kit" />
</BaseLayout>
