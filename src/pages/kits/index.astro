---
import BaseLayout from '../../layouts/BaseLayout.astro';
import OnlineCatalogBrowser from '../../components/OnlineCatalogBrowser.astro';
---
<BaseLayout title="Kits da comunidade" description="Explore kits publicados por colecionadores no Vault TCG." active="kits">
  <section class="catalog-hero"><div class="shell catalog-hero-grid"><div data-reveal><span class="hero-badge"><i></i> Catálogo online</span><h1>Kits da comunidade</h1><p>Kits públicos ficam disponíveis para toda a comunidade; editar, vender ou remover um kit salva a alteração diretamente na nuvem.</p></div><div class="catalog-hero-stats" data-reveal><div><strong>Online</strong><span>sem ZIP</span></div><div><strong>Conta</strong><span>necessária para propostas</span></div></div></div></section>
  <OnlineCatalogBrowser kind="kit" />
</BaseLayout>
