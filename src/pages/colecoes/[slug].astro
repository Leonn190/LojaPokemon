---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CollectionShelf from '../../components/CollectionShelf.astro';
import CollectionFlow from '../../components/CollectionFlow.astro';
import { formatBRL, getCollections, type CollectorCollection } from '../../lib/catalog';

export function getStaticPaths() {
  return getCollections().map((collection) => ({ params: { slug: collection.slug }, props: { collection } }));
}

interface Props { collection: CollectorCollection; }
const { collection } = Astro.props;
const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const initials = collection.owner.slice(0, 2).toUpperCase();
const favoriteCards = collection.cards.filter((card) => card.favorite && card.imageCandidates.length > 0).slice(0, 10);
const [palettePrimary, paletteSecondary, paletteAccent] = collection.palette;
const encodePath = (path: string) => path.split('/').map(encodeURIComponent).join('/');
const imageUrl = (path: string) => /^(?:https?:|data:|blob:)/i.test(path) ? path : `${base}${encodePath(path.replace(/^\/+/, ''))}`;
const proposalPolicyLabels = {
  flexible: 'Sou flexível quanto às regras',
  none: 'Não aceito nenhuma proposta',
  fixed_price_multi_only: 'Sem proposta para cartas precificadas e somente com mais de um produto',
  no_defined_price: 'Sem propostas para cartas com preço definido',
  multi_only: 'Propostas apenas com mais de um produto',
};
const proposalPolicyLabel = proposalPolicyLabels[collection.proposalTerms.policy];
const firstSection = collection.albums.length ? 'albuns' : collection.cards.length ? 'cartas' : collection.boosters.length ? 'boosters' : collection.kits.length ? 'kits' : collection.products.length ? 'produtos' : '';
const albumData = collection.albums.map((album) => ({
  id: album.id,
  name: album.name,
  description: album.description,
  format: album.format,
  columns: album.columns,
  rows: album.rows,
  occupiedSlots: album.occupiedSlots,
  totalSlots: album.totalSlots,
  pages: album.pages.map((page) => ({ slots: page.slots.map((slot) => slot ? {
    name: slot.name,
    number: slot.number,
    collection: slot.collection,
    imageCandidates: slot.imageCandidates,
  } : null) })),
}));
---

<BaseLayout
  title={collection.title}
  description={`${collection.title}: explore cartas, boosters, kits, produtos e álbuns publicados por ${collection.owner}.`}
  active="collections"
  bodyClass="collection-profile-page"
>
  <div class="collector-theme" style={`--collector-primary:${palettePrimary};--collector-secondary:${paletteSecondary};--collector-accent:${paletteAccent};`}>
    {favoriteCards.length > 0 && <div class="collector-favorite-backdrop" aria-hidden="true">{favoriteCards.map((card, index) => <img src={imageUrl(card.imageCandidates[0])} alt="" loading="lazy" style={`--favorite-index:${index}`} />)}</div>}
  <section class="collection-profile-hero">
    <div class="shell collection-profile-grid">
      <div class="collection-profile-copy" data-reveal>
        <nav class="breadcrumbs" aria-label="Navegação estrutural">
          <a href={base}>Início</a><span>/</span><a href={`${base}colecoes/`}>Coleções</a><span>/</span><strong>{collection.owner}</strong>
        </nav>
        <div class="profile-identity">
          <span class:list={['profile-avatar', collection.profilePhoto && 'has-photo']}>{collection.profilePhoto ? <img src={imageUrl(collection.profilePhoto)} alt={`Foto de perfil de ${collection.owner}`} /> : initials}</span>
          <div><small>Colecionador no Nexus</small><strong>{collection.owner}</strong></div>
          <span class:list={['profile-sale-status', collection.selling ? 'selling' : 'showcase-only']}>{collection.selling ? 'Itens selecionados à venda' : 'Coleção para exposição'}</span>
        </div>
        <h1>{collection.title}</h1>
        <p>{collection.description}</p>
        <div class="profile-actions">
          {firstSection ? <a class="primary-cta" href={`#${firstSection}`}><span>Explorar a coleção</span><b>↓</b></a> : <span class="primary-cta disabled"><span>Coleção em preparação</span><b>·</b></span>}
          <button class="secondary-cta share-collection-button" type="button" data-share-collection><span>Compartilhar coleção</span><b>↗</b></button>
        </div>
        <div class="profile-stats profile-stats-with-albums">
          <div><strong>{collection.cards.length}</strong><span>cartas</span></div>
          <div><strong>{collection.boosters.length}</strong><span>boosters</span></div>
          <div><strong>{collection.kits.length}</strong><span>kits</span></div>
          <div><strong>{collection.albums.length}</strong><span>{collection.albums.length === 1 ? 'álbum' : 'álbuns'}</span></div>
          <div><strong>{collection.products.length}</strong><span>produtos</span></div>
        </div>
        <aside class="public-proposal-terms">
          <div><span class="section-eyebrow">Termos de proposta</span><strong>{proposalPolicyLabel}</strong></div>
          <p>{collection.proposalTerms.flexibleDiscounts
            ? 'Os percentuais de desconto são flexíveis e serão avaliados pelo colecionador.'
            : collection.proposalTerms.discountTiers.length
              ? collection.proposalTerms.discountTiers.map((tier) => `A partir de ${formatBRL(tier.minValue)}: até ${tier.maxDiscount}%`).join(' · ')
              : 'Os termos atuais não liberam desconto.'}</p>
          <span>Pagamento indicado: Pix após aceite e confirmação.</span>
        </aside>
      </div>

      <div class="profile-cover profile-cover-flow" data-reveal>
        <div class="profile-cover-glow" aria-hidden="true"></div>
        <CollectionFlow collection={collection} eager />
        <div class="profile-value-card"><small>Valor real dos itens da coleção</small><strong>{formatBRL(collection.estimatedValue)}</strong><span>cartas, boosters e produtos, sem contar kits novamente</span></div>
      </div>
    </div>
  </section>

  {collection.albums.length > 0 && (
    <section id="albuns" class:list={['collection-albums-showcase', collection.albums.length === 1 && 'single-album-showcase']} data-album-root data-albums={JSON.stringify(albumData)}>
      <div class="shell">
        <div class="collection-albums-heading" data-reveal>
          <div><span class="section-eyebrow">Álbuns de {collection.owner}</span><h2>{collection.albums.length === 1 ? 'O álbum da coleção' : 'Álbuns organizados'}</h2><p>{collection.albums.length === 1 ? 'Abra o álbum virtual e navegue página por página.' : 'Cada álbum pode organizar as mesmas cartas de maneiras diferentes.'}</p></div>
          <span class="album-showcase-count">{collection.albums.length} {collection.albums.length === 1 ? 'álbum' : 'álbuns'}</span>
        </div>
        <div class:list={['public-album-grid', collection.albums.length === 1 && 'single']}>
          {collection.albums.map((album) => {
            const previewCards = album.pages.flatMap((page) => page.slots).filter(Boolean).slice(0, 6);
            return (
              <button type="button" class="public-album-card" data-open-album={album.id}>
                <div class="public-album-cover">
                  <div class="album-spine"><span>NEXUS</span></div>
                  <div class="album-cover-grid">
                    {previewCards.map((card) => card && (
                      <span class="album-cover-slot">
                        {card.imageCandidates[0] ? <img src={imageUrl(card.imageCandidates[0])} alt="" loading="lazy" /> : <b>{card.name.slice(0, 2).toUpperCase()}</b>}
                      </span>
                    ))}
                    {Array.from({ length: Math.max(0, 6 - previewCards.length) }).map(() => <span class="album-cover-slot empty"></span>)}
                  </div>
                  <span class="album-cover-shine" aria-hidden="true"></span>
                </div>
                <div class="public-album-copy">
                  <span>{album.format.replace('x', ' por ')} · {album.pages.length} {album.pages.length === 1 ? 'página' : 'páginas'}</span>
                  <h3>{album.name}</h3>
                  <p>{album.description || 'Álbum virtual organizado pelo colecionador.'}</p>
                  <div class="public-album-progress"><i style={`--album-progress:${album.totalSlots ? Math.round(album.occupiedSlots / album.totalSlots * 100) : 0}%`}></i><strong>{album.occupiedSlots} / {album.totalSlots} espaços</strong></div>
                  <b class="public-album-open">Abrir álbum <span>↗</span></b>
                </div>
              </button>
            );
          })}
        </div>
      </div>

      <div class="public-album-modal" data-public-album-modal hidden>
        <button type="button" class="public-album-backdrop" data-close-public-album aria-label="Fechar álbum"></button>
        <section class="public-album-dialog" role="dialog" aria-modal="true" aria-labelledby="public-album-title" tabindex="-1">
          <header class="public-album-dialog-header">
            <div><span class="section-eyebrow">Álbum virtual</span><h2 id="public-album-title" data-public-album-title>Álbum</h2><p data-public-album-description></p></div>
            <button type="button" data-close-public-album aria-label="Fechar">×</button>
          </header>
          <div class="public-album-stage">
            <button type="button" class="album-page-arrow previous" data-public-album-previous aria-label="Páginas anteriores">‹</button>
            <div class="public-album-page-wrap" data-public-album-page-wrap>
              <div class="public-album-book" data-public-album-page aria-live="polite"></div>
              <div class="public-album-rings" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
              <span class="public-album-book-shadow" aria-hidden="true"></span>
            </div>
            <button type="button" class="album-page-arrow next" data-public-album-next aria-label="Próximas páginas">›</button>
          </div>
          <footer class="public-album-footer"><span data-public-album-format></span><strong data-public-album-counter>Página 1 de 1</strong><span data-public-album-filled></span></footer>
        </section>
      </div>
    </section>
  )}

  {firstSection && <nav class="collection-section-nav" aria-label="Seções da coleção">
    <div class="shell">
      {collection.albums.length > 0 && <a href="#albuns">Álbuns <strong>{collection.albums.length}</strong></a>}
      {collection.cards.length > 0 && <a href="#cartas">Cartas <strong>{collection.cards.length}</strong></a>}
      {collection.boosters.length > 0 && <a href="#boosters">Boosters <strong>{collection.boosters.length}</strong></a>}
      {collection.kits.length > 0 && <a href="#kits">Kits <strong>{collection.kits.length}</strong></a>}
      {collection.products.length > 0 && <a href="#produtos">Produtos <strong>{collection.products.length}</strong></a>}
    </div>
  </nav>}

  {collection.cards.length > 0 && <CollectionShelf kind="card" eyebrow={`Cartas de ${collection.owner}`} title="Cartas da coleção" description="Uma seleção passa no carrossel. Abra a busca quando quiser trocar a prévia pelo inventário completo." items={collection.cards} endpoint={`${base}colecoes/dados/${collection.slug}/cards.json`} />}
  {collection.boosters.length > 0 && <CollectionShelf kind="booster" eyebrow={`Boosters de ${collection.owner}`} title="Pacotes lacrados" description="Veja uma prévia dos boosters ou troque o carrossel pela busca completa." items={collection.boosters} endpoint={`${base}colecoes/dados/${collection.slug}/boosters.json`} alternate />}
  {collection.kits.length > 0 && <CollectionShelf kind="kit" eyebrow={`Kits de ${collection.owner}`} title="Conjuntos personalizados" description="Combinações criadas usando itens da própria coleção." items={collection.kits} endpoint={`${base}colecoes/dados/${collection.slug}/kits.json`} />}
  {collection.products.length > 0 && <CollectionShelf kind="product" eyebrow={`Produtos de ${collection.owner}`} title="Produtos lacrados" description="Produtos Pokémon fechados publicados pelo colecionador." items={collection.products} endpoint={`${base}colecoes/dados/${collection.slug}/produtos.json`} alternate />}
  </div>

  <script is:inline>
    (() => {
      const base = document.body.dataset.siteBase || '/';
      const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[character]));
      const normalize = (value) => String(value ?? '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
      const formatBRL = (value) => value === null || value === undefined ? 'Consultar' : new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(Number(value));
      const imageUrl = (path) => /^(?:https?:|data:|blob:)/i.test(path || '') ? path : `${base}${String(path || '').replace(/^\/+/, '').split('/').map(encodeURIComponent).join('/')}`;

      document.querySelector('[data-share-collection]')?.addEventListener('click', async (event) => {
        const button = event.currentTarget;
        const original = button.innerHTML;
        try {
          if (navigator.share) await navigator.share({ title: document.title, url: location.href });
          else await navigator.clipboard.writeText(location.href);
          button.innerHTML = '<span>Link copiado</span><b>✓</b>';
        } catch (_) {}
        setTimeout(() => { button.innerHTML = original; }, 1400);
      });

      const albumRoot = document.querySelector('[data-album-root]');
      if (albumRoot) {
        let albums = [];
        try { albums = JSON.parse(albumRoot.dataset.albums || '[]'); } catch (_) { albums = []; }
        const modal = albumRoot.querySelector('[data-public-album-modal]');
        const pageElement = albumRoot.querySelector('[data-public-album-page]');
        const pageWrap = albumRoot.querySelector('[data-public-album-page-wrap]');
        const previousButton = albumRoot.querySelector('[data-public-album-previous]');
        const nextButton = albumRoot.querySelector('[data-public-album-next]');
        const compactAlbum = window.matchMedia('(max-width: 700px)');
        let activeAlbum = null;
        let activePage = 0;
        let closeTimer = 0;
        let returnFocus = null;

        const pagesPerView = () => compactAlbum.matches ? 1 : 2;
        const albumImageMarkup = (slot) => {
          const urls = (slot.imageCandidates || []).map(imageUrl);
          const primary = urls.shift();
          if (!primary) return `<span>${escapeHtml(String(slot.name || 'TC').slice(0, 2).toUpperCase())}</span>`;
          return `<img src="${escapeHtml(primary)}" alt="${escapeHtml(slot.name || 'Carta')}" loading="lazy" decoding="async" data-album-image-candidates="${escapeHtml(JSON.stringify(urls))}" />`;
        };
        const slotMarkup = (slot, index) => slot
          ? `<article class="public-album-slot"><div>${albumImageMarkup(slot)}</div><small>${escapeHtml(slot.name || 'Carta')}</small><b>${escapeHtml(slot.number || '')}</b></article>`
          : `<div class="public-album-slot empty"><span>${index + 1}</span></div>`;
        const sheetMarkup = (page, pageIndex, side) => {
          const slots = Array.isArray(page?.slots) ? page.slots : [];
          return `<section class="public-album-sheet public-album-sheet-${side}"><header><span>Página ${pageIndex + 1}</span><b>${escapeHtml(activeAlbum.format.replace('x', ' × '))}</b></header><div class="public-album-pocket-grid" style="--album-columns:${activeAlbum.columns};--album-rows:${activeAlbum.rows}">${slots.map(slotMarkup).join('')}</div><span class="public-album-page-texture" aria-hidden="true"></span></section>`;
        };
        const initializeAlbumImages = () => {
          pageElement?.querySelectorAll('img[data-album-image-candidates]').forEach((image) => {
            let candidates = [];
            try { candidates = JSON.parse(image.dataset.albumImageCandidates || '[]'); } catch (_) {}
            image.addEventListener('error', () => {
              const next = candidates.shift();
              if (next) image.src = next;
              else {
                const fallback = document.createElement('span');
                fallback.textContent = (image.alt || 'TC').slice(0, 2).toUpperCase();
                image.replaceWith(fallback);
              }
            });
          });
        };
        const renderAlbum = (direction = 1) => {
          if (!activeAlbum || !pageElement) return;
          const perView = pagesPerView();
          const lastStart = Math.max(0, activeAlbum.pages.length - perView);
          activePage = Math.min(Math.max(0, activePage), lastStart);
          const visiblePages = activeAlbum.pages.slice(activePage, activePage + perView);
          pageElement.classList.toggle('single-page', perView === 1 || visiblePages.length === 1);
          pageElement.innerHTML = visiblePages.map((page, index) => sheetMarkup(page, activePage + index, index === 0 ? 'left' : 'right')).join('');
          initializeAlbumImages();
          pageWrap?.classList.remove('turn-forward', 'turn-backward');
          void pageWrap?.offsetWidth;
          pageWrap?.classList.add(direction >= 0 ? 'turn-forward' : 'turn-backward');
          const finalPage = Math.min(activeAlbum.pages.length, activePage + visiblePages.length);
          const counter = albumRoot.querySelector('[data-public-album-counter]');
          const format = albumRoot.querySelector('[data-public-album-format]');
          const filled = albumRoot.querySelector('[data-public-album-filled]');
          if (counter) counter.textContent = visiblePages.length > 1 ? `Páginas ${activePage + 1}–${finalPage} de ${activeAlbum.pages.length}` : `Página ${activePage + 1} de ${activeAlbum.pages.length}`;
          if (format) format.textContent = `Formato ${activeAlbum.format.replace('x', ' por ')}`;
          if (filled) filled.textContent = `${activeAlbum.occupiedSlots} cartas posicionadas`;
          if (previousButton) previousButton.disabled = activePage === 0;
          if (nextButton) nextButton.disabled = activePage + perView >= activeAlbum.pages.length;
        };
        const openAlbum = (id, trigger) => {
          activeAlbum = albums.find((album) => String(album.id) === String(id));
          if (!activeAlbum || !modal) return;
          window.clearTimeout(closeTimer);
          returnFocus = trigger || document.activeElement;
          activePage = 0;
          const title = albumRoot.querySelector('[data-public-album-title]');
          const description = albumRoot.querySelector('[data-public-album-description]');
          if (title) title.textContent = activeAlbum.name;
          if (description) description.textContent = activeAlbum.description || 'Álbum virtual organizado pelo colecionador.';
          modal.hidden = false;
          modal.setAttribute('aria-hidden', 'false');
          document.body.classList.add('public-album-open');
          renderAlbum();
          requestAnimationFrame(() => {
            modal.classList.add('open');
            modal.querySelector('.public-album-dialog')?.focus?.();
          });
        };
        const closeAlbum = () => {
          if (!modal || modal.hidden) return;
          modal.classList.remove('open');
          modal.setAttribute('aria-hidden', 'true');
          document.body.classList.remove('public-album-open');
          closeTimer = window.setTimeout(() => {
            modal.hidden = true;
            activeAlbum = null;
            returnFocus?.focus?.();
          }, 180);
        };
        albumRoot.addEventListener('click', (event) => {
          const target = event.target instanceof Element ? event.target : null;
          if (!target) return;
          const opener = target.closest('[data-open-album]');
          if (opener) { openAlbum(opener.dataset.openAlbum, opener); return; }
          if (target.closest('[data-close-public-album]')) { closeAlbum(); return; }
          const step = pagesPerView();
          if (target.closest('[data-public-album-previous]') && activePage > 0) { activePage -= step; renderAlbum(-1); return; }
          if (target.closest('[data-public-album-next]') && activeAlbum && activePage + step < activeAlbum.pages.length) { activePage += step; renderAlbum(1); }
        });
        document.addEventListener('keydown', (event) => {
          if (!modal || modal.hidden) return;
          const step = pagesPerView();
          if (event.key === 'Escape') closeAlbum();
          if (event.key === 'ArrowLeft' && activePage > 0) { activePage -= step; renderAlbum(-1); }
          if (event.key === 'ArrowRight' && activeAlbum && activePage + step < activeAlbum.pages.length) { activePage += step; renderAlbum(1); }
        });
        compactAlbum.addEventListener?.('change', () => { if (activeAlbum) renderAlbum(0); });
      }

      const dynamicImage = (candidates, alt = '') => {
        const urls = (Array.isArray(candidates) ? candidates : []).map(imageUrl);
        const primary = urls[0] || '';
        if (!primary) return '';
        return `<img src="${escapeHtml(primary)}" alt="${escapeHtml(alt)}" loading="lazy" decoding="async" data-image-candidates="${escapeHtml(JSON.stringify(urls.slice(1)))}" />`;
      };
      const dynamicVisual = (item) => {
        const initials = item.kind === 'kit' ? 'KIT' : String(item.name || 'TCG').split(/\s+/).filter(Boolean).slice(0, 2).map((part) => part[0]).join('').toUpperCase();
        if (item.kind === 'kit') {
          const contents = (Array.isArray(item.contentItems) ? item.contentItems : []).filter((entry) => Array.isArray(entry.imageCandidates) && entry.imageCandidates.length).slice(0, 3);
          if (contents.length) {
            const units = (item.contentItems || []).reduce((total, entry) => total + Math.max(1, Number(entry.quantity) || 1), 0);
            const stack = contents.map((entry, index) => {
              const entryInitials = String(entry.name || 'TCG').split(/\s+/).filter(Boolean).slice(0, 2).map((part) => part[0]).join('').toUpperCase();
              return `<span class="kit-stack-card kit-stack-card-${index + 1}"><span class="kit-stack-card-surface" data-image-stage><span class="kit-stack-fallback">${escapeHtml(entryInitials || 'TCG')}</span>${dynamicImage(entry.imageCandidates, '')}</span></span>`;
            }).join('');
            return `<div class="collectible-visual kit-visual kit-composite-visual" data-tilt data-tilt-strength="4"><div class="image-stage kit-image-stage"><span class="image-fallback"><b>KIT</b><small>Kit personalizado</small></span><div class="kit-stack" aria-hidden="true">${stack}</div><span class="kit-composite-badge">${units || contents.length} ${units === 1 ? 'item' : 'itens'}</span><span class="kit-composite-shine"></span></div></div>`;
          }
        }
        const image = dynamicImage(item.imageCandidates, item.name || '');
        return `<div class="collectible-visual ${item.kind === 'booster' ? 'booster-visual' : item.kind === 'kit' ? 'kit-visual' : item.kind === 'product' ? 'sealed-product-visual' : ''}" ${item.kind !== 'kit' ? `data-tilt data-tilt-strength="${item.kind === 'booster' ? '3' : item.kind === 'product' ? '4' : '5'}"` : 'data-tilt data-tilt-strength="4"'}><div class="image-stage"><span class="image-fallback"><b>${escapeHtml(initials)}</b><small>${item.kind === 'card' ? 'Carta Pokémon' : item.kind === 'booster' ? 'Booster Pokémon' : item.kind === 'kit' ? 'Kit personalizado' : 'Produto Pokémon'}</small></span>${image}${item.kind === 'card' ? '<span class="foil-spectrum"></span><span class="glare"></span>' : ''}</div></div>`;
      };
      const productMarkup = (item) => {
        const itemType = item.kind === 'card' ? (item.type || 'Carta Pokémon') : item.kind === 'booster' ? 'Booster avulso' : item.kind === 'kit' ? 'Kit personalizado' : 'Produto lacrado';
        const description = item.kind === 'card' ? `<strong>${escapeHtml(item.number || '')}</strong><span>•</span>${escapeHtml(item.collection || '')}` : item.kind === 'kit' || item.kind === 'product' ? escapeHtml(item.description || (item.kind === 'product' ? 'Produto Pokémon lacrado.' : '')) : 'Pacote lacrado publicado pelo colecionador.';
        const policy = item.proposalTerms?.policy || 'flexible';
        const blocksDefinedPrice = policy === 'no_defined_price' || policy === 'fixed_price_multi_only';
        const canPropose = item.forSale && policy !== 'none' && !(item.kind === 'card' && item.price !== null && item.price !== undefined && blocksDefinedPrice);
        const tiers = escapeHtml(JSON.stringify(item.proposalTerms?.discountTiers || []));
        return `<article class="product-card compact-card" data-product-card data-product-id="${escapeHtml(`${item.kind}:${item.slug}`)}" data-kind="${escapeHtml(item.kind)}" data-name="${escapeHtml(item.name)}" data-number="${escapeHtml(item.number || '')}" data-collection="${escapeHtml(item.collection || item.name || '')}" data-language="${escapeHtml(item.language || '')}" data-condition="${escapeHtml(item.condition || '')}" data-year="${escapeHtml(item.year || '')}" data-type="${escapeHtml(itemType)}" data-description="${escapeHtml(item.description || '')}" data-contents="${escapeHtml(item.contents || '')}" data-kit-items="${escapeHtml(JSON.stringify(item.kind === 'kit' ? (item.contentItems || []).map((entry) => ({ name: entry.name, quantity: entry.quantity, imageCandidates: entry.imageCandidates || [] })) : []))}" data-kit-discount="${item.kind === 'kit' && item.sourceTotal > 0 && item.price !== null ? Math.max(0, ((item.sourceTotal - item.price) / item.sourceTotal) * 100).toFixed(1) : '0'}" data-link-liga="${escapeHtml(item.linkLiga || '')}" data-owner="${escapeHtml(item.ownerName)}" data-owner-collection="${escapeHtml(item.ownerCollectionName)}" data-owner-slug="${escapeHtml(item.ownerCollectionSlug)}" data-owner-phone="${escapeHtml(item.ownerPhone || '')}" data-proposal-policy="${escapeHtml(policy)}" data-proposal-flexible="${item.proposalTerms?.flexibleDiscounts !== false ? 'true' : 'false'}" data-proposal-tiers="${tiers}" data-proposal-allowed="${canPropose ? 'true' : 'false'}" data-price-value="${item.price ?? ''}" data-price-label="${escapeHtml(formatBRL(item.price))}" data-stock="${item.quantity}" data-for-sale="${item.forSale ? 'true' : 'false'}" data-show-quantity="${item.kind === 'kit' && item.showQuantity ? 'true' : 'false'}"><button class="product-open-button" type="button" data-open-product><div class="product-card-media">${dynamicVisual(item)}${item.kind === 'kit' && item.showQuantity ? `<span class="quantity-chip">${item.quantity} ${item.quantity === 1 ? 'unidade' : 'unidades'}</span>` : ''}</div><div class="product-card-body"><div class="product-card-heading"><div><span class="product-kicker">${escapeHtml(itemType)}</span><h3>${escapeHtml(item.name)}</h3></div><span class="open-arrow">⌗</span></div><p class="product-description">${description}</p><div class="product-card-footer"><div class="price-block"><small>Preço</small><strong>${escapeHtml(formatBRL(item.price))}</strong></div>${item.kind === 'card' ? `<span class="condition-badge condition-${escapeHtml(normalize(item.condition).replace(/\s+/g, '-'))}">${escapeHtml(item.condition || '')}</span>` : ''}</div></div></button>${canPropose ? '<div class="product-purchase-actions single-action"><button class="add-proposal-button" type="button" data-add-proposal><span>◇</span>Adicionar à proposta</button></div>' : item.forSale ? '<span class="not-for-sale-label">Os termos desta coleção não permitem proposta para este item</span>' : '<span class="not-for-sale-label">Não está à venda</span>'}</article>`;
      };
      const initializeDynamicCards = (container) => {
        container.querySelectorAll('img[data-image-candidates]').forEach((image) => {
          if (image.dataset.dynamicReady) return;
          image.dataset.dynamicReady = 'true';
          const show = () => { image.hidden = false; image.closest('[data-image-stage], .image-stage')?.classList.add('has-image'); };
          const nextCandidate = () => {
            let candidates = [];
            try { candidates = JSON.parse(image.dataset.imageCandidates || '[]'); } catch (_) {}
            const next = candidates.shift();
            if (next) { image.dataset.imageCandidates = JSON.stringify(candidates); image.src = next; }
            else image.remove();
          };
          image.addEventListener('load', show);
          image.addEventListener('error', nextCandidate);
          if (image.complete) image.naturalWidth > 0 ? show() : nextCandidate();
        });
        const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!finePointer || reducedMotion) return;
        container.querySelectorAll('[data-tilt]').forEach((element) => {
          if (element.dataset.dynamicTiltReady) return;
          element.dataset.dynamicTiltReady = 'true';
          element.addEventListener('pointermove', (event) => {
            const bounds = element.getBoundingClientRect();
            const x = Math.max(0, Math.min(1, (event.clientX - bounds.left) / bounds.width));
            const y = Math.max(0, Math.min(1, (event.clientY - bounds.top) / bounds.height));
            const strength = Number(element.dataset.tiltStrength || 5);
            element.style.setProperty('--mx', `${x * 100}%`);
            element.style.setProperty('--my', `${y * 100}%`);
            element.style.setProperty('--ry', `${(x - .5) * strength * 2}deg`);
            element.style.setProperty('--rx', `${(.5 - y) * strength * 2}deg`);
            element.classList.add('is-tilting');
          });
          element.addEventListener('pointerleave', () => {
            element.style.setProperty('--rx', '0deg');
            element.style.setProperty('--ry', '0deg');
            element.style.setProperty('--mx', '50%');
            element.style.setProperty('--my', '50%');
            element.classList.remove('is-tilting');
          });
        });
      };

      document.querySelectorAll('[data-collection-shelf]').forEach((shelf) => {
        const button = shelf.querySelector('[data-expand-shelf]');
        const expanded = shelf.querySelector('[data-expanded-catalog]');
        const preview = shelf.querySelector('[data-shelf-preview]');
        const grid = shelf.querySelector('[data-shelf-grid]');
        const search = shelf.querySelector('[data-shelf-search]');
        const filters = shelf.querySelector('[data-shelf-filters]');
        const count = shelf.querySelector('[data-shelf-count]');
        const kind = shelf.dataset.kind;
        let items = null;
        let loading = false;
        const buildFilters = () => {
          filters.innerHTML = `<label class="shelf-sort-only"><span>Ordenar</span><select data-shelf-sort><option value="name">Nome</option><option value="price-asc">Menor preço</option><option value="price-desc">Maior preço</option></select></label>`;
          filters.querySelector('[data-shelf-sort]')?.addEventListener('change', applyFilters);
        };
        const applyFilters = () => {
          if (!items) return;
          const query = normalize(search.value);
          let visible = items.filter((item) => !query || normalize(`${item.searchText || ''} ${item.name || ''}`).includes(query));
          const sort = filters.querySelector('[data-shelf-sort]')?.value || 'name';
          visible = [...visible].sort((left, right) => sort === 'price-asc' ? (left.price ?? Infinity) - (right.price ?? Infinity) : sort === 'price-desc' ? (right.price ?? -1) - (left.price ?? -1) : String(left.name).localeCompare(String(right.name), 'pt-BR'));
          grid.innerHTML = visible.length ? visible.map(productMarkup).join('') : '<div class="collection-filter-empty"><span>⌕</span><strong>Nenhum item encontrado</strong><p>Tente outro nome ou termo.</p></div>';
          count.textContent = `${visible.length} ${visible.length === 1 ? 'resultado' : 'resultados'}`;
          initializeDynamicCards(grid);
        };
        const load = async () => {
          if (items || loading) return;
          loading = true;
          try {
            const response = await fetch(shelf.dataset.endpoint);
            if (!response.ok) throw new Error('Falha ao carregar');
            items = await response.json();
            buildFilters();
            applyFilters();
          } catch (_) {
            grid.innerHTML = '<div class="collection-filter-empty"><span>!</span><strong>Não foi possível carregar agora</strong><p>Recarregue a página e tente novamente.</p></div>';
            count.textContent = 'Erro no carregamento';
          } finally { loading = false; }
        };
        button?.addEventListener('click', async () => {
          const opening = expanded.hidden;
          expanded.hidden = !opening;
          if (preview) preview.hidden = opening;
          button.classList.toggle('active', opening);
          button.querySelector('span').textContent = opening ? 'Voltar ao carrossel' : 'Pesquisar coleção';
          button.querySelector('b').textContent = opening ? '↩' : '⌕';
          if (opening) { await load(); search?.focus(); shelf.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
        });
        search?.addEventListener('input', applyFilters);
      });
    })();
  </script>
</BaseLayout>
