---
import BaseLayout from '../../layouts/BaseLayout.astro';
const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
---
<BaseLayout title="Coleções da comunidade" description="Conheça os colecionadores do Vault TCG e explore as coleções públicas." active="collections">
  <section class="catalog-hero collections-catalog-hero">
    <div class="shell catalog-hero-grid">
      <div data-reveal><span class="hero-badge"><i></i> Perfis da comunidade</span><h1>Coleções da comunidade</h1><p>Somente contas que escolheram deixar a coleção pública aparecem aqui. Uma conta também pode manter a coleção completamente vazia e privada apenas para comprar e fazer propostas.</p></div>
      <div class="catalog-hero-stats" data-reveal>
        <div><strong data-online-collection-total>0</strong><span>coleções públicas</span></div>
        <div><strong data-online-card-total>0</strong><span>cartas publicadas</span></div>
        <div><strong data-online-booster-total>0</strong><span>boosters publicados</span></div>
      </div>
    </div>
  </section>

  <section class="shell collections-browser" data-online-collections>
    <div class="collections-toolbar" data-reveal>
      <div class="search-control"><label for="collection-search">Pesquisar coleções</label><div class="search-input-wrap"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m21 21-4.35-4.35m2.35-5.65a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z" /></svg><input id="collection-search" type="search" placeholder="Nome do colecionador ou da coleção..." data-collection-search /></div></div>
      <a class="primary-cta" href={`${base}cadastro/`}><span>Entrar / criar conta</span><b>→</b></a>
    </div>
    <div class="collections-summary"><strong data-collection-count>0</strong> <span data-collection-label>coleções encontradas</span> <small data-collection-status>· carregando catálogo…</small></div>
    <div class="collections-grid" data-collections-grid></div>
    <div class="empty-state collection-empty-state" data-collection-empty hidden><span>◇</span><h2>Nenhuma coleção pública</h2><p>Não há resultado para esta busca ou ainda não há coleções públicas cadastradas.</p></div>
  </section>

  <script>
    import { collectionMarkup, initializeOnlineImages, normalizeText } from '../../scripts/online-markup';
    const root = document.querySelector<HTMLElement>('[data-online-collections]');
    if (root) {
      const search = root.querySelector<HTMLInputElement>('[data-collection-search]');
      const grid = root.querySelector<HTMLElement>('[data-collections-grid]');
      const count = root.querySelector<HTMLElement>('[data-collection-count]');
      const label = root.querySelector<HTMLElement>('[data-collection-label]');
      const empty = root.querySelector<HTMLElement>('[data-collection-empty]');
      const status = root.querySelector<HTMLElement>('[data-collection-status]');
      let collections: any[] = [];
      const render = () => {
        const query = normalizeText(search?.value || '');
        const visible = collections
          .filter((profile) => !query || normalizeText(`${profile.owner || ''} ${profile.title || ''} ${profile.description || ''} ${profile.slug || ''}`).includes(query))
          .sort((a, b) => String(a.title || '').localeCompare(String(b.title || ''), 'pt-BR'));
        if (grid) { grid.innerHTML = visible.map((profile) => collectionMarkup(profile)).join(''); initializeOnlineImages(grid); }
        if (count) count.textContent = String(visible.length);
        if (label) label.textContent = visible.length === 1 ? 'coleção encontrada' : 'coleções encontradas';
        if (empty) empty.hidden = visible.length !== 0;
      };
      const load = async () => {
        try {
          const cloud = (window as any).VaultCloud;
          if (!cloud) throw new Error('Catálogo ainda não foi inicializado.');
          const [profiles, publicCards] = await Promise.all([
            cloud.listPublicCollections(),
            cloud.listPublicItems('card'),
          ]);
          const previewMap = new Map<string, any[]>();
          publicCards.forEach((card: any) => {
            [card.collectionUid, card.ownerUid, card.ownerCollectionSlug].filter(Boolean).forEach((key: string) => {
              const list = previewMap.get(String(key)) || [];
              if (list.length < 12) list.push(card);
              previewMap.set(String(key), list);
            });
          });
          collections = profiles.map((profile: any) => {
            const keys = [profile.uid, profile.ownerUid, profile.slug, profile.collectionId].filter(Boolean).map(String);
            const previewCards = keys.flatMap((key) => previewMap.get(key) || []).filter((card, index, list) => list.indexOf(card) === index).slice(0, 12);
            return { ...profile, previewCards };
          });
          const cardTotal = collections.reduce((sum, profile) => sum + Number(profile.stats?.cards || 0), 0);
          const boosterTotal = collections.reduce((sum, profile) => sum + Number(profile.stats?.boosters || 0), 0);
          const totalElement = document.querySelector<HTMLElement>('[data-online-collection-total]');
          const cardElement = document.querySelector<HTMLElement>('[data-online-card-total]');
          const boosterElement = document.querySelector<HTMLElement>('[data-online-booster-total]');
          if (totalElement) totalElement.textContent = String(collections.length);
          if (cardElement) cardElement.textContent = String(cardTotal);
          if (boosterElement) boosterElement.textContent = String(boosterTotal);
          if (status) status.textContent = '· catálogo atualizado';
          render();
        } catch (error: any) {
          if (status) status.textContent = '· catálogo indisponível';
          if (empty) {
            empty.hidden = false;
            const title = empty.querySelector('h2');
            const text = empty.querySelector('p');
            if (title) title.textContent = 'Não foi possível carregar';
            if (text) text.textContent = error?.message || 'Não foi possível carregar as coleções agora.';
          }
        }
      };
      search?.addEventListener('input', render);
      if ((window as any).VaultCloud) load();
      else window.addEventListener('vault:cloud-ready', load, { once: true });
    }
  </script>
</BaseLayout>
