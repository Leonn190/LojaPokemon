---
import BaseLayout from '../../layouts/BaseLayout.astro';
const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
---
<BaseLayout title="Coleções da comunidade" description="Conheça os colecionadores do Vault TCG e explore as coleções públicas." active="collections">
  <section class="catalog-hero collections-catalog-hero">
    <div class="shell catalog-hero-grid">
      <div data-reveal><span class="hero-badge"><i></i> Perfis da comunidade</span><h1>Coleções da comunidade</h1><p>Somente contas que escolheram deixar a coleção pública aparecem aqui. Uma conta também pode manter a coleção completamente vazia e privada apenas para comprar e fazer propostas.</p></div>
    </div>
  </section>

  <section class="shell collections-browser" data-online-collections>
    <div class="explore-search-stack" data-reveal>
      <div class="explore-search-toolbar">
        <div class="search-control explore-main-search"><label for="collection-search">Pesquisar coleções</label><div class="search-input-wrap"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m21 21-4.35-4.35m2.35-5.65a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z" /></svg><input id="collection-search" type="search" placeholder="Nome do colecionador ou da coleção..." data-collection-search /><kbd>/</kbd></div></div>
        <button class="explore-toolbar-button" type="button" data-collection-filter-toggle aria-expanded="false"><span aria-hidden="true">☷</span><strong>Filtros</strong><i data-collection-filter-indicator hidden></i></button>
        <div class="select-control explore-sort-control"><label>Ordenar</label><div class="select-input-wrap"><span class="select-symbol" aria-hidden="true">↕</span><select data-collection-sort><option value="name">Nome A–Z</option><option value="name-desc">Nome Z–A</option><option value="cards-desc">Mais cartas</option><option value="items-desc">Mais itens</option></select><svg class="select-chevron" viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 7.5 4.5 4.5 4.5-4.5" /></svg></div></div>
      </div>
      <div class="explore-filter-drawer compact-explore-filters" data-collection-filter-drawer hidden>
        <div class="select-control"><label>Disponibilidade</label><div class="select-input-wrap"><span class="select-symbol" aria-hidden="true">◇</span><select data-collection-availability><option value="">Todas</option><option value="selling">Com itens à venda</option><option value="showcase">Somente exposição</option></select><svg class="select-chevron" viewBox="0 0 20 20" aria-hidden="true"><path d="m5.5 7.5 4.5 4.5 4.5-4.5" /></svg></div></div>
        <button class="clear-button explore-clear-filters" type="button" data-collection-clear-filters>Limpar filtros</button>
        <a class="explore-account-link" href={`${base}cadastro/`}>Entrar / criar conta <b>→</b></a>
      </div>
    </div>
    <small class="collections-load-status" data-collection-status aria-live="polite"></small>
    <div class="collection-skeleton-grid" data-collection-skeleton aria-hidden="true">
      {Array.from({ length: 6 }, () => <article class="collection-skeleton-card"><div class="collection-skeleton-cover skeleton-pulse"></div><div class="collection-skeleton-copy"><div><i class="skeleton-pulse"></i><b class="skeleton-pulse"></b></div><span class="skeleton-pulse"></span><span class="skeleton-pulse short"></span><em class="skeleton-pulse"></em></div></article>)}
    </div>
    <div class="collections-grid" data-collections-grid hidden></div>
    <div class="catalog-load-sentinel" data-collection-sentinel aria-hidden="true"></div>
    <div class="empty-state collection-empty-state" data-collection-empty hidden><span>◇</span><h2>Nenhuma coleção encontrada</h2><p>Não há coleções para esta busca.</p></div>
  </section>

  <script>
  import '../../scripts/pages/collections-page';
</script>
</BaseLayout>
