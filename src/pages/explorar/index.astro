---
import BaseLayout from '../../layouts/BaseLayout.astro';
const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
---
<BaseLayout title="Explorar" description="Explore cartas, boosters, kits, produtos, álbuns e coleções públicas do Vault TCG." active="explore">
  <section class="catalog-hero explore-hub-hero"><div class="shell explore-hub-heading" data-reveal><span class="hero-badge"><i></i> Vault TCG</span><h1>Explorar</h1><p>Escolha uma área da comunidade ou pesquise todo o catálogo em um só lugar.</p></div></section>

  <section class="shell explore-global-search" data-explore-search data-reveal>
    <label class="explore-search-field" for="explore-global-search"><span aria-hidden="true">⌕</span><input id="explore-global-search" type="search" autocomplete="off" placeholder="Buscar cartas, boosters, kits, produtos, álbuns ou coleções..." data-explore-search-input /><kbd>/</kbd></label>
    <div class="explore-search-meta" data-explore-search-meta hidden><strong data-explore-result-count>—</strong><span data-explore-result-label>resultados</span></div>
    <div class="explore-search-results" data-explore-search-results hidden><div class="explore-search-grid" data-explore-search-grid></div><div class="empty-state explore-search-empty" data-explore-search-empty hidden><span>⌕</span><h2>Nada encontrado</h2><p>Tente outro nome, coleção, número de carta ou colecionador.</p></div></div>
    <span class="explore-search-index" data-explore-search-index aria-hidden="true">Digite para pesquisar em todo o catálogo.</span>
  </section>

  <section class="shell navigation-cards marketplace-navigation explore-hub-navigation" aria-label="Áreas para explorar" data-explore-navigation data-reveal>
    <a class="navigation-card cards-navigation" href={`${base}cartas/`}><div class="navigation-icon" aria-hidden="true"><span>◆</span></div><div><small>Todos os colecionadores</small><h2>Cartas</h2><p>Explore cartas publicadas nas coleções públicas.</p></div><span class="navigation-arrow">↗</span></a>
    <a class="navigation-card boosters-navigation" href={`${base}boosters/`}><div class="navigation-icon" aria-hidden="true"><span>▰</span></div><div><small>Pacotes da comunidade</small><h2>Boosters</h2><p>Veja boosters lacrados publicados pela comunidade.</p></div><span class="navigation-arrow">↗</span></a>
    <a class="navigation-card kits-navigation" href={`${base}kits/`}><div class="navigation-icon" aria-hidden="true"><span>▦</span></div><div><small>Ofertas combinadas</small><h2>Kits</h2><p>Encontre conjuntos personalizados publicados pelos usuários.</p></div><span class="navigation-arrow">↗</span></a>
    <a class="navigation-card products-navigation" href={`${base}produtos/`}><div class="navigation-icon" aria-hidden="true"><span>▣</span></div><div><small>Produtos fechados</small><h2>Produtos</h2><p>Boxes e outros produtos lacrados da comunidade.</p></div><span class="navigation-arrow">↗</span></a>
    <a class="navigation-card albums-navigation" href={`${base}albuns/`}><div class="navigation-icon" aria-hidden="true"><span>▤</span></div><div><small>Organização visual</small><h2>Álbuns</h2><p>Explore álbuns virtuais de coleções públicas.</p></div><span class="navigation-arrow">↗</span></a>
    <a class="navigation-card collections-navigation" href={`${base}colecoes/`}><div class="navigation-icon" aria-hidden="true"><span>◎</span></div><div><small>Perfis de colecionador</small><h2>Coleções</h2><p>Entre no perfil público de cada conta.</p></div><span class="navigation-arrow">↗</span></a>
  </section>

  <script>
  import '../../scripts/pages/explore-page';
</script>
</BaseLayout>
