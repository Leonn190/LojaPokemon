---
import BaseLayout from '../../layouts/BaseLayout.astro';
const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
---
<BaseLayout title="Explorar" description="Explore cartas, boosters, kits, produtos, álbuns e coleções públicas do Vault TCG." active="explore">
  <section class="catalog-hero explore-hub-hero"><div class="shell explore-hub-heading" data-reveal><span class="hero-badge"><i></i> Vault TCG</span><h1>Explorar</h1><p>Escolha uma área da comunidade ou pesquise todo o catálogo em um só lugar.</p></div></section>

  <section class="shell explore-global-search" data-explore-search data-reveal>
    <label class="explore-search-field" for="explore-global-search"><span aria-hidden="true">⌕</span><input id="explore-global-search" type="search" autocomplete="off" placeholder="Buscar cartas, boosters, kits, produtos, álbuns ou coleções..." data-explore-search-input /><kbd>/</kbd></label>
    <div class="explore-search-meta" data-explore-search-meta hidden><strong data-explore-result-count>0</strong><span data-explore-result-label>resultados encontrados</span></div>
    <div class="explore-search-results" data-explore-search-results hidden><div class="explore-search-grid" data-explore-search-grid></div><div class="empty-state explore-search-empty" data-explore-search-empty hidden><span>⌕</span><h2>Nada encontrado</h2><p>Tente outro nome, coleção, número de carta ou colecionador.</p></div></div>
    <span class="explore-search-index" data-explore-search-index aria-hidden="true">Preparando pesquisa…</span>
  </section>

  <section class="shell navigation-cards marketplace-navigation explore-hub-navigation" aria-label="Áreas para explorar" data-explore-navigation data-reveal>
    <a class="navigation-card cards-navigation" href={`${base}cartas/`}><div class="navigation-icon" aria-hidden="true"><span>◆</span></div><div><small>Todos os colecionadores</small><h2>Cartas</h2><p>Explore cartas publicadas nas coleções públicas.</p></div><span class="navigation-arrow">↗</span></a>
    <a class="navigation-card boosters-navigation" href={`${base}boosters/`}><div class="navigation-icon" aria-hidden="true"><span>▰</span></div><div><small>Pacotes da comunidade</small><h2>Boosters</h2><p>Veja boosters lacrados publicados pela comunidade.</p></div><span class="navigation-arrow">↗</span></a>
    <a class="navigation-card kits-navigation" href={`${base}kits/`}><div class="navigation-icon" aria-hidden="true"><span>▦</span></div><div><small>Ofertas combinadas</small><h2>Kits</h2><p>Encontre conjuntos personalizados publicados pelos usuários.</p></div><span class="navigation-arrow">↗</span></a>
    <a class="navigation-card products-navigation" href={`${base}produtos/`}><div class="navigation-icon" aria-hidden="true"><span>▣</span></div><div><small>Produtos fechados</small><h2>Produtos</h2><p>Boxes e outros produtos lacrados da comunidade.</p></div><span class="navigation-arrow">↗</span></a>
    <a class="navigation-card albums-navigation" href={`${base}albuns/`}><div class="navigation-icon" aria-hidden="true"><span>▤</span></div><div><small>Organização visual</small><h2>Álbuns</h2><p>Explore álbuns virtuais de coleções públicas.</p></div><span class="navigation-arrow">↗</span></a>
    <a class="navigation-card collections-navigation" href={`${base}colecoes/`}><div class="navigation-icon" aria-hidden="true"><span>◎</span></div><div><small>Perfis de colecionador</small><h2>Coleções</h2><p>Entre no perfil público de cada conta.</p></div><span class="navigation-arrow">↗</span></a>
  </section>

  <script>
    import { albumMarkup, collectionMarkup, initializeOnlineImages, normalizeText, productMarkup } from '../../scripts/online-markup';
    const root = document.querySelector<HTMLElement>('[data-explore-search]');
    if (root) {
      const input = root.querySelector<HTMLInputElement>('[data-explore-search-input]'); const navigation = document.querySelector<HTMLElement>('[data-explore-navigation]'); const results = root.querySelector<HTMLElement>('[data-explore-search-results]'); const grid = root.querySelector<HTMLElement>('[data-explore-search-grid]'); const count = root.querySelector<HTMLElement>('[data-explore-result-count]'); const label = root.querySelector<HTMLElement>('[data-explore-result-label]'); const meta = root.querySelector<HTMLElement>('[data-explore-search-meta]'); const empty = root.querySelector<HTMLElement>('[data-explore-search-empty]'); const indexLabel = root.querySelector<HTMLElement>('[data-explore-search-index]');
      let records: Array<{ type: string; search: string; html: () => string }> = [];
      const apply = () => { const q = normalizeText(input?.value || ''); const searching = q.length > 0; if (navigation) navigation.hidden = searching; if (results) results.hidden = !searching; if (meta) meta.hidden = !searching; root.classList.toggle('is-searching', searching); const visible = searching ? records.filter((record) => normalizeText(record.search).includes(q)).slice(0, 120) : []; if (grid) { grid.innerHTML = visible.map((record) => `<div class="explore-search-entry"><span class="explore-result-kind">${record.type}</span>${record.html()}</div>`).join(''); initializeOnlineImages(grid); } if (count) count.textContent = String(visible.length); if (label) label.textContent = visible.length === 1 ? 'resultado encontrado' : 'resultados encontrados'; if (empty) empty.hidden = !searching || visible.length !== 0; };
      const load = async () => { try { const cloud = (window as any).VaultCloud; if (!cloud) throw new Error('Catálogo ainda não foi inicializado.'); const [items, albums, collections] = await Promise.all([cloud.listPublicItems(), cloud.listPublicAlbums(), cloud.listPublicCollections()]); records = [
        ...items.map((item: any) => ({ type: item.kind === 'card' ? 'Carta' : item.kind === 'booster' ? 'Booster' : item.kind === 'kit' ? 'Kit' : 'Produto', search: `${item.searchText || ''} ${item.name || ''} ${item.number || ''} ${item.collection || ''} ${item.ownerName || ''}`, html: () => productMarkup(item, { compact: true }) })),
        ...albums.map((album: any) => ({ type: 'Álbum', search: `${album.searchText || ''} ${album.name || ''} ${album.ownerName || ''}`, html: () => albumMarkup(album, true) })),
        ...collections.map((profile: any) => ({ type: 'Coleção', search: `${profile.owner || ''} ${profile.title || ''} ${profile.description || ''}`, html: () => collectionMarkup(profile, true) })),
      ]; if (indexLabel) indexLabel.textContent = `${records.length} registros públicos pesquisáveis`; apply(); } catch (error: any) { if (indexLabel) indexLabel.textContent = error?.message || 'Pesquisa indisponível'; } };
      input?.addEventListener('input', apply); document.addEventListener('keydown', (event) => { if (event.key === '/' && !['INPUT','TEXTAREA','SELECT'].includes((document.activeElement as HTMLElement | null)?.tagName || '')) { event.preventDefault(); input?.focus(); } }); if ((window as any).VaultCloud) load(); else window.addEventListener('vault:cloud-ready', load, { once: true });
    }
  </script>
</BaseLayout>
