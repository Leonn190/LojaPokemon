rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, create, update, delete: if isOwner(uid);
    }

    match /slugs/{slug} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.collectionUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.collectionUid == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /collections/{uid} {
      allow read: if resource.data.public == true || isOwner(uid);
      allow create: if isOwner(uid) && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isOwner(uid)
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if isOwner(uid);

      match /{subcollection}/{documentId} {
        allow read, write: if isOwner(uid);
      }
    }

    match /publicItems/{itemId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.collectionUid == request.auth.uid
        && request.resource.data.public == true;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.collectionUid == request.auth.uid
        && request.resource.data.public == true;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /publicAlbums/{albumId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.collectionUid == request.auth.uid
        && request.resource.data.public == true;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.collectionUid == request.auth.uid
        && request.resource.data.public == true;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /proposals/{proposalId} {
      allow create: if signedIn()
        && request.resource.data.buyerUid == request.auth.uid
        && request.resource.data.sellerUid is string
        && request.resource.data.sellerUid != request.auth.uid;
      allow read: if signedIn()
        && (resource.data.buyerUid == request.auth.uid || resource.data.sellerUid == request.auth.uid);
      allow update: if signedIn()
        && (resource.data.buyerUid == request.auth.uid || resource.data.sellerUid == request.auth.uid)
        && request.resource.data.buyerUid == resource.data.buyerUid
        && request.resource.data.sellerUid == resource.data.sellerUid;
      allow delete: if signedIn() && resource.data.buyerUid == request.auth.uid;
    }
  }
}
